@media (prefers-reduced-motion: reduce) { .ex-shelf, .ex-box { animation: none; } }

  /* ---------- Entrance states ---------- */
  .home.js .stat, .home.js .type-card { opacity: 0; transform: translateY(14px); }
  .home.js.in .stat, .home.js.in .type-card {
    opacity: 1; transform: none;
    transition: opacity .6s ease calc(var(--i) * 90ms), transform .6s cubic-bezier(.2,.8,.2,1) calc(var(--i) * 90ms), border-color .25s;
  }
