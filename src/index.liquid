  .home.js .type-bar i { transform: scaleX(0); }
  .home.js.in .type-bar i { transform: scaleX(var(--s)); transition: transform 1.2s cubic-bezier(.2,.8,.2,1) calc(.5s + var(--i) * 120ms); }

