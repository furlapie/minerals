---
layout: layouts/base.liquid
title: Home
---

{% assign palette_hexes = "#F5F0E6|#8A8A8A|#525252|#1A1A1A|#D9C7A3|#7B5233|#4A3728|#531A13|#C0392B|#E08B2F|#C9A227|#E8C547|#4C9A5B|#1F5C33|#2FA8A0|#3468C0|#1B3A8C|#402B52|#7B4FA0|#E8A0BF" | split: "|" %}
{% assign tier_colors = "#ff7c80|#df8898|#be95b1|#9da2ca|#7cafe3" | split: "|" %}

{% assign total_pieces = specimens | sum: "quantity" %}
{% assign total_g = specimens | sum: "weight_g" %}
{% assign total_kg = total_g | divided_by: 1000.0 | round: 2 %}
{% assign total_spent = specimens | sum: "price" %}
{% assign shiny_count = specimens | where: "shiny", true | size %}
{% assign wip_count = specimens | where: "wip", true | size %}
{% assign model_count = 0 %}
{% if modelgallery %}{% assign model_count = modelgallery.size %}{% endif %}

{% comment %} --- Unique specimens --- {% endcomment %}
{%- assign names_blob = "" -%}
{%- for s in specimens -%}
  {%- assign s_main = s.main | strip -%}
  {%- if s_main != "" -%}
    {%- if names_blob == "" -%}
      {%- assign names_blob = s_main -%}
    {%- else -%}
      {%- assign names_blob = names_blob | append: "," | append: s_main -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign unique_specimens = 0 -%}
{%- if names_blob != "" -%}
  {%- assign unique_specimens = names_blob | downcase | replace: ", ", "," | replace: " ,", "," | split: "," | uniq | size -%}
{%- endif -%}

{% comment %} --- Acquisitions per year --- {% endcomment %}
{%- assign dated = specimens | where_exp: "s", "s.date_acquired > 0" | sort: "date_acquired" -%}
{%- assign has_dates = false -%}
{%- if dated.size > 0 -%}
  {%- assign has_dates = true -%}
  {%- assign first_year = dated.first.date_acquired | plus: 0 -%}
  {%- assign this_year  = "now" | date: "%Y" | plus: 0 -%}
{%- endif -%}

{% comment %} --- Spectrum total (for correct wave timing) --- {% endcomment %}
{% assign spectrum_total = 0 %}
{% for hex in palette_hexes %}
  {% for s in specimens %}
    {% if s.colors[0] == hex %}{% assign spectrum_total = spectrum_total | plus: 1 %}{% endif %}
  {% endfor %}
{% endfor %}

{% comment %} --- Tier / type helpers --- {% endcomment %}
{% assign tier_max = 1 %}
{% for t in (1..5) %}{% assign n = specimens | where: "tier", t | size %}{% if n > tier_max %}{% assign tier_max = n %}{% endif %}{% endfor %}
{% assign tier_durs = "1600|1100|2000|1300|1800" | split: "|" %}
{% assign type_colors = "#7cafe3|#ff7c80|#9da2ca|#E8C547|#2FA8A0|#E08B2F" | split: "|" %}

{% comment %} ══════════════════════════════════════════════════════════════
   WORLD MAP — region keyword table.
   Add/remove keywords per region (case-insensitive substring match
   against specimen.from_where). Format: REGION_ID:kw1,kw2,kw3|...
   The REGION_ID must match the id="" of the matching <path> in the SVG.
   ══════════════════════════════════════════════════════════════ {% endcomment %}
{%- assign wm_regions = "IT:Italy,Italia|SOUTH_AMERICA:Brazil,Brasile,Argentina,Chile,Cile,Peru,Perù,Perú,Colombia,Venezuela,Ecuador,Bolivia,Uruguay,Paraguay,Guyana,Suriname|NORTH_AMERICA:United States,USA,U.S.,Stati Uniti,Canada,Mexico,Messico,Guatemala,Cuba,Jamaica,Giamaica,Dominican Republic,Repubblica Domenicana,Haiti,Honduras,Panama,Costa Rica,Nicaragua,El Salvador,Belize|EUROPE:France,Francia,Germany,Germania,Spain,Spagna,Portugal,Portogallo,United Kingdom,Regno Unito,England,Inghilterra,Scotland,Scozia,Wales,Galles,Ireland,Irlanda,Netherlands,Paesi Bassi,Olanda,Belgium,Belgio,Switzerland,Svizzera,Austria,Poland,Polonia,Czech,Ceca,Slovakia,Slovacchia,Slovenia,Croatia,Croazia,Serbia,Albania,Hungary,Ungheria,Romania,Bulgaria,Greece,Grecia,Norway,Norvegia,Sweden,Svezia,Finland,Finlandia,Denmark,Danimarca,Iceland,Islanda,Russia,Ukraine,Ucraina|AFRICA:Africa,Morocco,Marocco,Algeria,Tunisia,Libya,Libia,Egypt,Egitto,Sudan,Ethiopia,Etiopia,Kenya,Tanzania,South Africa,Sudafrica,Namibia,Botswana,Zimbabwe,Zambia,Mozambique,Mozambico,Madagascar,Nigeria,Ghana,Senegal,Mali,Niger,Chad,Ciad,Cameroon,Camerun,Congo,Angola,Malawi,Uganda,Rwanda,Burundi|ASIA:China,Cina,Japan,Giappone,Korea,Corea,India,Pakistan,Afghanistan,Iran,Iraq,Turkey,Turchia,Mongolia,Thailand,Tailandia,Vietnam,Laos,Cambodia,Myanmar,Birmania,Malaysia,Malesia,Indonesia,Philippines,Filippine,Saudi Arabia,Arabia Saudita,UAE,Emirati,Qatar,Kuwait,Israel,Israele,Jordan,Giordania,Lebanon,Libano,Syria,Siria,Kazakhstan,Kazakistan,Uzbekistan,Nepal,Bhutan,Bangladesh,Sri Lanka|OCEANIA:Australia,New Zealand,Nuova Zelanda,Papua New Guinea,Papua Nuova Guinea,Fiji,Samoa,Tonga,Vanuatu,Solomon|ANTARTICA:Antarctica,Antartica,Antarctic,Antartide" | split: "|" -%}

{%- assign wm_counts = "" -%}
{%- for entry in wm_regions -%}
  {%- assign parts = entry | split: ":" -%}
  {%- assign rid = parts[0] -%}
  {%- assign keywords = parts[1] | split: "," -%}
  {%- assign cnt = 0 -%}
  {%- for s in specimens -%}
    {%- assign fw = s.from_where | default: "" | downcase -%}
    {%- for kw in keywords -%}
      {%- assign kwl = kw | downcase | strip -%}
      {%- if kwl != "" and fw contains kwl -%}
        {%- assign cnt = cnt | plus: 1 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if forloop.first -%}
    {%- assign wm_counts = wm_counts | append: '"' | append: rid | append: '":' | append: cnt -%}
  {%- else -%}
    {%- assign wm_counts = wm_counts | append: ',"' | append: rid | append: '":' | append: cnt -%}
  {%- endif -%}
{%- endfor -%}
{%- assign wm_json = "{" | append: wm_counts | append: "}" -%}

{%- comment -%} ── EXPLORE data: shelves → boxes ── {%- endcomment -%}
{%- assign EX_MAX_BOX = 30 -%}
{%- assign ex_parts = "" -%}
{%- for sh in (1..4) -%}
  {%- assign sh_specs = specimens | where: "shelf", sh -%}
  {%- assign sh_names = "" -%}
  {%- for s in sh_specs -%}
    {%- assign s_m = s.main | strip -%}
    {%- if s_m != "" -%}
      {%- if sh_names == "" -%}{%- assign sh_names = s_m -%}{%- else -%}{%- assign sh_names = sh_names | append: "," | append: s_m -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign sh_unique = 0 -%}
  {%- if sh_names != "" -%}{%- assign sh_unique = sh_names | downcase | split: "," | uniq | size -%}{%- endif -%}

  {%- assign bx_parts = "" -%}
  {%- for b in (0..EX_MAX_BOX) -%}
    {%- assign b_specs = sh_specs | where: "box", b -%}
    {%- if b_specs.size > 0 -%}
      {%- assign b_names = "" -%}
      {%- for s in b_specs -%}
        {%- assign s_m = s.main | strip -%}
        {%- if s_m != "" -%}
          {%- if b_names == "" -%}{%- assign b_names = s_m -%}{%- else -%}{%- assign b_names = b_names | append: "," | append: s_m -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign b_unique = 0 -%}
      {%- if b_names != "" -%}{%- assign b_unique = b_names | downcase | split: "," | uniq | size -%}{%- endif -%}
      {%- capture b_entry -%}{"box":{{ b }},"count":{{ b_specs.size }},"unique":{{ b_unique }},"pieces":{{ b_specs | sum: "quantity" }},"weight_g":{{ b_specs | sum: "weight_g" }},"price":{{ b_specs | sum: "price" }}}{%- endcapture -%}
      {%- if bx_parts == "" -%}{%- assign bx_parts = b_entry -%}{%- else -%}{%- assign bx_parts = bx_parts | append: "," | append: b_entry -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- capture sh_entry -%}{"shelf":{{ sh }},"count":{{ sh_specs.size }},"unique":{{ sh_unique }},"pieces":{{ sh_specs | sum: "quantity" }},"weight_g":{{ sh_specs | sum: "weight_g" }},"price":{{ sh_specs | sum: "price" }},"boxes":[{{ bx_parts }}]}{%- endcapture -%}
  {%- if ex_parts == "" -%}{%- assign ex_parts = sh_entry -%}{%- else -%}{%- assign ex_parts = ex_parts | append: "," | append: sh_entry -%}{%- endif -%}
{%- endfor -%}
{%- assign explore_json = "[" | append: ex_parts | append: "]" -%}

<div class="home" id="home">

  <header class="collection-head">
    <button class="coll-arrow" type="button" aria-label="Previous collection" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <h1 class="collection-title">The Collection</h1>
    <button class="coll-arrow" type="button" aria-label="Next collection" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
    <div class="sys-container">
      <span class="sys-status"><i></i>SYSTEM ONLINE</span>
      <a href="/admin/" class="sys-admin-link" aria-hidden="true" tabindex="-1">ADMIN</a>
    </div>
  </header>

  <!-- ============================ LEFT COLUMN ============================ -->
  <section class="home-left">

    <div class="stat-grid">
      <button class="stat explore-stat" id="exploreBtn" type="button" style="--i:0; --c:var(--gold)">
        <span class="stat-num">Shelves &amp; boxes</span>
        <span class="stat-label">Explore</span>
        <svg class="explore-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>

      <a class="stat" style="--i:0; --c:#7cafe3" href="/collection/">
        <span class="stat-num"><span data-count="{{ specimens.size }}">{{ specimens.size }}</span></span>
        <span class="stat-label">Specimens</span>
      </a>
      <a class="stat" style="--i:1; --c:#2FA8A0" href="/collection/">
        <span class="stat-num"><span data-count="{{ unique_specimens }}">{{ unique_specimens }}</span></span>
        <span class="stat-label">Species</span>
      </a>
      <a class="stat" style="--i:2; --c:#9da2ca" href="/collection/?sort=9:desc">
        <span class="stat-num"><span data-count="{{ total_pieces }}">{{ total_pieces }}</span></span>
        <span class="stat-label">Pieces</span>
      </a>
      <a class="stat" style="--i:3; --c:#E8C547" href="/collection/?sort=8:desc">
        <span class="stat-num"><span data-count="{{ total_kg }}">{{ total_kg }}</span><small>kg</small></span>
        <span class="stat-label">Weight</span>
      </a>
      <a class="stat" style="--i:4; --c:#C9A227" href="/collection/?sort=10:desc">
        <span class="stat-num">€<span data-count="{{ total_spent }}">{{ total_spent }}</span></span>
        <span class="stat-label">Invested</span>
      </a>
      <a class="stat" style="--i:5; --c:#E8A0BF" href="/collection/?shiny=1">
        <span class="stat-num"><span data-count="{{ shiny_count }}">{{ shiny_count }}</span></span>
        <span class="stat-label">Shiny</span>
      </a>
      <a class="stat" style="--i:6; --c:#ff9500" href="/collection/?wip=1">
        <span class="stat-num"><span data-count="{{ wip_count }}">{{ wip_count }}</span></span>
        <span class="stat-label">In progress</span>
      </a>
      <a class="stat" style="--i:7; --c:#7B4FA0" href="/collection/?view=models">
        <span class="stat-num"><span data-count="{{ model_count }}">{{ model_count }}</span></span>
        <span class="stat-label">3D models</span>
      </a>
    </div>

    <h2 class="home-h">By tier</h2>
    <div class="tier-cols">
      {% for t in (1..5) %}
        {% assign n = specimens | where: "tier", t | size %}
        {% assign idx = t | minus: 1 %}
        {% assign h = n | times: 100.0 | divided_by: tier_max | round: 1 %}
        {% assign pct = n | times: 100.0 | divided_by: specimens.size | round %}
        {% assign dl = idx | times: 120 | plus: 350 %}
        <a class="tier-col" href="/collection/?tier={{ t }}" style="--c: {{ tier_colors[idx] }};" title="Tier {{ t }}: {{ n }} specimens">
          <span class="tier-n"><b data-count="{{ n }}" data-dur="{{ tier_durs[idx] }}" data-delay="{{ dl }}">{{ n }}</b></span>
          <span class="tier-track"><span class="tier-fill" style="--h: {{ h }}%; --d: {{ tier_durs[idx] }}ms; --dl: {{ dl }}ms;"></span></span>
          <span class="tier-tag">
            <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M49.9981 0H50C69 0 100 0.00416183 100 50.0002C100 99.9963 69 100.002 50 100.002C31 100.002 0 100.002 0 50.0002C0 0 30.9979 0 49.9981 0Z"/></svg>
            <em>{{ t }}</em>
          </span>
          <span class="tier-pct">{{ pct }}%</span>
        </a>
      {% endfor %}
    </div>

    <h2 class="home-h">By type</h2>
    <div class="type-cards">
      {% assign types = "Crystal|Gem|Rock|Mineral|Geode|Fossil" | split: "|" %}
      {% for ty in types %}
        {% assign n = specimens | where: "type", ty | size %}
        {% assign tw = specimens | where: "type", ty | sum: "weight_g" %}
        {% assign tkg = tw | divided_by: 1000.0 | round: 2 %}
        {% assign s = n | times: 1.0 | divided_by: specimens.size | round: 3 %}
        {% assign pct = n | times: 100.0 | divided_by: specimens.size | round %}
        <a class="type-card" href="/collection/?type={{ ty }}" style="--i:{{ forloop.index0 }}; --s:{{ s }}; --p:{{ pct }}; --c:{{ type_colors[forloop.index0] }};">
          <span class="type-head">
            <span class="type-ico">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {% case ty %}
                  {% when "Crystal" %}
                    <path class="ico-shape" d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/>
                    <path class="ico-detail" d="M5 7 L12 11 L19 7 M12 11 V22"/>
                  {% when "Gem" %}
                    <path class="ico-shape" d="M7 4 L17 4 L21 10 L12 22 L3 10 Z"/>
                    <path class="ico-detail" d="M3 10 H21 M7 4 L10 10 L12 22 M17 4 L14 10 L12 22"/>
                  {% when "Rock" %}
                    <path class="ico-shape" d="M3 16 L4 8 L10 4 L17 5 L21 11 L19 18 L11 20 Z"/>
                    <path class="ico-detail" d="M4 8 L11 12 L21 11 M11 12 V20 M11 12 L17 5"/>
                  {% when "Mineral" %}
                    <path class="ico-shape" d="M6 4 L12 8 V21 L3 17 V7 Z"/>
                    <path class="ico-shape" style="opacity:.5" d="M13 6 L20 9 L21 18 L14 20 Z"/>
                    <path class="ico-detail" d="M6 4 L12 8 M3 17 L12 21 M13 6 L20 9 M14 20 L21 18"/>
                  {% when "Geode" %}
                    <circle class="ico-shape" cx="12" cy="12" r="10"/>
                    <path class="ico-detail" d="M6 12 L8 10 L9.5 12 L11 9.5 L12.5 11.5 L14 9 L15.5 11 L17 10 L18 12 L17 14 L15 13.5 L14 16 L12.5 14 L11 16 L9.5 14 L8 15 L6.5 13.5 Z"/>
                  {% when "Fossil" %}
                    <path class="ico-spiral" d="M12 12 C12 10 13.5 9 15 9 C17.5 9 19 11 19 13 C19 16 16 19 13 19 C9 19 5 16 5 12 C5 6 11 4 17 6"/>
                {% endcase %}
              </svg>
            </span>
            <em class="type-count" data-count="{{ n }}">{{ n }}</em>
          </span>
          <span class="type-name">{{ ty }}</span>
          <span class="type-bar"><i></i></span>
          <span class="type-meta">{{ pct }}% · {{ tkg }} kg</span>
        </a>
      {% endfor %}
    </div>

    <a class="home-cta" href="/collection/">
      <span class="cta-text">
        <small>Open the catalog</small>
        <strong>Browse all {{ specimens.size }} specimens</strong>
      </span>
      <span class="cta-strip" aria-hidden="true">
        {% for hex in palette_hexes %}<i style="background: {{ hex }}; --k: {{ forloop.index0 }};"></i>{% endfor %}
      </span>
      <span class="cta-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
  </section>

  <!-- ============================ RIGHT COLUMN ============================ -->
  <section class="home-right">

    <h2 class="home-h">Color spectrum</h2>
    <div class="spectrum">
      {% if spectrum_total > 0 %}
        {% assign si = 0 %}
        {% for hex in palette_hexes %}
          {% for m in specimens %}
            {% if m.colors[0] == hex %}
              {% assign bar_delay = si | times: 1400 | divided_by: spectrum_total %}
              <a href="/collection/{{ m.slug }}/" title="{{ m.name }}" style="background: {{ hex }}; --dl:{{ bar_delay }}ms;"></a>
              {% assign si = si | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>
    <p class="home-note" id="spectrumNote" data-default="Every bar is one specimen, ordered by its main color.">Every bar is one specimen, ordered by its main color.</p>

    {% if has_dates %}
      <div class="yr-wrap">
        <h2 class="home-h">By year</h2>
        <div class="yr-chart" id="yrChart"
             data-tiers='{ {%- for y in (first_year..this_year) -%}"{{ y }}":"{%- for m in dated -%}{%- assign my = m.date_acquired | plus: 0 -%}{%- if my == y -%}{{ m.tier }}{%- endif -%}{%- endfor -%}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }'>
          <div class="yr-head-row"><span class="yr-readout"></span></div>
          <div class="yr-plot"></div>
        </div>
      </div>
    {% endif %}

    <!-- ══════════════════════ WORLD MAP ══════════════════════ -->
    <h2 class="home-h">By origin</h2>
    <div class="worldmap" id="worldmap" data-region-counts='{{ wm_json }}'>
      <div class="wm-stage" id="wmStage" role="button" tabindex="0" aria-label="Expand world map" aria-expanded="false">
        {% include "worldmap.svg" %}

        <span class="wm-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="wm-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          Explore map
        </span>
      </div>

      <div class="wm-tip" hidden aria-hidden="true">
        <span class="wm-tip-name">—</span>
        <span class="wm-tip-count"><b>0</b></span>
      </div>

      <div class="wm-hud"></div>

      <button class="wm-close" type="button" aria-label="Close expanded map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

  </section>
  <div class="ex-panel" id="exPanel" hidden aria-hidden="true" data-explore='{{ explore_json | escape }}'>
    <div class="ex-inner">
      <header class="ex-head">
        <div class="ex-head-text">
          <h2 class="ex-title">Explore</h2>
          <span class="ex-sub"></span>
        </div>
        <button class="ex-close" type="button" aria-label="Close explorer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="ex-body">
        <div class="ex-level ex-shelves" data-level="shelves"></div>
        <div class="ex-level ex-boxes" data-level="boxes" hidden></div>
      </div>
    </div>
  </div>
</div>

<style>
  main { max-width: 1400px; }
  html { scrollbar-width: none; }
  html::-webkit-scrollbar { display: none; }
  .home { position: relative; isolation: isolate; display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; padding: 1.2rem 2rem 3rem; }
  @media (max-width: 800px) { .home { grid-template-columns: 1fr; } }

  /* ---------- HUD background grid ---------- */
  .home::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .35;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 25% 15%, #000 0%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 60% at 25% 15%, #000 0%, transparent 100%);
  }

  .home-h { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 2rem 0 .75rem; display: flex; align-items: center; gap: 12px; }
  .home-h::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), transparent); }
  .home-note { color: var(--muted); font-size: 13px; min-height: 1.4em; transition: color .2s; }

  /* ---------- Right column ---------- */
  .home-right { display: flex; flex-direction: column; min-width: 0; }

  /* ---------- Header ---------- */
  .collection-head { grid-column: 1 / -1; display: flex; align-items: center; gap: 1rem; }
  .collection-title { margin: 0; font-size: 40px; font-weight: bold; font-variant-numeric: tabular-nums; }
  .coll-arrow { background: none; border: none; cursor: pointer; color: var(--ink); width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center; transition: opacity .15s; }
  .coll-arrow:hover { opacity: .5; }
  .coll-arrow svg { width: 28px; height: 28px; }
  .coll-arrow[hidden] { display: none; }

  .sys-container { 
    margin-left: auto; 
    display: flex; 
    flex-direction: column; 
    align-items: flex-end; 
    gap: 4px; 
  }
  .sys-status { 
    display: inline-flex; 
    align-items: center; 
    gap: 8px; 
    font-size: 11px; 
    letter-spacing: .14em; 
    color: var(--muted); 
  }
  .sys-status i { 
    width: 7px; 
    height: 7px; 
    border-radius: 50%; 
    background: #4C9A5B; 
    box-shadow: 0 0 8px #4C9A5B; 
    animation: blink 1.6s ease-in-out infinite; 
  }
  
  /* The stealth admin link */
  .sys-admin-link {
    font-family: Consolas, monospace;
    font-size: 9px;
    letter-spacing: .22em;
    color: color-mix(in srgb, var(--muted) 30%, transparent);
    text-decoration: none;
    pointer-events: all;
    user-select: none;
    transition: color .2s ease;
  }

  /* Hide the whole block on mobile */
  @media (max-width: 800px) { .sys-container { display: none; } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

  /* ---------- Stat cards ---------- */
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: .5rem; }
  @media (max-width: 560px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
    
  .stat {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; gap: 8px;
    padding: 12px 14px 13px;
    background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .stat:hover {
    transform: translateY(-3px);
    border-color: var(--c);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--c) 60%, transparent);
  }
  .stat-label {
    order: -1; position: relative; z-index: 1;
    display: flex; align-items: center; gap: 7px;
    font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--muted); white-space: nowrap;
  }
  .stat-label::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
    background: var(--c);
    box-shadow: 0 0 8px color-mix(in srgb, var(--c) 70%, transparent);
  }
  .stat-num {
    position: relative; z-index: 1;
    font-size: 26px; font-weight: 700; color: var(--ink); line-height: 1.05;
    font-variant-numeric: tabular-nums; letter-spacing: -.02em;
  }
  .stat-num small { font-size: 12px; margin-left: 3px; color: var(--muted); }
    
  .stat.done .stat-num { animation: land .9s ease-out; }
  @keyframes land { 0% { text-shadow: 0 0 22px color-mix(in srgb, var(--c) 70%, transparent); } 100% { text-shadow: 0 0 0 transparent; } }

  /* Explore = stat block + raised gold edge */
  .stat-grid .explore-stat {
    grid-column: 1 / -1; width: 100%;
    margin-bottom: 4px;                       /* compensates the 4px edge, keeps the gap at 10px */
    text-align: left; font-family: inherit; color: inherit; cursor: pointer;
    box-shadow: 0 4px 0 var(--border);
  }
  .stat-grid .explore-stat .stat-num { font-size: 20px; letter-spacing: -.01em; }
  .explore-arrow {
    position: absolute; right: 18px; top: 50%; width: 20px; height: 20px;
    transform: translateY(-50%); color: var(--gold); z-index: 1;
    transition: transform .3s ease;
  }
  .home.js.in .stat.explore-stat:hover,
  .stat.explore-stat:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
    box-shadow: 0 6px 0 var(--gold);
  }
  .stat.explore-stat:hover .explore-arrow { transform: translate(4px, -50%); }
  .stat.explore-stat:active { transform: translateY(4px); box-shadow: 0 0 0 var(--gold); }

  /* ---------- Shared: links + cursor spotlight ---------- */
  .stat, .type-card, .tier-col, .home-cta { text-decoration: none; color: inherit; }
  .stat, .type-card, .home-cta { position: relative; overflow: hidden; }
  .stat::before, .type-card::before, .home-cta::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .25s;
    background: radial-gradient(160px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.09), transparent 65%);
  }
  .stat:hover::before, .type-card:hover::before, .home-cta:hover::before { opacity: 1; }

  /* ---------- Tier columns ---------- */
  .tier-cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .tier-col { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .tier-n { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
  .tier-track { width: 100%; height: 130px; display: flex; align-items: flex-end; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; transition: border-color .25s ease; }
  .tier-fill { width: 100%; height: var(--h); transform-origin: bottom; border-radius: 6px 6px 0 0; background: linear-gradient(to top, var(--c), color-mix(in srgb, var(--c) 65%, #fff)); box-shadow: inset 0 2px 0 rgba(255,255,255,.35); transition: filter .2s ease; }
  .tier-col:hover .tier-track { border-color: var(--c); }
  .tier-col:hover .tier-fill { filter: brightness(1.12); }
  .tier-tag { position: relative; width: 34px; height: 34px; display: grid; place-items: center; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .tier-tag svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--c); }
  .tier-tag em { position: relative; font-style: normal; font-weight: 700; font-size: 13px; color: #fff; }
  .tier-col:hover .tier-tag { transform: translateY(-3px) scale(1.08); }
  .tier-pct { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ---------- Type cards ---------- */
  .type-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .type-card {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; gap: 8px;
    padding: 14px 14px 13px;
    background:
      radial-gradient(140% 120% at 0% 0%, color-mix(in srgb, var(--c) 5%, transparent) 0%, transparent 55%),
      var(--surface);
    border: 1px solid var(--border); border-radius: 10px;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .type-card:hover {
    transform: translateY(-3px);
    border-color: var(--c);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--c) 70%, transparent);
  }

  .type-head { display: flex; align-items: center; justify-content: space-between; }

  .type-ico {
    position: relative; z-index: 0;
    width: 42px; height: 42px;
    display: grid; place-items: center;
    border-radius: 12px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, var(--surface-2));
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--border));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--c) 25%, transparent);
    transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .type-ico svg {
    width: 22px; height: 22px; overflow: visible; transform-origin: center;
    transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .4s ease;
  }
  .type-ico svg .ico-shape { fill: var(--c); fill-opacity: .22; stroke: var(--c); stroke-width: 1.4; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .type-ico svg .ico-detail { fill: none; stroke: var(--c); stroke-width: 1; stroke-linejoin: round; stroke-linecap: round; opacity: .6; vector-effect: non-scaling-stroke; }
  .type-ico svg .ico-spiral { fill: none; stroke: var(--c); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }

  /* hover: the square disappears, the icon blows up and gets clipped by the card */
  .type-card:hover .type-ico { background: transparent; border-color: transparent; box-shadow: none; }
  .type-card:hover .type-ico svg { transform: scale(9); opacity: .28; }

  /* plain count — no ring, no hover flair */
  .type-count {
    position: relative; z-index: 1;
    font-style: normal; font-size: 22px; font-weight: 700; line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    letter-spacing: -.01em;
  }

  .type-name {
    font-size: 12px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink);
  }
  .type-bar { height: 3px; border-radius: 2px; background: var(--border); overflow: hidden; }
  .type-bar i {
    display: block; height: 100%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 55%, transparent), var(--c));
    transform-origin: left; transform: scaleX(var(--s));
  }
  .type-meta {
    font-size: 10px; color: var(--muted);
    letter-spacing: .08em;
    font-variant-numeric: tabular-nums;
  }

  /* keep the text above the giant icon */
  .type-count, .type-name, .type-bar, .type-meta { position: relative; z-index: 1; }

  /* ---------- CTA ---------- */
  .home-cta { display: flex; align-items: center; gap: 20px; margin-top: 2.5rem; padding: 18px 22px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 4px 0 var(--border); transition: transform .15s ease, box-shadow .15s ease, border-color .25s ease; }
  .home-cta:hover { transform: translateY(-2px); border-color: var(--gold); box-shadow: 0 6px 0 var(--gold); }
  .home-cta:active { transform: translateY(4px); box-shadow: 0 0 0 var(--gold); }
  .cta-text { position: relative; flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .cta-text small { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .cta-text strong { font-size: 18px; }
  .cta-strip { position: relative; display: flex; align-items: flex-end; gap: 3px; height: 30px; }
  .cta-strip i { width: 5px; height: 100%; border-radius: 2px; transform-origin: bottom; transform: scaleY(.35); transition: transform .45s cubic-bezier(.2,.8,.2,1) calc(var(--k) * 22ms); }
  .home-cta:hover .cta-strip i { transform: scaleY(1); }
  .cta-go { position: relative; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: #111; transition: transform .3s ease; }
  .cta-go svg { width: 18px; height: 18px; }
  .home-cta:hover .cta-go { transform: translateX(4px); }
  @media (max-width: 560px) { .cta-strip { display: none; } }

  /* ---------- Spectrum ---------- */
  .spectrum { position: relative; display: flex; align-items: flex-end; height: 260px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
  .spectrum a { flex: 1; min-width: 2px; transition: flex .2s ease; }
  .spectrum:hover a:not(:hover) { opacity: .7; }
  .spectrum::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; will-change: transform;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent 0%, transparent 44%, rgba(255,255,255,.3) 50%, transparent 56%, transparent 100%);
    animation: scan 16s cubic-bezier(.45, 0, .55, 1) 2.5s infinite;
  }
  @keyframes scan {
    0%      { transform: translateX(-100%); }
    11.25%  { transform: translateX(100%); }
    17.5%   { transform: translateX(100%); }
    37.5%   { transform: translateX(-100%); }
    43.75%  { transform: translateX(-100%); }
    58.75%  { transform: translateX(100%); }
    65%     { transform: translateX(100%); }
    93.75%  { transform: translateX(-100%); }
    100%    { transform: translateX(-100%); }
  }

  /* ---------- Column heights: left CTA pinned to the bottom, year chart absorbs the slack ---------- */
  .home-left { display: flex; flex-direction: column; }
  .type-cards { margin-bottom: 2.5rem; }
  .home-cta { margin-top: auto; }

  /* ---------- By year: premium columns ---------- */
  .yr-wrap { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 200px; }
.yr-chart {
  flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 6px; padding: 12px 14px 10px;
  background:
    radial-gradient(90% 120% at 15% 0%, color-mix(in srgb, var(--chart-line) 8%, transparent), transparent 60%),
    var(--surface);
  border: 1px solid var(--border); border-radius: 8px;
}
  .yr-head-row { min-height: 16px; font-size: 11px; color: var(--muted); letter-spacing: .06em; }
  .yr-readout { display: block; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .yr-readout b { color: var(--ink); }
.yr-readout em { font-style: normal; color: var(--chart-line); }

  .yr-plot { position: relative; flex: 1; min-height: 0; }
  .yr-area { position: absolute; left: 26px; right: 0; top: 14px; bottom: 20px; }

  .yr-line { position: absolute; left: 0; right: 0; height: 0; border-top: 1px dashed color-mix(in srgb, var(--border) 90%, transparent); }
  .yr-line:last-of-type { border-top-style: solid; }
  .yr-line span { position: absolute; left: -26px; top: 0; transform: translateY(-50%); width: 20px; text-align: right; font-size: 10px; line-height: 1; color: var(--muted); font-variant-numeric: tabular-nums; }
.yr-line.avg { border-top: 1px dashed color-mix(in srgb, var(--chart-line) 60%, transparent); z-index: 1; pointer-events: none; }
.yr-line.avg span { left: auto; right: 0; top: -9px; transform: none; width: auto; color: var(--chart-line); letter-spacing: .08em; text-transform: uppercase; font-size: 9px; }

  .yr-cols { position: absolute; inset: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; }
  .yr-col { position: relative; min-width: 0; cursor: pointer; transition: opacity .25s ease; text-decoration: none; color: inherit; }
  .yr-chart.hov .yr-col:not(.on) { opacity: .35; }

.yr-bar {
  position: absolute; left: 16%; right: 16%; bottom: 0; height: calc(var(--r) * 100%); min-height: 3px;
  border-radius: 5px 5px 2px 2px;
  background: linear-gradient(to top, color-mix(in srgb, var(--chart-line) 22%, transparent) 0%, var(--chart-line) 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 0 16px var(--chart-glow);
  transition: filter .25s ease, box-shadow .25s ease;
}
  .yr-bar::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 28%; border-radius: inherit; background: linear-gradient(90deg, rgba(255,255,255,.28), transparent); }
.yr-col.peak .yr-bar {
  background: linear-gradient(to top, color-mix(in srgb, var(--chart-line) 35%, transparent) 0%, color-mix(in srgb, var(--chart-line) 60%, #fff) 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 0 26px var(--chart-glow);
}
.yr-col.on .yr-bar { filter: brightness(1.18); box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 0 30px var(--chart-glow); }
  .yr-val { position: absolute; left: 0; right: 0; bottom: calc(var(--r) * 100% + 5px); text-align: center; font-size: 10px; font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; opacity: 0; transition: opacity .25s ease; }
  .yr-col.peak .yr-val, .yr-col.on .yr-val { opacity: 1; color: var(--chart-line); }
  .yr-chart.wide .yr-val { opacity: 1; }
  .yr-col.zero::after { content: ""; position: absolute; bottom: -2px; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--border); }

  .yr-labels { position: absolute; left: 26px; right: 0; bottom: 0; height: 16px; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; }
  .yr-labels span { text-align: center; font-size: 10px; color: var(--muted); font-variant-numeric: tabular-nums; transition: color .2s; }
  .yr-labels span.on { color: var(--ink); }

  /* entrance */
  .home.js .yr-bar { transform: scaleY(0); transform-origin: bottom; }
  .home.js .yr-val { opacity: 0 !important; }
  .home.js.in .yr-bar { transform: none; transition: transform .9s cubic-bezier(.2,.8,.2,1) calc(.5s + var(--i) * 55ms), filter .25s ease, box-shadow .25s ease; }
  .home.js.in .yr-col.peak .yr-val, .home.js.in .yr-chart.wide .yr-val { opacity: 1 !important; transition: opacity .5s ease calc(1.2s + var(--i) * 55ms); }
  .home.js.in .yr-col.on .yr-val { opacity: 1 !important; transition: opacity .2s ease; }

/* ══════════════════════ WORLD MAP ══════════════════════ */
.worldmap { position: relative; margin-top: 4px; }

.wm-stage {
  --land: color-mix(in srgb, var(--surface-3) 80%, #000);
  position: relative;
  aspect-ratio: 66989 / 31063;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  cursor: zoom-in;
  background:
    radial-gradient(rgba(255,255,255,.07) 1px, transparent 1.4px) 0 0 / 16px 16px,
    radial-gradient(120% 100% at 50% 35%, color-mix(in srgb, #2FA8A0 7%, var(--surface)) 0%, color-mix(in srgb, var(--surface) 90%, #000) 100%);
  transition: border-color .25s ease, box-shadow .6s ease;
}
.wm-stage:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.wm-stage::after {
  content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
  background:
    radial-gradient(90% 70% at 20% 0%, rgba(255,255,255,.08), transparent 60%),
    radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(0,0,0,.45) 100%);
}

.wm-stage svg { display: block; width: 100%; height: 100%; user-select: none; -webkit-user-select: none; }
.wm-stage svg .grid { display: none; }
.wm-stage svg .area {
  fill: var(--wm-fill, var(--land));
  stroke: var(--wm-rim, rgba(255,255,255,.16));
  stroke-width: 90;
  stroke-linejoin: round;
  transition: fill .35s ease, stroke .2s ease, opacity .8s ease calc(var(--k, 0) * 90ms);
}

/* Hover ring lives in its own layer, appended last, so a continent painted
   later (Europe over Asia/Africa) can no longer clip it in half. */
.wm-stage svg .wm-hl-layer { pointer-events: none; opacity: 0; transition: opacity .25s ease; }
.wm-stage svg .wm-hl-layer.on { opacity: 1; }
.wm-stage svg .wm-hl-glow { stroke: rgba(255,214,120,.30); }
.wm-stage svg .wm-hl-edge { stroke: #ffe9a8; }

.home.js .wm-stage svg .area { opacity: 0; }
.home.js.in .wm-stage svg .area { opacity: 1; }

/* ---------- Mini legend, at the top of the HUD ---------- */
.wm-key-mini {
  display: flex; align-items: center; gap: 6px;
  margin: -1px 0 7px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
  font-size: 8px; font-weight: 600;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--muted); white-space: nowrap;
}
.wm-key-mini em { font-style: normal; }
.wm-key-mini i {
  flex: 1; height: 4px; border-radius: 2px;
  border: 1px solid var(--border);
  background: linear-gradient(to right, #4a3b1c, #c79a2e, #ffe08a);
}

/* ---------- "Click to explore" affordance ---------- */
.wm-corners {
  position: absolute; inset: 8px; z-index: 4; pointer-events: none;
  opacity: 0;
  transition: opacity .3s ease;
}
.wm-corners i {
  position: absolute; width: 16px; height: 16px;
  border: 2px solid var(--gold);
  transition: transform .5s cubic-bezier(.2,.8,.2,1), border-color .25s ease;
}
.wm-corners i:nth-child(1) { top: 0; left: 0;  border-right: 0; border-bottom: 0; border-radius: 4px 0 0 0; transform: translate(-8px, -8px); }
.wm-corners i:nth-child(2) { top: 0; right: 0; border-left: 0;  border-bottom: 0; border-radius: 0 4px 0 0; transform: translate( 8px, -8px); }
.wm-corners i:nth-child(3) { bottom: 0; left: 0;  border-right: 0; border-top: 0; border-radius: 0 0 0 4px; transform: translate(-8px,  8px); }
.wm-corners i:nth-child(4) { bottom: 0; right: 0; border-left: 0;  border-top: 0; border-radius: 0 0 4px 0; transform: translate( 8px,  8px); }

.wm-hint {
  position: absolute; left: 50%; bottom: 12px; z-index: 4; pointer-events: none;
  display: inline-flex; align-items: center; gap: 7px;
  padding: 5px 12px 5px 10px; border-radius: 999px;
  font-size: 9px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
  color: var(--ink);
  background: color-mix(in srgb, var(--surface) 70%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border: 1px solid var(--border);
  opacity: 0; transform: translate(-50%, 8px);
  transition: opacity .35s ease, transform .45s cubic-bezier(.2,.8,.2,1);
}
.wm-hint svg { width: 12px; height: 12px; color: var(--gold); }
/* Map hover → gold corners */
.wm-stage:hover .wm-corners      { opacity: 1; }
.wm-stage:hover .wm-corners i    { transform: none; }
.wm-stage:hover .wm-hint         { opacity: 1; transform: translate(-50%, 0); }

/* Close-button hover → corners flash red as a "you're leaving" cue */
.home.focus-map .worldmap.close-hover .wm-corners   { opacity: 1; }
.home.focus-map .worldmap.close-hover .wm-corners i { transform: none; border-color: #ff5c5c; }

/* While the zoom-out animation is running, kill everything */
.home.closing .wm-corners { opacity: 0 !important; pointer-events: none !important; }

/* ---------- Map lens zoom ---------- */
.home { transform-origin: 0 0; }

/* Siblings stay visible the whole time the map is focused. They just
   fade to a dim, blurred "out of focus" state and stay that way until
   the map closes. */
.home .collection-head,
.home .home-left,
.home .home-right > :not(.worldmap) {
  transition: opacity .5s ease;
}

.home.focus-map .collection-head,
.home.focus-map .home-left,
.home.focus-map .home-right > :not(.worldmap) {
  opacity: .45;
  pointer-events: none;
}

.home.closing .collection-head,
.home.closing .home-left,
.home.closing .home-right > :not(.worldmap) {
  filter: none;
  transition: opacity .5s ease;
}

.home.focus-map .wm-stage { border-color: var(--gold); cursor: grab; touch-action: none; }
/* The heavy drop shadow only appears once the map has landed. */
.home.focus-map.settled .wm-stage { box-shadow: 0 30px 100px rgba(0,0,0,.6); }
.home.focus-map .wm-stage.dragging { cursor: grabbing; }
.home.focus-map .wm-corners,
.home.focus-map .wm-hint { opacity: 0; }

/* Overlays live in the map's corners and are counter-scaled, so they keep
   their size while zoomed. */
.wm-close, .wm-hud { transform-origin: var(--o, top right); transform: scale(var(--inv, 1)); }

.wm-close {
  --o: top right;
  position: absolute; top: 14px; right: 14px;
  width: 34px; height: 34px;
  display: grid; place-items: center; padding: 0;
  z-index: 6; cursor: pointer;
  background: color-mix(in srgb, var(--surface) 82%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border: 1px solid var(--border); border-radius: 8px;
  color: var(--muted);
  opacity: 0; pointer-events: none;
  transition: opacity .3s ease, background .2s, border-color .2s, color .2s;
}
.wm-close svg { width: 14px; height: 14px; }
.wm-close:hover {
  background: color-mix(in srgb, #ff5c5c 18%, var(--surface));
  border-color: #ff5c5c; color: #ff5c5c;
}
