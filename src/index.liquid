---
layout: layouts/base.liquid
title: Home
---

{% assign palette_hexes = "#F5F0E6|#8A8A8A|#525252|#1A1A1A|#D9C7A3|#7B5233|#4A3728|#531A13|#C0392B|#E08B2F|#C9A227|#E8C547|#4C9A5B|#1F5C33|#2FA8A0|#3468C0|#1B3A8C|#402B52|#7B4FA0|#E8A0BF" | split: "|" %}
{% assign tier_colors = "#ff7c80|#df8898|#be95b1|#9da2ca|#7cafe3" | split: "|" %}

{% assign total_pieces = specimens | sum: "quantity" %}
{% assign total_g = specimens | sum: "weight_g" %}
{% assign total_kg = total_g | divided_by: 1000.0 | round: 2 %}
{% assign total_spent = specimens | sum: "price" %}
{% assign shiny_count = specimens | where: "shiny", true | size %}
{% assign wip_count = specimens | where: "wip", true | size %}
{% assign model_count = 0 %}
{% if modelgallery %}{% assign model_count = modelgallery.size %}{% endif %}

{% comment %} --- Unique specimens --- {% endcomment %}
{%- assign names_blob = "" -%}
{%- for s in specimens -%}
  {%- assign s_main = s.main | strip -%}
  {%- if s_main != "" -%}
    {%- if names_blob == "" -%}
      {%- assign names_blob = s_main -%}
    {%- else -%}
      {%- assign names_blob = names_blob | append: "," | append: s_main -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign unique_specimens = 0 -%}
{%- if names_blob != "" -%}
  {%- assign unique_specimens = names_blob | downcase | replace: ", ", "," | replace: " ,", "," | split: "," | uniq | size -%}
{%- endif -%}

{% comment %} --- Acquisitions per year --- {% endcomment %}
{%- assign dated = specimens | where_exp: "s", "s.date_acquired > 0" | sort: "date_acquired" -%}
{%- assign has_dates = false -%}
{%- if dated.size > 0 -%}
  {%- assign has_dates = true -%}
  {%- assign first_year = dated.first.date_acquired | plus: 0 -%}
  {%- assign this_year  = "now" | date: "%Y" | plus: 0 -%}
{%- endif -%}

{% comment %} --- Spectrum total (for correct wave timing) --- {% endcomment %}
{% assign spectrum_total = 0 %}
{% for hex in palette_hexes %}
  {% for s in specimens %}
    {% if s.colors[0] == hex %}{% assign spectrum_total = spectrum_total | plus: 1 %}{% endif %}
  {% endfor %}
{% endfor %}

{% comment %} --- Tier / type helpers --- {% endcomment %}
{% assign tier_max = 1 %}
{% for t in (1..5) %}{% assign n = specimens | where: "tier", t | size %}{% if n > tier_max %}{% assign tier_max = n %}{% endif %}{% endfor %}
{% assign tier_durs = "1600|1100|2000|1300|1800" | split: "|" %}
{% assign type_colors = "#7cafe3|#ff7c80|#9da2ca|#E8C547|#2FA8A0|#E08B2F" | split: "|" %}

{% comment %} ══════════════════════════════════════════════════════════════
   WORLD MAP — region keyword table.
   Add/remove keywords per region (case-insensitive substring match
   against specimen.from_where). Format: REGION_ID:kw1,kw2,kw3|...
   The REGION_ID must match the id="" of the matching <path> in the SVG.
   ══════════════════════════════════════════════════════════════ {% endcomment %}
{%- assign wm_regions = "IT:Italy,Italia|SOUTH_AMERICA:Brazil,Brasile,Argentina,Chile,Cile,Peru,Perù,Perú,Colombia,Venezuela,Ecuador,Bolivia,Uruguay,Paraguay,Guyana,Suriname|NORTH_AMERICA:United States,USA,U.S.,Stati Uniti,Canada,Mexico,Messico,Guatemala,Cuba,Jamaica,Giamaica,Dominican Republic,Repubblica Domenicana,Haiti,Honduras,Panama,Costa Rica,Nicaragua,El Salvador,Belize|EUROPE:France,Francia,Germany,Germania,Spain,Spagna,Portugal,Portogallo,United Kingdom,Regno Unito,England,Inghilterra,Scotland,Scozia,Wales,Galles,Ireland,Irlanda,Netherlands,Paesi Bassi,Olanda,Belgium,Belgio,Switzerland,Svizzera,Austria,Poland,Polonia,Czech,Ceca,Slovakia,Slovacchia,Slovenia,Croatia,Croazia,Serbia,Albania,Hungary,Ungheria,Romania,Bulgaria,Greece,Grecia,Norway,Norvegia,Sweden,Svezia,Finland,Finlandia,Denmark,Danimarca,Iceland,Islanda,Russia,Ukraine,Ucraina|AFRICA:Africa,Morocco,Marocco,Algeria,Tunisia,Libya,Libia,Egypt,Egitto,Sudan,Ethiopia,Etiopia,Kenya,Tanzania,South Africa,Sudafrica,Namibia,Botswana,Zimbabwe,Zambia,Mozambique,Mozambico,Madagascar,Nigeria,Ghana,Senegal,Mali,Niger,Chad,Ciad,Cameroon,Camerun,Congo,Angola,Malawi,Uganda,Rwanda,Burundi|ASIA:China,Cina,Japan,Giappone,Korea,Corea,India,Pakistan,Afghanistan,Iran,Iraq,Turkey,Turchia,Mongolia,Thailand,Tailandia,Vietnam,Laos,Cambodia,Myanmar,Birmania,Malaysia,Malesia,Indonesia,Philippines,Filippine,Saudi Arabia,Arabia Saudita,UAE,Emirati,Qatar,Kuwait,Israel,Israele,Jordan,Giordania,Lebanon,Libano,Syria,Siria,Kazakhstan,Kazakistan,Uzbekistan,Nepal,Bhutan,Bangladesh,Sri Lanka|OCEANIA:Australia,New Zealand,Nuova Zelanda,Papua New Guinea,Papua Nuova Guinea,Fiji,Samoa,Tonga,Vanuatu,Solomon|ANTARTICA:Antarctica,Antartica,Antarctic,Antartide" | split: "|" -%}

{%- assign wm_counts = "" -%}
{%- for entry in wm_regions -%}
  {%- assign parts = entry | split: ":" -%}
  {%- assign rid = parts[0] -%}
  {%- assign keywords = parts[1] | split: "," -%}
  {%- assign cnt = 0 -%}
  {%- for s in specimens -%}
    {%- assign fw = s.from_where | default: "" | downcase -%}
    {%- for kw in keywords -%}
      {%- assign kwl = kw | downcase | strip -%}
      {%- if kwl != "" and fw contains kwl -%}
        {%- assign cnt = cnt | plus: 1 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if forloop.first -%}
    {%- assign wm_counts = wm_counts | append: '"' | append: rid | append: '":' | append: cnt -%}
  {%- else -%}
    {%- assign wm_counts = wm_counts | append: ',"' | append: rid | append: '":' | append: cnt -%}
  {%- endif -%}
{%- endfor -%}
{%- assign wm_json = "{" | append: wm_counts | append: "}" -%}

{%- comment -%} ── EXPLORE data: shelves → boxes ── {%- endcomment -%}
{%- assign EX_MAX_BOX = 30 -%}
{%- assign ex_parts = "" -%}
{%- for sh in (1..4) -%}
  {%- assign sh_specs = specimens | where: "shelf", sh -%}
  {%- assign sh_names = "" -%}
  {%- for s in sh_specs -%}
    {%- assign s_m = s.main | strip -%}
    {%- if s_m != "" -%}
      {%- if sh_names == "" -%}{%- assign sh_names = s_m -%}{%- else -%}{%- assign sh_names = sh_names | append: "," | append: s_m -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign sh_unique = 0 -%}
  {%- if sh_names != "" -%}{%- assign sh_unique = sh_names | downcase | split: "," | uniq | size -%}{%- endif -%}

  {%- assign bx_parts = "" -%}
  {%- for b in (0..EX_MAX_BOX) -%}
    {%- assign b_specs = sh_specs | where: "box", b -%}
    {%- if b_specs.size > 0 -%}
      {%- assign b_names = "" -%}
      {%- for s in b_specs -%}
        {%- assign s_m = s.main | strip -%}
        {%- if s_m != "" -%}
          {%- if b_names == "" -%}{%- assign b_names = s_m -%}{%- else -%}{%- assign b_names = b_names | append: "," | append: s_m -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign b_unique = 0 -%}
      {%- if b_names != "" -%}{%- assign b_unique = b_names | downcase | split: "," | uniq | size -%}{%- endif -%}
      {%- capture b_entry -%}{"box":{{ b }},"count":{{ b_specs.size }},"unique":{{ b_unique }},"pieces":{{ b_specs | sum: "quantity" }},"weight_g":{{ b_specs | sum: "weight_g" }},"price":{{ b_specs | sum: "price" }}}{%- endcapture -%}
      {%- if bx_parts == "" -%}{%- assign bx_parts = b_entry -%}{%- else -%}{%- assign bx_parts = bx_parts | append: "," | append: b_entry -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- capture sh_entry -%}{"shelf":{{ sh }},"count":{{ sh_specs.size }},"unique":{{ sh_unique }},"pieces":{{ sh_specs | sum: "quantity" }},"weight_g":{{ sh_specs | sum: "weight_g" }},"price":{{ sh_specs | sum: "price" }},"boxes":[{{ bx_parts }}]}{%- endcapture -%}
  {%- if ex_parts == "" -%}{%- assign ex_parts = sh_entry -%}{%- else -%}{%- assign ex_parts = ex_parts | append: "," | append: sh_entry -%}{%- endif -%}
{%- endfor -%}
{%- assign explore_json = "[" | append: ex_parts | append: "]" -%}

<div class="home" id="home">

  <header class="collection-head">
    <button class="coll-arrow" type="button" aria-label="Previous collection" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <h1 class="collection-title">The Collection</h1>
    <button class="coll-arrow" type="button" aria-label="Next collection" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
    <div class="sys-container">
      <span class="sys-status"><i></i>SYSTEM ONLINE</span>
      <a href="/admin/" class="sys-admin-link" aria-hidden="true" tabindex="-1">ADMIN</a>
    </div>
  </header>

  <!-- ============================ LEFT COLUMN ============================ -->
  <section class="home-left">

    <div class="stat-grid">
      <button class="stat explore-stat" id="exploreBtn" type="button" style="--i:0; --c:var(--gold)">
        <span class="stat-num">Shelves &amp; boxes</span>
        <span class="stat-label">Explore</span>
        <svg class="explore-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>

      <a class="stat" style="--i:0; --c:#7cafe3" href="/collection/">
        <span class="stat-num"><span data-count="{{ specimens.size }}">{{ specimens.size }}</span></span>
        <span class="stat-label">Specimens</span>
      </a>
      <a class="stat" style="--i:1; --c:#2FA8A0" href="/collection/">
        <span class="stat-num"><span data-count="{{ unique_specimens }}">{{ unique_specimens }}</span></span>
        <span class="stat-label">Species</span>
      </a>
      <a class="stat" style="--i:2; --c:#9da2ca" href="/collection/?sort=9:desc">
        <span class="stat-num"><span data-count="{{ total_pieces }}">{{ total_pieces }}</span></span>
        <span class="stat-label">Pieces</span>
      </a>
      <a class="stat" style="--i:3; --c:#E8C547" href="/collection/?sort=8:desc">
        <span class="stat-num"><span data-count="{{ total_kg }}">{{ total_kg }}</span><small>kg</small></span>
        <span class="stat-label">Weight</span>
      </a>
      <a class="stat" style="--i:4; --c:#C9A227" href="/collection/?sort=10:desc">
        <span class="stat-num">€<span data-count="{{ total_spent }}">{{ total_spent }}</span></span>
        <span class="stat-label">Invested</span>
      </a>
      <a class="stat" style="--i:5; --c:#E8A0BF" href="/collection/?shiny=1">
        <span class="stat-num"><span data-count="{{ shiny_count }}">{{ shiny_count }}</span></span>
        <span class="stat-label">Shiny</span>
      </a>
      <a class="stat" style="--i:6; --c:#ff9500" href="/collection/?wip=1">
        <span class="stat-num"><span data-count="{{ wip_count }}">{{ wip_count }}</span></span>
        <span class="stat-label">In progress</span>
      </a>
      <a class="stat" style="--i:7; --c:#7B4FA0" href="/collection/?view=models">
        <span class="stat-num"><span data-count="{{ model_count }}">{{ model_count }}</span></span>
        <span class="stat-label">3D models</span>
      </a>
    </div>

    <h2 class="home-h">By tier</h2>
    <div class="tier-cols">
      {% for t in (1..5) %}
        {% assign n = specimens | where: "tier", t | size %}
        {% assign idx = t | minus: 1 %}
        {% assign h = n | times: 100.0 | divided_by: tier_max | round: 1 %}
        {% assign pct = n | times: 100.0 | divided_by: specimens.size | round %}
        {% assign dl = idx | times: 120 | plus: 350 %}
        <a class="tier-col" href="/collection/?tier={{ t }}" style="--c: {{ tier_colors[idx] }};" title="Tier {{ t }}: {{ n }} specimens">
          <span class="tier-n"><b data-count="{{ n }}" data-dur="{{ tier_durs[idx] }}" data-delay="{{ dl }}">{{ n }}</b></span>
          <span class="tier-track"><span class="tier-fill" style="--h: {{ h }}%; --d: {{ tier_durs[idx] }}ms; --dl: {{ dl }}ms;"></span></span>
          <span class="tier-tag">
            <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M49.9981 0H50C69 0 100 0.00416183 100 50.0002C100 99.9963 69 100.002 50 100.002C31 100.002 0 100.002 0 50.0002C0 0 30.9979 0 49.9981 0Z"/></svg>
            <em>{{ t }}</em>
          </span>
          <span class="tier-pct">{{ pct }}%</span>
        </a>
      {% endfor %}
    </div>

    <h2 class="home-h">By type</h2>
    <div class="type-cards">
      {% assign types = "Crystal|Gem|Rock|Mineral|Geode|Fossil" | split: "|" %}
      {% for ty in types %}
        {% assign n = specimens | where: "type", ty | size %}
        {% assign tw = specimens | where: "type", ty | sum: "weight_g" %}
        {% assign tkg = tw | divided_by: 1000.0 | round: 2 %}
        {% assign s = n | times: 1.0 | divided_by: specimens.size | round: 3 %}
        {% assign pct = n | times: 100.0 | divided_by: specimens.size | round %}
        <a class="type-card" href="/collection/?type={{ ty }}" style="--i:{{ forloop.index0 }}; --s:{{ s }}; --p:{{ pct }}; --c:{{ type_colors[forloop.index0] }};">
          <span class="type-head">
            <span class="type-ico">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {% case ty %}
                  {% when "Crystal" %}
                    <path class="ico-shape" d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/>
                    <path class="ico-detail" d="M5 7 L12 11 L19 7 M12 11 V22"/>
                  {% when "Gem" %}
                    <path class="ico-shape" d="M7 4 L17 4 L21 10 L12 22 L3 10 Z"/>
                    <path class="ico-detail" d="M3 10 H21 M7 4 L10 10 L12 22 M17 4 L14 10 L12 22"/>
                  {% when "Rock" %}
                    <path class="ico-shape" d="M3 16 L4 8 L10 4 L17 5 L21 11 L19 18 L11 20 Z"/>
                    <path class="ico-detail" d="M4 8 L11 12 L21 11 M11 12 V20 M11 12 L17 5"/>
                  {% when "Mineral" %}
                    <path class="ico-shape" d="M6 4 L12 8 V21 L3 17 V7 Z"/>
                    <path class="ico-shape" style="opacity:.5" d="M13 6 L20 9 L21 18 L14 20 Z"/>
                    <path class="ico-detail" d="M6 4 L12 8 M3 17 L12 21 M13 6 L20 9 M14 20 L21 18"/>
                  {% when "Geode" %}
                    <circle class="ico-shape" cx="12" cy="12" r="10"/>
                    <path class="ico-detail" d="M6 12 L8 10 L9.5 12 L11 9.5 L12.5 11.5 L14 9 L15.5 11 L17 10 L18 12 L17 14 L15 13.5 L14 16 L12.5 14 L11 16 L9.5 14 L8 15 L6.5 13.5 Z"/>
                  {% when "Fossil" %}
                    <path class="ico-spiral" d="M12 12 C12 10 13.5 9 15 9 C17.5 9 19 11 19 13 C19 16 16 19 13 19 C9 19 5 16 5 12 C5 6 11 4 17 6"/>
                {% endcase %}
              </svg>
            </span>
            <em class="type-count" data-count="{{ n }}">{{ n }}</em>
          </span>
          <span class="type-name">{{ ty }}</span>
          <span class="type-bar"><i></i></span>
          <span class="type-meta">{{ pct }}% · {{ tkg }} kg</span>
        </a>
      {% endfor %}
    </div>

    <a class="home-cta" href="/collection/">
      <span class="cta-text">
        <small>Open the catalog</small>
        <strong>Browse all {{ specimens.size }} specimens</strong>
      </span>
      <span class="cta-strip" aria-hidden="true">
        {% for hex in palette_hexes %}<i style="background: {{ hex }}; --k: {{ forloop.index0 }};"></i>{% endfor %}
      </span>
      <span class="cta-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
  </section>

  <!-- ============================ RIGHT COLUMN ============================ -->
  <section class="home-right">

    <h2 class="home-h">Color spectrum</h2>
    <div class="spectrum">
      {% if spectrum_total > 0 %}
        {% assign si = 0 %}
        {% for hex in palette_hexes %}
          {% for m in specimens %}
            {% if m.colors[0] == hex %}
              {% assign bar_delay = si | times: 1400 | divided_by: spectrum_total %}
              <a href="/collection/{{ m.slug }}/" title="{{ m.name }}" style="background: {{ hex }}; --dl:{{ bar_delay }}ms;"></a>
              {% assign si = si | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>
    <p class="home-note" id="spectrumNote" data-default="Every bar is one specimen, ordered by its main color.">Every bar is one specimen, ordered by its main color.</p>

    {% if has_dates %}
      <div class="yr-wrap">
        <h2 class="home-h">By year</h2>
        <div class="yr-chart" id="yrChart"
             data-tiers='{ {%- for y in (first_year..this_year) -%}"{{ y }}":"{%- for m in dated -%}{%- assign my = m.date_acquired | plus: 0 -%}{%- if my == y -%}{{ m.tier }}{%- endif -%}{%- endfor -%}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }'>
          <div class="yr-head-row"><span class="yr-readout"></span></div>
          <div class="yr-plot"></div>
        </div>
      </div>
    {% endif %}

    <!-- ══════════════════════ WORLD MAP ══════════════════════ -->
    <h2 class="home-h">By origin</h2>
    <div class="worldmap" id="worldmap" data-region-counts='{{ wm_json }}'>
      <div class="wm-stage" id="wmStage" role="button" tabindex="0" aria-label="Expand world map" aria-expanded="false">
        {% include "worldmap.svg" %}

        <span class="wm-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="wm-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          Explore map
        </span>
      </div>

      <div class="wm-tip" hidden aria-hidden="true">
        <span class="wm-tip-name">—</span>
        <span class="wm-tip-count"><b>0</b></span>
      </div>

      <div class="wm-hud"></div>

      <button class="wm-close" type="button" aria-label="Close expanded map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

  </section>
  <div class="ex-panel" id="exPanel" hidden aria-hidden="true" data-explore='{{ explore_json | escape }}'>
    <div class="ex-inner">
      <header class="ex-head">
        <div class="ex-head-text">
          <h2 class="ex-title">Explore</h2>
          <span class="ex-sub"></span>
        </div>
        <button class="ex-close" type="button" aria-label="Close explorer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="ex-body">
        <div class="ex-level ex-shelves" data-level="shelves"></div>
        <div class="ex-level ex-boxes" data-level="boxes" hidden></div>
      </div>
    </div>
  </div>
</div>