<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script>
    document.documentElement.classList.add('is-loading');
    try {
      const theme = localStorage.getItem('theme');
      if (theme) document.documentElement.dataset.theme = theme;
    } catch {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · My Collection</title>

  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="32x32">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap" rel="stylesheet">

  <link rel="modulepreload" href="/assets/js/three.module.js" fetchpriority="high">
  <link rel="modulepreload" href="/assets/js/three.core.js" fetchpriority="high">
  <link rel="modulepreload" href="/assets/js/jsm/controls/OrbitControls.js">
  <link rel="modulepreload" href="/assets/js/jsm/loaders/STLLoader.js">

  <script type="importmap">
    {
      "imports": {
        "three": "/assets/js/three.module.js",
        "three/addons/": "/assets/js/jsm/"
      }
    }
  </script>

  <link rel="stylesheet" href="/assets/css/base.css">
  {% if page.url == '/' %}
    <link rel="stylesheet" href="/assets/css/home.css">
  {% elsif page.url == '/collection/' %}
    <link rel="stylesheet" href="/assets/css/collection.css">
  {% elsif specimen %}
    <link rel="stylesheet" href="/assets/css/specimen.css">
  {% endif %}

  <style>
    /* 🛑 LOADER STYLES */
    html.is-loading body {
      overflow: hidden;
    }

    #global-loader {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background-color: var(--bg);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      transition: opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.6s;
    }

    #global-loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* The Spinning Crystal */
    .loader-crystal {
      width: 50px;
      height: 50px;
      color: var(--gold);
      animation: spin-crystal 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.4));
    }

    .loader-crystal path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linejoin: round;
    }

    .loader-crystal .inner {
      opacity: 0.5;
      stroke-dasharray: 4 2;
    }

    @keyframes spin-crystal {
      0% { transform: rotateY(0deg) rotateX(15deg); }
      100% { transform: rotateY(360deg) rotateX(15deg); }
    }

    .loader-text {
      font-family: Consolas, monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      animation: pulse-text 2s ease-in-out infinite;
    }

    @keyframes pulse-text {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }
  </style>
</head>
<body>
  <div id="global-loader">
    <svg class="loader-crystal" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/>
      <path class="inner" d="M5 7 L12 11 L19 7 M12 11 V22"/>
    </svg>
    <span class="loader-text">Loading</span>
  </div>
  <header class="site-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {% if page.url == '/' %}
        <span class="breadcrumb-current">Home</span>
      {% elsif page.url == '/collection/' %}
        <a class="breadcrumb-link" href="/">Home</a>
        <span class="breadcrumb-separator" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <span class="breadcrumb-current">The Collection</span>
      {% elsif specimen %}
        {% assign specimenIndex = 0 %}
        {% for s in specimens %}
          {% if s.slug == specimen.slug %}
            {% assign specimenIndex = forloop.index %}
            {% break %}
          {% endif %}
        {% endfor %}
        <a class="breadcrumb-link" href="/">Home</a>
        <span class="breadcrumb-separator" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <a class="breadcrumb-link" href="/collection/">The Collection</a>
        <span class="breadcrumb-separator" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <span class="breadcrumb-current">Specimen {{ specimenIndex }}</span>
      {% else %}
        <a class="breadcrumb-link" href="/">Home</a>
      {% endif %}
    </nav>

    <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle light/dark theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </header>

  <main>{{ content }}</main>

  <script src="/assets/js/base.js" defer></script>
  {% if page.url == '/' %}
    <script src="/assets/js/home.js" defer></script>
  {% elsif page.url == '/collection/' %}
    <script src="/assets/js/collection.js" defer></script>
  {% elsif specimen %}
    <script src="/assets/js/specimen.js" defer></script>
  {% endif %}

</body>
</html>