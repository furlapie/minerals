---
layout: layouts/base.liquid
title: Collection
permalink: /collection/
---

<script>document.documentElement.classList.add('coll-boot');</script>
<style>
  html.coll-boot .coll-toolbar,
  html.coll-boot .rail,
  html.coll-boot .table-responsive,
  html.coll-boot .coll-footer { opacity: 0; }
  html.coll-boot .table-responsive { overflow: hidden; }
  html.coll-boot::-webkit-scrollbar-thumb,
  html.coll-boot::-webkit-scrollbar-track { background: transparent; }
</style>

{% comment %} Palette (hue-wheel order) — hexes + readable names, same order {% endcomment %}
{% assign palette_hexes = "#F5F0E6|#8A8A8A|#525252|#1A1A1A|#D9C7A3|#7B5233|#4A3728|#531A13|#C0392B|#E08B2F|#C9A227|#E8C547|#4C9A5B|#1F5C33|#2FA8A0|#3468C0|#1B3A8C|#402B52|#7B4FA0|#E8A0BF" | split: "|" %}
{% assign palette_names = "Cream|Gray|Charcoal|Black|Sand|Brown|Umber|Maroon|Red|Orange|Gold|Yellow|Green|Forest|Teal|Blue|Navy|Plum|Purple|Pink" | split: "|" %}
{% assign types = "Crystal|Gem|Rock|Mineral|Geode|Fossil" | split: "|" %}


<!-- ═════════ ICON SPRITE ═════════════════════════════════ -->
<svg class="ti-sprite" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="ti-Crystal" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M5 7 L12 11 L19 7 M12 11 V22"/>
  </symbol>
  <symbol id="ti-Gem" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M7 4 L17 4 L21 10 L12 22 L3 10 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M3 10 H21 M7 4 L10 10 L12 22 M17 4 L14 10 L12 22"/>
  </symbol>
  <symbol id="ti-Rock" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M3 16 L4 8 L10 4 L17 5 L21 11 L19 18 L11 20 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M4 8 L11 12 L21 11 M11 12 V20 M11 12 L17 5"/>
  </symbol>
  <symbol id="ti-Mineral" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M6 4 L12 8 V21 L3 17 V7 Z"/>
    <path fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M13 6 L20 9 L21 18 L14 20 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M6 4 L12 8 M3 17 L12 21 M13 6 L20 9 M14 20 L21 18"/>
  </symbol>
  <symbol id="ti-Geode" viewBox="0 0 24 24">
    <circle fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" cx="12" cy="12" r="10"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M6 12 L8 10 L9.5 12 L11 9.5 L12.5 11.5 L14 9 L15.5 11 L17 10 L18 12 L17 14 L15 13.5 L14 16 L12.5 14 L11 16 L9.5 14 L8 15 L6.5 13.5 Z"/>
  </symbol>
  <symbol id="ti-Fossil" viewBox="0 0 24 24">
    <path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" d="M12 12 C12 10 13.5 9 15 9 C17.5 9 19 11 19 13 C19 16 16 19 13 19 C9 19 5 16 5 12 C5 6 11 4 17 6"/>
  </symbol>
  <symbol id="tier-blob" viewBox="0 0 100 100">
    <path d="M49.9981 0H50C69 0 100 0.00416183 100 50.0002C100 99.9963 69 100.002 50 100.002C31 100.002 0 100.002 0 50.0002C0 0 30.9979 0 49.9981 0Z"/>
  </symbol>
</svg>


<!-- ═════════ PAGE WRAPPER ══════════════════════════════════ -->
<div class="coll enter" id="coll" data-view="table">

  <!-- ═══════ COMMAND BAR ═══════════════════════════════════ -->
  <div class="coll-toolbar">

    <label class="ct-search">
      <svg class="ct-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="globalSearch" placeholder="Search the collection…" autocomplete="off" spellcheck="false">
      <kbd class="ct-kbd" aria-hidden="true">/</kbd>
    </label>

    <div class="ct-chips" id="activeChips" aria-live="polite" hidden></div>

    <div class="ct-meta">
      <span class="ct-count" title="Visible / total specimens">
        <b id="resultCount">0</b><span class="ct-sep">/</span><span class="ct-total" id="totalCount">{{ specimens.size }}</span>
      </span>

      <div class="ct-seg" role="group" aria-label="View">
        <button class="ct-seg-btn on" type="button" data-view="table" aria-pressed="true" title="Table view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16"/></svg>
        </button>
        <button class="ct-seg-btn" type="button" data-view="grid" aria-pressed="false" title="Gallery view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><rect x="14" y="14" width="7" height="7" rx="1.4"/></svg>
        </button>
        <button class="ct-seg-btn" type="button" data-view="models" aria-pressed="false" title="3D Models view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/></svg>
        </button>
      </div>

      <button class="ct-icon-btn" id="densityToggle" type="button" title="Toggle row density" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button class="ct-peek-toggle" id="peekToggle" type="button"
              title="Hover preview: on" aria-pressed="true">
        <svg class="pt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span class="pt-track" aria-hidden="true"><i></i></span>
      </button>
      <button class="ct-icon-btn ct-clear" id="clearAll" type="button" title="Clear all filters">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- ═══════ QUICK FILTER RAIL ═════════════════════════════ -->
  <div class="rail">

    <div class="rail-group">
      <span class="rail-label">Type</span>
      <div class="rail-items">
        {% for ty in types %}
          {% assign n = specimens | where: "type", ty | size %}
          <button class="tp" type="button" data-type="{{ ty }}" aria-pressed="false">
            <svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ ty }}"/></svg>
            <span>{{ ty }}</span><em>{{ n }}</em>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="rail-group">
      <span class="rail-label">Tier</span>
      <div class="rail-items rail-tiers">
        {% for t in (1..5) %}
          <button class="tt" type="button" data-tier="{{ t }}" aria-pressed="false" aria-label="Tier {{ t }}" title="Tier {{ t }}">
            <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#tier-blob"/></svg>
            <span>{{ t }}</span>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="rail-group">
      <span class="rail-label">Flags</span>
      <div class="rail-items">
        <button class="fl fl-shiny" type="button" id="railShiny" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L13.6 8.4 L20 10 L13.6 11.6 L12 18 L10.4 11.6 L4 10 L10.4 8.4 Z" fill="currentColor"/></svg>
          Shiny
        </button>
        <button class="fl fl-wip" type="button" id="railWip" aria-pressed="false">
          <i></i>In progress
        </button>
      </div>
    </div>

    <div class="rail-group rail-colors">
      <span class="rail-label">Color</span>
      <div class="rail-items">
        {% for hex in palette_hexes %}
          <button class="cd" type="button" data-color="{{ hex }}" data-name="{{ palette_names[forloop.index0] }}" style="background: {{ hex }};" aria-pressed="false" aria-label="{{ palette_names[forloop.index0] }}"></button>
        {% endfor %}
      </div>
    </div>
  </div>


  <!-- ═══════ TABLE VIEW ════════════════════════════════════ -->
  <div class="table-responsive">
    <table class="specimen-table" id="specimenTable">
      <thead>
        <tr>
          <th>
            <div class="th-content">
              <span class="th-label">Locate</span>
              <button class="filter-toggle" data-col="0" data-type="text" aria-expanded="false" aria-label="Filter Locate column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="0">
              <input type="text" class="filter-text" placeholder="e.g. S1, B7, #13...">
              <button class="wip-filter-btn" type="button" aria-pressed="false">WIP</button>
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Color</span>
              <button class="filter-toggle" data-col="1" data-type="color" aria-expanded="false" aria-label="Filter Color column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup color-filter-popup" data-col="1">
              <div class="color-swatch-grid">
                {% for hex in palette_hexes %}
                  <button class="color-filter-btn" data-color="{{ hex }}" style="background: {{ hex }};" aria-label="Filter by this color" aria-pressed="false"></button>
                {% endfor %}
              </div>
              <button class="shiny-filter-btn" type="button" aria-pressed="false">Shiny</button>
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Top → Bottom</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Bottom → Top</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Title</span>
              <button class="filter-toggle" data-col="2" data-type="text" aria-expanded="false" aria-label="Filter Title column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="2">
              <input type="text" class="filter-text" placeholder="Filter title...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">From</span>
              <button class="filter-toggle" data-col="3" data-type="text" aria-expanded="false" aria-label="Filter From column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="3">
              <input type="text" class="filter-text" placeholder="Filter from...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Origin</span>
              <button class="filter-toggle" data-col="4" data-type="text" aria-expanded="false" aria-label="Filter Origin column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="4">
              <input type="text" class="filter-text" placeholder="Filter origin...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Description</span>
              <button class="filter-toggle" data-col="5" data-type="text" aria-expanded="false" aria-label="Filter Description column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="5">
              <input type="text" class="filter-text" placeholder="Filter description...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Date</span>
              <button class="filter-toggle" data-col="6" data-type="value" aria-expanded="false" aria-label="Filter Date column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="6">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Year" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Old → New</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">New → Old</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">T</span>
              <button class="filter-toggle" data-col="7" data-type="type" aria-expanded="false" aria-label="Filter Type column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup type-filter-popup" data-col="7">
              <div class="type-filter-list">
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Crystal" aria-pressed="false" aria-label="Crystal"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Crystal"/></svg></button><span class="type-filter-label">Crystal</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Gem"     aria-pressed="false" aria-label="Gem"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Gem"/></svg></button><span class="type-filter-label">Gem</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Rock"    aria-pressed="false" aria-label="Rock"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Rock"/></svg></button><span class="type-filter-label">Rock</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Mineral" aria-pressed="false" aria-label="Mineral"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Mineral"/></svg></button><span class="type-filter-label">Mineral</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Geode"   aria-pressed="false" aria-label="Geode"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Geode"/></svg></button><span class="type-filter-label">Geode</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Fossil"  aria-pressed="false" aria-label="Fossil"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Fossil"/></svg></button><span class="type-filter-label">Fossil</span></div>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Weight</span>
              <button class="filter-toggle" data-col="8" data-type="value" aria-expanded="false" aria-label="Filter Weight column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="8">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="0.1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Qty</span>
              <button class="filter-toggle" data-col="9" data-type="value" aria-expanded="false" aria-label="Filter Qty column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="9">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Price</span>
              <button class="filter-toggle" data-col="10" data-type="value" aria-expanded="false" aria-label="Filter Price column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="10">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="0.01">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Tier</span>
              <button class="filter-toggle" data-col="11" data-type="value" aria-expanded="false" aria-label="Filter Tier column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="11">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>
        </tr>
      </thead>

      <tbody>
        {% for specimen in specimens %}

          {% capture image_path %}/images/the_collection/thumb/{{ specimen.box }}.{{ specimen.number }}.jpg{% endcapture %}

          {% assign shelf_part = specimen.shelf | times: 10000000 %}
          {% assign box_part = specimen.box | times: 1000 %}
          {% assign location_sort = shelf_part | plus: box_part | plus: specimen.number %}

          {% if specimen.colors %}
            {% assign colors = specimen.colors %}
          {% else %}
            {% assign colors = "" | split: "" %}
          {% endif %}
          {% assign color_count = colors | size %}
          {% assign primary_color = colors[0] %}
          {% assign color_sort = 0 %}
          {% for hex in palette_hexes %}
            {% if hex == primary_color %}{% assign color_sort = forloop.index %}{% endif %}
          {% endfor %}

          {% if color_count == 3 %}
            {% assign swatch_bg = "linear-gradient(90deg, " | append: colors[0] | append: " 0%, " | append: colors[0] | append: " 7%, " | append: colors[1] | append: " 43%, " | append: colors[1] | append: " 57%, " | append: colors[2] | append: " 93%, " | append: colors[2] | append: " 100%)" %}
            {% assign t0 = colors[0] | append: "26" %}
            {% assign t1 = colors[1] | append: "26" %}
            {% assign t2 = colors[2] | append: "26" %}
            {% assign row_tint = "linear-gradient(90deg, " | append: t0 | append: " 0%, " | append: t0 | append: " 7%, " | append: t1 | append: " 43%, " | append: t1 | append: " 57%, " | append: t2 | append: " 93%, " | append: t2 | append: " 100%)" %}
          {% elsif color_count == 2 %}
            {% assign swatch_bg = "linear-gradient(90deg, " | append: colors[0] | append: " 0%, " | append: colors[0] | append: " 10%, " | append: colors[1] | append: " 90%, " | append: colors[1] | append: " 100%)" %}
            {% assign t0 = colors[0] | append: "26" %}
            {% assign t1 = colors[1] | append: "26" %}
            {% assign row_tint = "linear-gradient(90deg, " | append: t0 | append: " 0%, " | append: t0 | append: " 10%, " | append: t1 | append: " 90%, " | append: t1 | append: " 100%)" %}
          {% elsif color_count == 1 %}
            {% assign swatch_bg = colors[0] %}
            {% assign row_tint = colors[0] | append: "26" %}
          {% else %}
            {% assign swatch_bg = "var(--surface-2)" %}
            {% assign row_tint = "" %}
          {% endif %}

          <tr data-type="{{ specimen.type }}" data-tier="{{ specimen.tier }}" data-img="{{ image_path }}" data-habit="{{ specimen.habit }}" style="--i: {{ forloop.index0 }};{% if row_tint != "" %} --row-tint: {{ row_tint }};{% endif %}">

            <td class="locate-cell{% if specimen.wip %} wip{% endif %}" data-wip="{{ specimen.wip }}" data-sort-value="{{ location_sort }}">
              <span class="locate-dot"></span>
              <span class="locate-txt">S{{ specimen.shelf }} · B{{ specimen.box }} <span class="locate-hash">#</span>{{ specimen.number }}</span>
            </td>

            <td class="color-cell{% if specimen.shiny %} shiny{% endif %}"
                style="background: {{ swatch_bg }};"
                data-sort-value="{% if color_count == 0 %}999{% else %}{{ color_sort }}{% endif %}"
                title="{{ colors | join: ', ' | upcase }}"
                data-shiny="{{ specimen.shiny }}"
                data-colors="{{ colors | join: '|' | upcase }}">
              {% if specimen.shiny %}<span class="shiny-fx"></span>{% endif %}
            </td>

            <td class="title-cell"><a href="/collection/{{ specimen.slug }}/">{{ specimen.name }}</a></td>
            <td class="from-cell">{{ specimen.from_who }}</td>
            <td class="origin-cell">{{ specimen.from_where }}</td>
            <td class="desc-cell" title="{{ specimen.description | escape }}">{{ specimen.description }}</td>
            <td class="date-cell" data-value="{{ specimen.date_acquired }}">{{ specimen.date_acquired }}</td>

            <td class="type-col" data-type="{{ specimen.type }}" title="{{ specimen.type }}">
              <svg class="ti type-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ specimen.type }}"/></svg>
            </td>

            <td class="num-cell weight-cell" data-value="{{ specimen.weight_g }}">{{ specimen.weight_g }}<small>g</small></td>
            <td class="num-cell qty-cell" data-value="{{ specimen.quantity }}">{{ specimen.quantity }}</td>
            <td class="num-cell price-cell" data-value="{{ specimen.price }}">{% if specimen.price > 0 %}€{{ specimen.price }}{% else %}<span class="dash">—</span>{% endif %}</td>

            <td class="tier-cell" data-value="{{ specimen.tier }}">
              <div class="tier-badge">
                <svg class="tier-shape" viewBox="0 0 101 101" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path class="tier-path" d="M80.5 0.5 C80.5 0.5 20.5 0.5 20.5 0.5 C20.5 0.5 20.5 50.5 20.5 50.5 C20.5 50.5 20.5 100.5 20.5 100.5 H80.5 C80.5 100.5 80.5 50.5 80.5 50.5 C80.5 50.5 80.5 0.5 80.5 0.5 Z"/>
                </svg>
                <span class="tier-value">{{ specimen.tier }}</span>
              </div>
            </td>
          </tr>

        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- ═══════ GALLERY VIEW ═══════════════════════════════════ -->
  <div class="gallery" id="gallery" aria-label="Specimen gallery">
    {% for specimen in specimens %}
      {% capture g_image %}/images/the_collection/thumb/{{ specimen.box }}.{{ specimen.number }}.jpg{% endcapture %}
      {% if specimen.colors %}{% assign g_colors = specimen.colors | uniq %}{% else %}{% assign g_colors = "" | split: "" %}{% endif %}
      <a class="g-card" href="/collection/{{ specimen.slug }}/" data-type="{{ specimen.type }}" data-tier="{{ specimen.tier }}" data-habit="{{ specimen.habit }}" style="--i: {{ forloop.index0 }};">
        <div class="g-thumb">
          <span class="g-fallback" aria-hidden="true"><svg class="ti" viewBox="0 0 24 24"><use href="#ti-{{ specimen.type }}"/></svg></span>
          <img src="{{ g_image }}" alt="{{ specimen.name | escape }}" loading="lazy" decoding="async" onerror="this.style.display='none';"/>
          <span class="g-loc">S{{ specimen.shelf }} · B{{ specimen.box }} #{{ specimen.number }}</span>
          {% if specimen.shiny %}<span class="g-flag g-shiny" title="Shiny"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L13.6 8.4 L20 10 L13.6 11.6 L12 18 L10.4 11.6 L4 10 L10.4 8.4 Z" fill="currentColor"/></svg></span>{% endif %}
          {% if specimen.wip %}<span class="g-flag g-wip" title="Work in progress"></span>{% endif %}
        </div>
        <div class="g-colors" aria-hidden="true">{% for hex in g_colors %}<i style="background: {{ hex }};"></i>{% endfor %}</div>
        <div class="g-body">
          <span class="g-name">{{ specimen.name }}</span>
          <span class="g-meta">
            <svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ specimen.type }}"/></svg>
            <span class="g-meta-txt">{{ specimen.weight_g }}g{% if specimen.from_where != "" %} · {{ specimen.from_where }}{% endif %}</span>
            <span class="g-tier" title="Tier {{ specimen.tier }}"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#tier-blob"/></svg><em>{{ specimen.tier }}</em></span>
          </span>
        </div>
      </a>
    {% endfor %}
  </div>

  <!-- ═══════ 3D MODELS VIEW ═══════════════════════════════ -->
  <div class="models-grid" id="modelsGrid" aria-label="3D Models gallery">
    {% assign macro_list = "aciculare,botroidale,dendritico,fibroso,geodico,lamellare,massiccio" | split: "," %}
    {% assign sorted_models = modelgallery | sort: "file" %}
    {% for pass in (1..2) %}
      <section class="model-group" data-kind="{% if pass == 1 %}macro{% else %}crystal{% endif %}">
        <header class="model-group-head">
          <h2>{% if pass == 1 %}Non-crystalline habits{% else %}Crystals{% endif %}</h2>
          <span class="model-group-count"></span>
        </header>
        {% if pass == 2 %}<div class="model-tools" id="modelTools"></div>{% endif %}
        <div class="model-cells">
          {% for g in sorted_models %}
            {% assign is_macro = macro_list contains g.file %}
            {% assign show = false %}
            {% if pass == 1 and is_macro %}{% assign show = true %}{% endif %}
            {% if pass == 2 and is_macro != true %}{% assign show = true %}{% endif %}
            {% if show %}
              {% assign fparts = g.file | split: "-" %}
              {% assign hab = fparts[1] | default: fparts[0] %}
              {% assign sp_count = g.species | size %}
              {% assign spec_count = g.specimen_count | default: sp_count %}
              {% capture search_text %}{{ g.file }} {{ g.habit }} {{ g.species | join: " " }}{% endcapture %}
              <div class="model-card" data-habit="{{ g.habit }}" data-habit-tag="{{ hab }}" data-name="{{ fparts[0] }}" data-search="{{ search_text | downcase | escape }}" title="{{ g.species | join: ', ' | escape }}">
                <div class="model-thumb">
                  <div class="comp-3d" data-model="/habits/{{ g.file }}.stl"></div>
                </div>
                <div class="model-body">
                  <a class="model-name" href="/collection/?habit={{ g.habit | url_encode }}&view=table">{{ hab }}</a>
                  <span class="model-sub">
                    <span class="model-count">{{ spec_count }} specimen{% if spec_count != 1 %}s{% endif %}</span>
                  </span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>

  <!-- ═══════ EMPTY STATE ═══════════════════════════════════ -->
  <div id="emptyState" class="empty-state" hidden>
    <div class="empty-ico">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
        <path d="m8.5 8.5 5 5m0-5-5 5"/>
      </svg>
    </div>
    <h3>Nothing matches these filters</h3>
    <p>Try a different search, or clear the filters to see the whole collection again.</p>
    <button id="emptyClear" class="empty-clear-btn" type="button">Clear all filters</button>
  </div>

  <!-- ═══════ FOOTER STATS + LIVE MIX ═══════════════════════ -->
  <div class="coll-footer">
    <div class="cf-cell"><span class="cf-num" id="footerCount">0</span><span class="cf-lbl">specimens</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerPieces">0</span><span class="cf-lbl">pieces</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerWeight">0</span><span class="cf-lbl">kg</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerSpent">€0</span><span class="cf-lbl">invested</span></div>
    <div class="cf-cell cf-mix">
      <div class="mix-row"><span class="mix-lbl">By type</span><div class="mix" id="mixType"></div></div>
      <div class="mix-row"><span class="mix-lbl">By tier</span><div class="mix" id="mixTier"></div></div>
    </div>
    <button class="cf-cell cf-back" id="backToTop" type="button" aria-label="Back to top">
      <span class="cf-back-num" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5M5 12l7-7 7 7"/>
        </svg>
      </span>
      <span class="cf-lbl">TOP</span>
    </button>
  </div>
</div>

<!-- ═════════ HOVER PEEK ════════════════════════════════════ -->
<div class="peek" id="peek" aria-hidden="true">
  <div class="peek-card">
    <div class="peek-img">
      <span class="peek-fallback"><svg class="ti" viewBox="0 0 24 24"><use href="#ti-Crystal"/></svg></span>
      <img alt="" decoding="async">
    </div>
    <div class="peek-meta"><b></b></div>
  </div>
</div>

<style>
/* ═════════ BASE LAYOUT ═══════════════════════════════════ */
  main { max-width: 1861px !important; margin: 0 auto !important; padding-left: 2rem; padding-right: 2rem; }
  .coll { position: relative; isolation: isolate; padding-bottom: 1.25rem; }
  .coll::before {
    content: ""; position: absolute; top: 0; right: 0; bottom: auto; left: -1.5rem;
    height: 560px; z-index: -1; pointer-events: none; opacity: .35;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 25% 0%, #000 0%, transparent 85%);
            mask-image: radial-gradient(ellipse 70% 80% at 25% 0%, #000 0%, transparent 85%);
  }

  [data-type] { --c: #525252; }
  [data-type="Mineral"] { --c: #2FA8A0; }
  [data-type="Crystal"] { --c: #7cafe3; }
  [data-type="Fossil"]  { --c: #E08B2F; }
  [data-type="Geode"]   { --c: #E8C547; }
  [data-type="Gem"]     { --c: #ff7c80; }
  [data-type="Rock"]    { --c: #9da2ca; }
  [data-tier] { --t: #FF42E9; }
  [data-tier="1"] { --t: #ff7c80; }
  [data-tier="2"] { --t: #df8898; }
  [data-tier="3"] { --t: #be95b1; }
  [data-tier="4"] { --t: #9da2ca; }
  [data-tier="5"] { --t: #7cafe3; }

  .ti { width: 14px; height: 14px; overflow: visible; flex-shrink: 0; }

  .coll-toolbar, .rail, .table-responsive, .coll-footer { transition: opacity .4s ease; }
  .coll-toolbar    { transition-delay: .06s;  }
  .rail            { transition-delay: .12s;  }
  .table-responsive{ transition-delay: .18s;  }
  .coll-footer     { transition-delay: .24s;  }

/* ═════════ COMMAND BAR ═══════════════════════════════════ */
  .coll-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 1.5rem 0 12px; }

  .ct-search {
    display: flex; align-items: center; gap: 8px; padding: 8px 11px;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;
    flex: 0 1 300px; min-width: 190px;
    transition: border-color .2s ease, box-shadow .2s ease, flex-basis .35s cubic-bezier(.2,.8,.2,1);
  }
  .ct-search:focus-within { flex-basis: 400px; border-color: var(--gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 22%, transparent); }
  .ct-search-icon { width: 14px; height: 14px; color: var(--muted); flex-shrink: 0; }
  .ct-search input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; font-family: inherit; font-size: 13px; color: var(--ink); }
  .ct-search input::placeholder { color: var(--placeholder); opacity: .75; }
  .ct-kbd { font-family: Consolas, monospace; font-size: 10px; line-height: 1; padding: 3px 6px; border: 1px solid var(--border); border-radius: 5px; color: var(--muted); background: var(--surface); transition: opacity .2s ease; }
  .ct-search:focus-within .ct-kbd { opacity: 0; }

  .ct-chips { display: flex; gap: 6px; flex-wrap: wrap; flex: 1 1 auto; min-width: 0; align-items: center; }
  .ct-chips[hidden] { display: none; }

  .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px 4px 9px;
    background: color-mix(in srgb, var(--gold) 8%, var(--surface-2));
    border: 1px solid color-mix(in srgb, var(--gold) 32%, var(--border));
    border-radius: 999px; font-family: inherit; font-size: 11px; color: var(--ink);
    cursor: pointer; white-space: nowrap; max-width: 220px; line-height: 1;
    transition: background .15s ease, border-color .15s ease, color .15s ease;
  }
  .chip:hover { background: color-mix(in srgb, #ff5c5c 16%, var(--surface-2)); border-color: #ff5c5c; color: #ff5c5c; }
  .chip-label { overflow: hidden; text-overflow: ellipsis; display: block; max-width: 180px; text-transform: capitalize; }
  .chip svg { width: 10px; height: 10px; flex-shrink: 0; opacity: .55; }
  .chip:hover svg { opacity: 1; }
  .chip-swatch { width: 10px; height: 10px; border-radius: 3px; border: 1px solid rgba(255,255,255,.25); flex-shrink: 0; }

  .ct-meta { display: flex; align-items: center; gap: 8px; flex-shrink: 0; margin-left: auto; }
  .ct-count { font-family: Consolas, monospace; font-size: 12px; color: var(--muted); letter-spacing: .02em; padding: 0 4px; }
  .ct-count b { color: var(--ink); font-weight: 700; }
  .ct-sep { opacity: .4; margin: 0 3px; }
  .ct-total { opacity: .55; }

  .ct-icon-btn {
    width: 32px; height: 32px; display: grid; place-items: center;
    background: none; border: 1px solid var(--border); border-radius: 8px;
    color: var(--muted); cursor: pointer;
    transition: background .15s ease, border-color .15s ease, color .15s ease;
  }
  .ct-icon-btn svg { width: 15px; height: 15px; }
  .ct-icon-btn:hover { background: var(--surface-2); color: var(--ink); border-color: var(--muted); }
  .ct-icon-btn.active { border-color: var(--gold); color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, transparent); }
  .ct-clear:hover { border-color: #ff5c5c; color: #ff5c5c; }

  .ct-peek-toggle {
    display: inline-flex; align-items: center; gap: 7px;
    height: 32px; padding: 0 9px;
    background: none; border: 1px solid var(--border); border-radius: 8px;
    color: var(--muted); cursor: pointer;
    transition: border-color .15s ease, color .15s ease, background .15s ease;
  }
  .ct-peek-toggle:hover { border-color: var(--muted); color: var(--ink); }
  .ct-peek-toggle:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .ct-peek-toggle .pt-icon { width: 14px; height: 14px; display: block; }
  .ct-peek-toggle .pt-track {
    position: relative; width: 22px; height: 12px;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px;
    transition: background .2s ease, border-color .2s ease;
  }
  .ct-peek-toggle .pt-track i {
    position: absolute; top: 1px; left: 1px; width: 8px; height: 8px;
    background: var(--muted); border-radius: 50%;
    transition: transform .25s cubic-bezier(.2,.8,.2,1), background .2s ease;
  }
  .ct-peek-toggle[aria-pressed="true"] { border-color: color-mix(in srgb, var(--gold) 45%, var(--border)); color: var(--gold); background: color-mix(in srgb, var(--gold) 8%, transparent); }
  .ct-peek-toggle[aria-pressed="true"] .pt-track { background: color-mix(in srgb, var(--gold) 25%, var(--surface-2)); border-color: color-mix(in srgb, var(--gold) 60%, var(--border)); }
  .ct-peek-toggle[aria-pressed="true"] .pt-track i { transform: translateX(10px); background: var(--gold); }

  .ct-seg { display: inline-flex; padding: 2px; gap: 2px; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); }
  .ct-seg-btn {
    width: 30px; height: 26px; display: grid; place-items: center;
    background: none; border: 0; border-radius: 7px; color: var(--muted); cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }
  .ct-seg-btn svg { width: 14px; height: 14px; }
  .ct-seg-btn:hover { color: var(--ink); }
  .ct-seg-btn.on { background: color-mix(in srgb, var(--gold) 16%, var(--surface-2)); color: var(--gold); }
  .coll[data-view="grid"] #densityToggle { display: none; }

/* ═════════ QUICK FILTER RAIL ═════════════════════════════ */
  .rail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 0; padding: 4px 0 16px; }
  .rail-group { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 0 22px; border-left: 1px solid var(--border); }
  .rail-group:first-child { padding-left: 0; border-left: 0; }
  .rail-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .rail-items { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }

  .tp {
    display: inline-flex; align-items: center; gap: 7px; padding: 5px 10px 5px 8px;
    border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); color: var(--muted);
    font-family: inherit; font-size: 12px; cursor: pointer;
    transition: color .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .tp .ti { color: var(--c); }
  .tp em { font-style: normal; font-family: Consolas, monospace; font-size: 10px; opacity: .55; }
  .tp:hover { color: var(--ink); border-color: color-mix(in srgb, var(--c) 55%, var(--border)); }
  .tp.on { color: var(--ink); border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, var(--surface)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 14%, transparent); }
  .tp.on em { opacity: 1; color: var(--c); }

  .rail-tiers { gap: 4px; }
  .tt {
    position: relative; width: 30px; height: 30px; display: grid; place-items: center;
    padding: 0; background: none; border: 0; cursor: pointer;
    transition: transform .25s cubic-bezier(.2,.8,.2,1);
  }
  .tt svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--t); opacity: .32; transition: opacity .2s ease, filter .25s ease; }
  .tt span { position: relative; font-weight: 700; font-size: 12px; color: #fff; }
  .tt:hover svg { opacity: .75; }
  .tt.on { transform: translateY(-2px) scale(1.08); }
  .tt.on svg { opacity: 1; filter: drop-shadow(0 0 8px var(--t)); }

  .fl {
    display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px 5px 9px;
    border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); color: var(--muted);
    font-family: inherit; font-size: 12px; cursor: pointer;
    transition: color .2s ease, border-color .2s ease, background .2s ease;
  }
  .fl svg { width: 12px; height: 12px; }
  .fl i { width: 7px; height: 7px; border-radius: 50%; background: #ff9500; box-shadow: 0 0 8px #ff9500; }
  .fl:hover { color: var(--ink); }
  .fl-shiny svg { color: #ffe08a; }
  .fl-shiny.on { color: #ffe08a; border-color: rgba(255,224,138,.55); background: rgba(255,224,138,.09); }
  .fl-wip.on   { color: #ff9500; border-color: color-mix(in srgb, #ff9500 60%, transparent); background: color-mix(in srgb, #ff9500 12%, var(--surface)); }

  .rail-colors .rail-items { gap: 5px; max-width: 520px; }
  .cd {
    width: 18px; height: 18px; border-radius: 50%; padding: 0; cursor: pointer;
    border: 1px solid rgba(255,255,255,.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14);
    transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s ease, opacity .2s ease;
  }
  .cd:hover { transform: scale(1.22); }
  .cd.empty { opacity: .28; }
  .cd.on  { transform: scale(1.18); box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--gold); }
  .cd.exc { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px #00aeff; }

  .rail button:focus-visible, .ct-seg-btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

/* ═════════ 3D MODELS ═════════════════════════════════════ */
  .models-grid { display: none; min-height: 320px; padding-bottom: 8px; }
  .coll[data-view="models"] .models-grid { display: block; }
  .coll[data-view="models"] .table-responsive,
  .coll[data-view="models"] .gallery,
  .coll[data-view="models"] .rail,
  .coll[data-view="models"] .coll-footer,
  .coll[data-view="models"] .ct-chips,
  .coll[data-view="models"] #densityToggle,
  .coll[data-view="models"] #peekToggle,
  .coll[data-view="models"] #clearAll { display: none; }
  .coll[data-view="grid"] #densityToggle,
  .coll[data-view="grid"] #peekToggle { display: none; }
  @media (hover: none) { #peekToggle { display: none; } }

  .model-group { margin-top: 38px; animation: mIn .55s cubic-bezier(.2,.8,.2,1) backwards; }
  .model-group:first-child { margin-top: 20px; }
  .model-group[hidden] { display: none; }
  @keyframes mIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .model-group-head { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; }
  .model-group-head h2 { margin: 0; font-size: 10.5px; font-weight: 700; line-height: 1.4; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .model-group-count { font-family: Consolas, monospace; font-size: 9.5px; letter-spacing: .1em; padding: 2px 7px; border-radius: 999px; color: var(--gold); border: 1px solid color-mix(in srgb, var(--gold) 40%, var(--border)); background: color-mix(in srgb, var(--gold) 8%, transparent); }
  .model-group-head::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), transparent); }

  .model-cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); overflow: hidden; }
  .model-card { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 18px 14px 22px; box-shadow: -1px -1px 0 0 var(--border); }
  .model-card[hidden] { display: none; }
  .model-card::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(70% 55% at 50% 40%, color-mix(in srgb, var(--gold) 10%, transparent), transparent 75%); transition: opacity .45s ease; }
  .model-card:hover::before { opacity: 1; }

  .model-thumb { position: relative; width: 100%; aspect-ratio: 1; }
  .model-thumb .comp-3d { position: absolute; inset: 0; }
  .model-thumb canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; opacity: 0; transform: scale(.94); transition: opacity .6s ease, transform .8s cubic-bezier(.2,.8,.2,1); }
  .model-thumb canvas:active { cursor: grabbing; }
  .model-thumb.is-ready canvas { opacity: 1; transform: none; }
  .model-card:hover .model-thumb.is-ready canvas { transform: scale(1.05); }

  .model-thumb::after { content: ""; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%; background: var(--muted); opacity: .5; pointer-events: none; animation: mPulse 1.4s ease-in-out infinite; }
  .model-thumb.is-ready::after { display: none; }
  @keyframes mPulse { 0%,100% { transform: scale(.6); opacity: .25; } 50% { transform: scale(1.3); opacity: .7; } }

  .model-body { display: flex; flex-direction: column; align-items: center; gap: 3px; text-align: center; min-width: 0; }
  .model-sub   { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .model-count { font-family: Consolas, monospace; font-size: 10.5px; letter-spacing: .04em; color: var(--muted); }
  .model-name { font-size: 14px; font-weight: 600; text-decoration: none; letter-spacing: -.005em; color: var(--ink); transition: color .25s ease; text-transform: capitalize; }
  .model-card:hover .model-name { color: var(--gold); }
  .model-name:hover { text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }

  .model-tools { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: -2px 0 14px; }
  .mt-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .mt-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 8px; text-transform: capitalize; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--muted); font-family: inherit; font-size: 11.5px; cursor: pointer; transition: color .2s ease, border-color .2s ease, background .2s ease; }
  .mt-chip i { width: 7px; height: 7px; border-radius: 50%; background: hsl(var(--hh, 0) 60% 62%); }
  .mt-chip em { font-style: normal; font-family: Consolas, monospace; font-size: 10px; opacity: .55; }
  .mt-chip:hover { color: var(--ink); }
  .mt-chip.on { color: var(--ink); border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
  .mt-sort { display: inline-flex; padding: 2px; gap: 2px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .mt-sort button { padding: 3px 10px; border: 0; border-radius: 6px; background: none; color: var(--muted); font-family: inherit; font-size: 11px; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .mt-sort button.on { background: color-mix(in srgb, var(--gold) 16%, var(--surface-2)); color: var(--gold); }

/* ═════════ TABLE VIEW ════════════════════════════════════ */
  .table-responsive {
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    min-height: 320px; border-radius: 10px;
  }
  @media (min-width: 1300px) { .table-responsive { overflow: clip; } }
  .coll[data-view="grid"] .table-responsive { display: none; }

  .specimen-table {
    width: 100%; min-width: 1200px;
    border-collapse: separate; border-spacing: 0;
    font-size: 15px; table-layout: fixed;
  }
  .specimen-table th, .specimen-table td { text-align: left; padding: 7px 16px; vertical-align: middle; }

  .specimen-table thead th {
    position: sticky; top: 0; z-index: 10;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    font-size: 11px; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--muted);
    padding-top: 11px; padding-bottom: 11px;
  }
  .specimen-table th { background-color: var(--surface); position: relative; white-space: nowrap; }
  .specimen-table thead th:first-child { z-index: 15; box-shadow: inset -1px 0 0 var(--border); border-top-left-radius: 10px; }
  .specimen-table thead th:last-child  { border-top-right-radius: 10px; }

  .specimen-table th:nth-child(1)  { width: 145px; }
  .specimen-table th:nth-child(2)  { width: 90px; }
  .specimen-table th:nth-child(3)  { width: 210px; }
  .specimen-table th:nth-child(4)  { width: 160px; }
  .specimen-table th:nth-child(5)  { width: 165px; }
  /* col 6 (Description) has no width → auto */
  .specimen-table th:nth-child(7)  { width: 80px; }
  .specimen-table th:nth-child(8)  { width: 56px; }
  .specimen-table th:nth-child(9)  { width: 90px; }
  .specimen-table th:nth-child(10) { width: 62px; }
  .specimen-table th:nth-child(11) { width: 88px; }
  .specimen-table th:nth-child(12) { width: 82px; }

  .specimen-table th:nth-child(9) .th-content,
  .specimen-table th:nth-child(10) .th-content,
  .specimen-table th:nth-child(11) .th-content { justify-content: flex-end; }
  .specimen-table th:nth-child(8) .th-content,
  .specimen-table th:nth-child(12) .th-content { justify-content: center; }

  .specimen-table td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .specimen-table a { color: inherit; text-decoration: none; }

  .th-content { display: flex; align-items: center; gap: 6px; }
  .th-label { white-space: nowrap; }

  .filter-toggle { background: none; border: none; cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center; color: var(--muted); transition: color .15s ease; flex-shrink: 0; transform: translateY(1px); }
  .filter-toggle svg { width: 11px; height: auto; display: block; transition: transform .25s ease, color .2s ease; }
  .filter-toggle:hover      { color: var(--ink); }
  .filter-toggle.active svg { transform: rotate(90deg); color: var(--gold); }

/* ═════════ FILTER POPUPS ═════════════════════════════════ */
  .filter-popup {
    display: none; position: absolute; top: 100%; left: 0;
    background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px;
    padding: 12px; margin-top: 6px; min-width: 210px; z-index: 100;
    box-shadow: 0 12px 32px var(--pop-shadow);
    white-space: normal; text-transform: none; letter-spacing: 0; font-weight: 400;
  }
  .filter-popup.open { display: block; animation: popIn .22s cubic-bezier(.2,.8,.2,1); }
  @keyframes popIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

  .specimen-table th:nth-last-child(2) .filter-popup,
  .specimen-table th:last-child     .filter-popup { left: auto; right: 0; }

  .filter-popup input, .filter-popup select {
    font-family: Consolas, monospace; font-size: 12px;
    background: var(--surface-2); color: var(--ink);
    border: 1px solid var(--border); border-radius: 5px;
    padding: 5px 7px; margin: 3px 0; width: 100%;
  }
  .filter-popup input:focus, .filter-popup select:focus  { outline: none; border-color: var(--placeholder); }
  .filter-popup option        { background: var(--surface); color: var(--ink); }
  .filter-popup input::placeholder { color: var(--placeholder); }

  .color-filter-popup { min-width: 228px; }
  .color-swatch-grid  { display: grid; grid-template-columns: repeat(7, 24px); gap: 6px; margin-bottom: 8px; }
  .color-filter-btn { width: 24px; height: 24px; border-radius: 50%; padding: 0; cursor: pointer; border: 1px solid rgba(255, 255, 255, 0.15); transition: transform .15s ease, border-color .15s ease; }
  .color-filter-btn:hover     { transform: scale(.9); }
  .color-filter-btn.active    { border-color: var(--gold); box-shadow: 0 0 0 2px var(--gold-ring); }
  .color-filter-btn.exclusive { border-color: #00aeff; box-shadow: 0 0 0 3px rgba(0, 174, 255, 0.4); }

  .shiny-filter-btn, .wip-filter-btn {
    display: block; width: 100%;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px;
    color: var(--muted); cursor: pointer;
    font-family: Consolas, monospace; font-size: 11px;
    padding: 5px 6px; margin-bottom: 8px; text-align: center;
    transition: background .15s, color .15s, border-color .15s;
  }
  .wip-filter-btn { margin-top: 6px; }
  .shiny-filter-btn:hover, .wip-filter-btn:hover { background: var(--surface-3); color: var(--ink); }
  .shiny-filter-btn.active, .wip-filter-btn.active { border-color: var(--gold); color: var(--gold); background: var(--active-bg); box-shadow: 0 0 8px var(--gold-glow); }

  .type-filter-popup { width: max-content; min-width: 0; }
  .type-filter-list  { position: relative; display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(3, auto); grid-auto-flow: column; column-gap: 28px; row-gap: 8px; }
  .type-filter-list::after { content: ""; position: absolute; top: -12px; bottom: -12px; left: 50%; width: 1px; background: var(--border); transform: translateX(-0.5px); }
  .type-filter-row   { display: flex; align-items: center; gap: 6px; }
  .type-filter-label { font-size: 11px; color: var(--muted); text-align: center; }
  .type-filter-btn { width: 24px; height: 24px; flex-shrink: 0; display: grid; place-items: center; padding: 0; background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; color: var(--ink); cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
  .type-filter-btn:hover { background: var(--surface-3); }
  .type-filter-btn.active { border-color: var(--gold); color: var(--gold); background: var(--active-bg); box-shadow: 0 0 8px var(--gold-glow); }
  .type-filter-btn[data-type-value="Crystal"] { color: #7cafe3; }
  .type-filter-btn[data-type-value="Gem"]     { color: #ff7c80; }
  .type-filter-btn[data-type-value="Rock"]    { color: #9da2ca; }
  .type-filter-btn[data-type-value="Mineral"] { color: #2FA8A0; }
  .type-filter-btn[data-type-value="Geode"]   { color: #E8C547; }
  .type-filter-btn[data-type-value="Fossil"]  { color: #E08B2F; }

  .sort-buttons { display: flex; gap: 6px; margin-top: 6px; }
  .sort-btn { flex: 1; background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; color: var(--muted); cursor: pointer; font-family: Consolas, monospace; font-size: 11px; padding: 4px 6px; text-align: center; transition: background .15s, color .15s, border-color .15s; }
  .sort-btn:hover { background: var(--surface-3); color: var(--ink); }
  .sort-btn.active { border-color: var(--gold); color: var(--gold); background: var(--active-bg); box-shadow: 0 0 8px var(--gold-glow); }

/* ═════════ ROW STATES ═════════════════════════════════════
   The row tint is painted once via the CSS variable --row-tint
   on the <tr> background. The divider is a single ::after
   pseudo-element per row, so hover only changes ONE property
   on ONE element (not 12 td box-shadows). */

  .coll.enter .specimen-table tbody tr {
    animation: rowIn .55s cubic-bezier(.2,.8,.2,1) backwards;
    animation-delay: calc(min(var(--i, 0), 22) * 30ms + 200ms);
  }
  @keyframes rowIn { from { opacity: 0; } to { opacity: 1; } }
  .specimen-table tbody tr {
    background: var(--row-tint, transparent);
  }

  .specimen-table tbody td {
    position: relative;
    box-shadow: inset 0 -1px 0 var(--line);
  }
  .specimen-table tbody tr:hover td {
    box-shadow: inset 0 -1px 0 var(--line-hi);
  }

/* ═════════ CELLS ═════════════════════════════════════════ */
  .specimen-table td.locate-cell {
    background: var(--bg);
    font-family: Consolas, monospace; font-size: 11.5px; letter-spacing: .02em;
    color: var(--muted); padding-left: 18px;
  }

  .locate-dot {
    display: inline-block; width: 6px; height: 6px; border-radius: 50%;
    background: var(--border); margin-right: 10px; vertical-align: middle;
    transition: background .2s ease, box-shadow .2s ease;
  }
  .specimen-table tbody tr:hover .locate-dot { background: var(--c); box-shadow: 0 0 10px var(--c); }
  .locate-txt { vertical-align: middle; }
  .locate-hash { opacity: .5; margin: 0 1px; }

  .specimen-table td.locate-cell.wip { color: var(--ink); }
  .specimen-table td.locate-cell.wip .locate-dot { background: #ff9500; box-shadow: 0 0 8px #ff9500; }

  .specimen-table td.color-cell { padding: 0; overflow: hidden; }
  .specimen-table td.color-cell.shiny { isolation: isolate; }

  .shiny-fx {
    position: absolute; inset: 0; z-index: 2;
    pointer-events: none; overflow: hidden; border-radius: inherit;
    box-shadow: inset 0 .5px 0 rgb(255 255 255 / .55), inset 0 0 0 .5px rgb(255 255 255 / .08);
  }
  .shiny-fx::before {
    content: ""; position: absolute; inset: 0; mix-blend-mode: overlay;
    background: linear-gradient(165deg,
      rgb(255 255 255 / .74) 0%, rgb(255 255 255 / .26) 18%,
      rgb(255 255 255 / .11) 40%, rgb(255 255 255 / .05) 55%,
      rgb(255 255 255 / .17) 82%, rgb(255 255 255 / .41) 100%);
  }
  .shiny-fx::after {
    content: ""; position: absolute; inset: 0; top: -30%; left: -30%; width: 65%; height: 160%;
    background: linear-gradient(45deg, rgba(255,255,255,.08) 0%, transparent 40%, rgba(255,255,255,.03) 60%, transparent 100%);
    filter: blur(2px);
    animation: none;
  }
  .specimen-table tbody tr:hover .shiny-fx::after { animation: glass-drift 7s ease-in-out infinite; }
  @keyframes glass-drift {
    0%   { transform: translateX(0%)   translateY(0%); }
    50%  { transform: translateX(190%) translateY(6%); }
    100% { transform: translateX(0%)   translateY(0%); }
  }

  .specimen-table td.title-cell { font-weight: 500; font-size: 14.5px; }
  .specimen-table td.from-cell,
  .specimen-table td.origin-cell { color: var(--muted); font-size: 12.5px; }
  .specimen-table td.desc-cell { color: var(--muted); font-size: 12.5px; }
  .specimen-table td.date-cell { font-family: Consolas, monospace; font-size: 12.5px; color: var(--muted); }

  .specimen-table td.type-col { padding: 0 16px; text-align: center; color: var(--c); }
  .type-ico { width: 16px; height: 16px; display: inline-block; vertical-align: middle; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .specimen-table tbody tr:hover .type-ico { transform: scale(1.18); }

  .specimen-table td.num-cell { font-family: Consolas, monospace; font-size: 13px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }
  .specimen-table td.num-cell small { font-size: 10px; margin-left: 2px; color: var(--muted); opacity: .7; }
  .specimen-table td.num-cell .dash { color: var(--muted); opacity: .5; }
  .specimen-table td.weight-cell { color: var(--muted); }
  .specimen-table td.price-cell  { color: var(--ink); }

/* ═════════ TIER BADGE ═════════════════════════════════════ */
  .specimen-table td.tier-cell { padding: 0; text-align: center; overflow: visible; }
  .tier-badge { position: relative; display: flex; align-items: center; justify-content: center; height: 100%; min-height: 34px; }
  .tier-shape { position: absolute; top: 0; left: 50%; height: 100%; width: auto; display: block; z-index: 1; transform: translateX(-50%); }
  .tier-path { fill: var(--t); }
  .tier-value { position: relative; z-index: 2; color: #fff; font-weight: 700; font-size: 13px; line-height: 1; }

/* ═════════ TITLE UNDERLINE + SETTLED SHIMMER ══════════════ */

  /* The ::after pseudo-element on the link is the animated underline.
     It is cheap (one 1px line, transform-scaleX) so it stays on hover. */
  .specimen-table tbody tr td a { position: relative; }
  .specimen-table tbody tr td a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px;
    background-image: linear-gradient(100deg,
      var(--shimmer-a) 0%, var(--shimmer-a) 40%, var(--shimmer-b) 50%, var(--shimmer-a) 60%, var(--shimmer-a) 100%);
    background-size: 200% 100%; background-repeat: repeat;
    transform: scaleX(0); transform-origin: left center; pointer-events: none;
  }
  .specimen-table tbody tr:hover td a::after {
    animation: sg-banner-underline-redraw .6s cubic-bezier(.4, 0, .2, 1) forwards;
  }

  /* The expensive text shimmer only fires after 250ms of stable
     hover, added by JS via the .settled class. */
  .specimen-table tbody tr.settled td a {
    background-image: linear-gradient(100deg,
      var(--shimmer-a) 0%, var(--shimmer-a) 40%, var(--shimmer-b) 50%, var(--shimmer-a) 60%, var(--shimmer-a) 100%);
    background-size: 200% 100%; background-repeat: repeat;
    -webkit-background-clip: text; background-clip: text;
    color: transparent !important;
    animation: shimmer 8s infinite;
  }
  .specimen-table tbody tr.settled td a::after {
    animation: sg-banner-underline-redraw .6s cubic-bezier(.4, 0, .2, 1) forwards, shimmer 8s infinite;
  }

  @keyframes sg-banner-underline-redraw {
    0%   { transform: scaleX(1); transform-origin: right center; }
    45%  { transform: scaleX(0); transform-origin: right center; }
    46%  { transform: scaleX(0); transform-origin: left center; }
    100% { transform: scaleX(1); transform-origin: left center; }
  }
  @keyframes shimmer {
    0%   { background-position: -400% 0; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    25%  { background-position: -200% 0; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    35%  { background-position: -200% 0; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    72%  { background-position:    0% 0; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    100% { background-position:    0% 0; }
  }

/* ═════════ COMPACT MODE ═══════════════════════════════════ */
  .specimen-table.compact th, .specimen-table.compact td { padding: 4px 12px; font-size: 11.7px; }
  .specimen-table.compact thead th { padding-top: 8px; padding-bottom: 8px; font-size: 9px; }
  .specimen-table.compact td.title-cell { font-size: 11.7px; }
  .specimen-table.compact td.locate-cell { font-size: 9.9px; padding-left: 14px; }
  .specimen-table.compact td.num-cell { font-size: 10.8px; }
  .specimen-table.compact .type-ico { width: 12.6px; height: 12.6px; }
  .specimen-table.compact td.color-cell, .specimen-table.compact td.tier-cell { padding: 0; }
  .specimen-table.compact .tier-badge { min-height: 27.2px; }
  .specimen-table.compact .tier-value { font-size: 10.4px; }

/* ═════════ GALLERY VIEW ═══════════════════════════════════ */
  .gallery { display: none; grid-template-columns: repeat(auto-fill, minmax(206px, 1fr)); gap: 14px; padding-top: 20px; min-height: 320px; align-content: start; }
  .coll[data-view="grid"] .gallery { display: grid; }

  .g-card {
    display: flex; flex-direction: column; gap: 8px; padding: 8px; min-width: 0;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    text-decoration: none; color: inherit;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .g-card[hidden] { display: none; }
  .g-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--c) 60%, var(--border)); box-shadow: 0 18px 44px -26px color-mix(in srgb, var(--c) 85%, transparent); }
  .g-card:focus-visible { outline: 2px solid var(--c); outline-offset: 3px; }

  .coll.enter .g-card { animation: cardIn .6s cubic-bezier(.2,.8,.2,1) backwards; animation-delay: calc(min(var(--i, 0), 18) * 35ms); }
  @keyframes cardIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .g-thumb { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background: radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--c) 20%, var(--surface-2)), var(--surface-3)); transition: border-color .25s ease; }
  .g-card:hover .g-thumb { border-color: color-mix(in srgb, var(--c) 55%, var(--border)); }
  .g-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .55s cubic-bezier(.2,.8,.2,1); }
  .g-card:hover .g-thumb img { transform: scale(1.06); }

  .g-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--c); opacity: .3; pointer-events: none; }
  .g-fallback .ti { width: 42px; height: 42px; }
  .g-thumb:has(img[style*="display: none"]) .g-fallback { opacity: .6; }

  .g-loc { position: absolute; left: 7px; bottom: 7px; z-index: 2; padding: 3px 8px; border-radius: 999px; font-family: Consolas, monospace; font-size: 10px; letter-spacing: .04em; color: #fff; background: rgba(0,0,0,.5); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.12); }
  .g-flag { position: absolute; top: 7px; z-index: 2; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: rgba(0,0,0,.5); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.12); }
  .g-shiny { right: 7px; color: #ffe08a; }
  .g-shiny svg { width: 12px; height: 12px; }
  .g-wip { right: 33px; }
  .g-wip::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #ff9500; box-shadow: 0 0 8px #ff9500; }

  .g-colors { display: flex; height: 3px; border-radius: 2px; overflow: hidden; background: var(--border); margin: 0 1px; }
  .g-colors i { flex: 1; }

  .g-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; padding: 0 3px 3px; }
  .g-name { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .g-meta { display: flex; align-items: center; gap: 7px; min-width: 0; color: var(--muted); }
  .g-meta .ti { color: var(--c); width: 13px; height: 13px; }
  .g-meta-txt { flex: 1; min-width: 0; font-family: Consolas, monospace; font-size: 10.5px; letter-spacing: .03em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .g-tier { position: relative; width: 20px; height: 20px; display: grid; place-items: center; flex-shrink: 0; }
  .g-tier svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--t); }
  .g-tier em { position: relative; font-style: normal; font-weight: 700; font-size: 10px; color: #fff; }

/* ═════════ HOVER PEEK ═════════════════════════════════════ */
  .peek { position: fixed; top: 0; left: 0; z-index: 200; width: 216px; pointer-events: none; opacity: 0; transition: opacity .16s ease; }
  .peek.on { opacity: 1; will-change: transform; }
  .peek-card { padding: 7px; background: var(--surface); border: 1px solid color-mix(in srgb, var(--c, var(--gold)) 50%, var(--border)); border-radius: 14px; box-shadow: 0 24px 60px -20px rgba(0,0,0,.65), 0 0 40px -14px color-mix(in srgb, var(--c, var(--gold)) 70%, transparent); transform: scale(.94); transform-origin: left center; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .peek.on .peek-card { transform: none; }
  .peek-img { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--c, var(--gold)) 22%, var(--surface-2)), var(--surface-3)); }
  .peek-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .peek.noimg .peek-img img { display: none; }
  .peek-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--c, var(--gold)); opacity: .35; }
  .peek-fallback .ti { width: 46px; height: 46px; }
  .peek-meta { display: flex; flex-direction: column; gap: 2px; padding: 8px 3px 2px; }
  .peek-meta b { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (hover: none), (max-width: 900px) { .peek { display: none; } }

/* ═════════ EMPTY STATE ════════════════════════════════════ */
  .empty-state { display: none; padding: 4rem 1rem 5rem; text-align: center; color: var(--muted); }
  .empty-state:not([hidden]) { display: block; }
  .empty-ico { width: 72px; height: 72px; margin: 0 auto 18px; display: grid; place-items: center; color: var(--muted); opacity: .55; border: 1px dashed var(--border); border-radius: 50%; }
  .empty-ico svg { width: 34px; height: 34px; }
  .empty-state h3 { margin: 0 0 6px; font-size: 18px; color: var(--ink); font-weight: 600; letter-spacing: -.01em; }
  .empty-state p { margin: 0 0 22px; font-size: 13px; }
  .empty-clear-btn { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 9px 16px; font-family: inherit; font-size: 13px; color: var(--ink); cursor: pointer; transition: background .15s ease, border-color .15s ease, color .15s ease; }
  .empty-clear-btn:hover { background: color-mix(in srgb, var(--gold) 14%, var(--surface-2)); border-color: var(--gold); color: var(--gold); }

/* ═════════ FOOTER STATS + MIX ═════════════════════════════ */
  .coll-footer {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 2.2fr) auto;
    margin-top: 20px;
    border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    background: radial-gradient(120% 130% at 0% 0%, color-mix(in srgb, var(--gold) 7%, transparent), transparent 62%), var(--surface);
  }
  .cf-cell { display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; border-right: 1px solid var(--border); justify-content: center; transition: background .25s ease; }
  .cf-cell:last-child { border-right: 0; }
  .cf-cell:hover { background: color-mix(in srgb, var(--gold) 5%, transparent); }
  .cf-num { font-family: Consolas, monospace; font-size: 22px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -.01em; line-height: 1.05; }
  .cf-lbl { font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }

  .cf-mix { gap: 10px; }
  .mix-row { display: grid; grid-template-columns: 56px 1fr; align-items: center; gap: 12px; }
  .mix-lbl { font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .mix { display: flex; height: 6px; border-radius: 3px; overflow: hidden; background: var(--border); gap: 2px; }
  .mix i { flex: 0 1 0; min-width: 0; transition: flex-grow .6s cubic-bezier(.2,.8,.2,1); }

  .cf-back { cursor: pointer; font-family: inherit; text-align: left; background: none; border: 0; border-right: 0; color: inherit; transition: background .25s ease, color .25s ease; }
  .cf-back:hover { background: color-mix(in srgb, var(--gold) 8%, transparent); color: var(--gold); }
  .cf-back:hover .cf-lbl  { color: var(--ink); }
  .cf-back:active         { background: color-mix(in srgb, var(--gold) 14%, transparent); }
  .cf-back:focus-visible  { outline: 2px solid var(--gold); outline-offset: -2px; }
  .cf-back-num { display: flex; align-items: center; color: var(--gold); line-height: 1; }
  .cf-back-num svg { width: 22px; height: 22px; display: block; transition: transform .3s cubic-bezier(.2,.8,.2,1); }
  .cf-back:hover .cf-back-num svg { transform: translateY(-3px); }

/* ═════════ SCROLL GUARD ═══════════════════════════════════ */
  body.is-scrolling .specimen-table tbody tr:hover td a {
    color: inherit !important;
    background-image: none;
    -webkit-background-clip: border-box;
            background-clip: border-box;
    animation: none;
  }
  body.is-scrolling .specimen-table tbody tr:hover td a::after { animation: none; transform: scaleX(0); }
  body.is-scrolling .specimen-table tbody tr:hover .shiny-fx::after { animation: none; }
  body.is-scrolling .specimen-table tbody tr:hover .locate-dot { background: var(--border); box-shadow: none; }
  body.is-scrolling .specimen-table tbody tr:hover .type-ico { transform: none; }
</style>

<script>
  /* ════════════════════════════════════════════════════════
     FPS DEBUG COUNTER  (temporary — remove when done)
     ════════════════════════════════════════════════════════ 
  (function fpsCounter() {
    const el = document.createElement('div');
    el.id = 'fpsDebug';
    el.style.cssText = `
      position: fixed; top: 14px; right: 14px; z-index: 99999;
      padding: 8px 12px; border-radius: 8px;
      background: rgba(0,0,0,.82); color: #ccc;
      font-family: Consolas, monospace; font-size: 11px;
      letter-spacing: .04em; line-height: 1.5;
      pointer-events: none;
      border: 1px solid rgba(255,255,255,.14);
      box-shadow: 0 6px 18px rgba(0,0,0,.45);
      text-align: right; min-width: 130px;
    `;
    document.body.appendChild(el);

    let frames = 0, longFrames = 0, worst = 0;
    let lastSample = performance.now();
    let lastFrame  = performance.now();

    (function tick(now) {
      requestAnimationFrame(tick);
      const delta = now - lastFrame;
      lastFrame = now;

      frames++;
      if (delta > 25) longFrames++;   // >25 ms = one dropped frame at 60 Hz
      if (delta > worst) worst = delta;

      if (now - lastSample >= 1000) {
        const secs = (now - lastSample) / 1000;
        const fps  = Math.round(frames / secs);
        const col  = fps >= 55 ? '#3ddc63' : fps >= 40 ? '#ffd23d' : '#ff5c5c';

        el.innerHTML =
          `<b style="color:${col};font-size:15px;letter-spacing:0">${fps} fps</b>` +
          `<br>worst ${worst.toFixed(1)}ms` +
          `<br>long&nbsp;frames ${longFrames}`;

        frames = 0;
        longFrames = 0;
        worst = 0;
        lastSample = now;
      }
    })(performance.now());
  })(); */
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  if (window.__COLL__) { console.warn('[collection] script ran twice — ignoring duplicate'); return; }
  window.__COLL__ = true;

  try {

  /* ════════════════════════════════════════════════════════
     1. DOM REFERENCES & STATE
     ════════════════════════════════════════════════════════ */

  const coll         = document.getElementById('coll');
  const table        = document.getElementById('specimenTable');
  const tbody        = table.querySelector('tbody');
  const rows         = Array.from(tbody.querySelectorAll('tr'));
  const originalRows = Array.from(rows);
  const gallery      = document.getElementById('gallery');
  const cards        = Array.from(gallery.querySelectorAll('.g-card'));
  const reduced      = matchMedia('(prefers-reduced-motion: reduce)').matches;

  originalRows.forEach((r, i) => {
    r._card = cards[i];
    r._cells = Array.from(r.cells);
    r._searchText = r.textContent.toLowerCase();
    r._habitValues = (r.dataset.habit || '').split(',').map(h => h.trim().toLowerCase()).filter(Boolean);
    const colorCell = r._cells[1];
    colorCell._colors = (colorCell.dataset.colors || '').split('|').filter(Boolean);
    r._cells.forEach(cell => {
      cell._text = cell.textContent.trim();
      cell._textLower = cell._text.toLowerCase();
    });
  });

  const toggles         = table.querySelectorAll('.filter-toggle');
  const popups          = table.querySelectorAll('.filter-popup');
  const sortBtns        = table.querySelectorAll('.sort-btn');
  const textInputs      = table.querySelectorAll('.filter-text');
  const numberInputs    = table.querySelectorAll('.filter-number');
  const colorFilterBtns = table.querySelectorAll('.color-filter-btn');
  const typeFilterBtns  = table.querySelectorAll('.type-filter-btn');

  const shinyFilterBtn = table.querySelector('.shiny-filter-btn');
  const wipFilterBtn   = table.querySelector('.wip-filter-btn');
  const tierPopup      = table.querySelector('.filter-popup[data-col="11"]');
  const backToTopBtn   = document.getElementById('backToTop');

  const globalSearch  = document.getElementById('globalSearch');
  const activeChipsEl = document.getElementById('activeChips');
  const resultCountEl = document.getElementById('resultCount');
  const densityToggle = document.getElementById('densityToggle');
  const clearAllBtn   = document.getElementById('clearAll');
  const emptyClearBtn = document.getElementById('emptyClear');
  const emptyState    = document.getElementById('emptyState');

  const footerCount  = document.getElementById('footerCount');
  const footerPieces = document.getElementById('footerPieces');
  const footerWeight = document.getElementById('footerWeight');
  const footerSpent  = document.getElementById('footerSpent');

  const railTypeBtns  = Array.from(document.querySelectorAll('.rail .tp'));
  const railTierBtns  = Array.from(document.querySelectorAll('.rail .tt'));
  const railColorBtns = Array.from(document.querySelectorAll('.rail .cd'));
  const railShiny     = document.getElementById('railShiny');
  const railWip       = document.getElementById('railWip');
  const viewBtns      = Array.from(document.querySelectorAll('.ct-seg-btn'));
  const modelsGrid    = document.getElementById('modelsGrid');
  const totalCountEl  = document.getElementById('totalCount');
  const specimenTotal = totalCountEl.textContent;
  let modelCards      = Array.from(modelsGrid.querySelectorAll('.model-card'));
  let urlHabitFilter  = null;
  let modelHabit      = '';
  let _scrolling      = false;
  let _scrollGuardTimer = 0;
  let _shimmerRow     = null;
  let _shimmerTimer   = 0;
  const modelGroups   = Array.from(modelsGrid.querySelectorAll('.model-group'));

  function debounce(fn, delay = 150) {
    let timer;
    return function (...args) { clearTimeout(timer); timer = setTimeout(() => fn.apply(this, args), delay); };
  }
  const debouncedApply = debounce(applyAllFilters, 150);

  setTimeout(() => coll.classList.remove('enter'), reduced ? 0 : 1800);


  /* ════════════════════════════════════════════════════════
     2. FILTER POPUP TOGGLES
     ════════════════════════════════════════════════════════ */

  popups.forEach(popup => popup.addEventListener('click', e => e.stopPropagation()));

  toggles.forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      const col    = this.dataset.col;
      const popup  = table.querySelector(`.filter-popup[data-col="${col}"]`);
      const isOpen = popup.classList.contains('open');

      popups.forEach(p => p.classList.remove('open'));
      if (!isOpen) popup.classList.add('open');

      requestAnimationFrame(() => clampPopupToTable(popup));

      toggles.forEach(t => {
        const associated = table.querySelector(`.filter-popup[data-col="${t.dataset.col}"]`);
        t.setAttribute('aria-expanded', associated.classList.contains('open'));
      });
    });
  });

  document.addEventListener('click', function () {
    popups.forEach(p => {
      p.classList.remove('open');
      const t = table.querySelector(`.filter-toggle[data-col="${p.dataset.col}"]`);
      if (t) t.setAttribute('aria-expanded', 'false');
    });
  });

  function clampPopupToTable(popup) {
    popup.style.transform = '';
    const wrap = table.parentElement;
    const wr   = wrap.getBoundingClientRect();
    const pr   = popup.getBoundingClientRect();
    const overflowRight = pr.right - wr.right;
    const overflowLeft  = wr.left  - pr.left;
    if (overflowRight > 0)      popup.style.transform = `translateX(-${overflowRight + 4}px)`;
    else if (overflowLeft > 0)  popup.style.transform = `translateX(${overflowLeft + 4}px)`;
  }


  /* ════════════════════════════════════════════════════════
     3. SORT
     ════════════════════════════════════════════════════════ */

  sortBtns.forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (this.classList.contains('active')) {
        this.classList.remove('active'); this.setAttribute('aria-pressed', 'false'); applyAllFilters(); return;
      }
      sortBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      this.classList.add('active'); this.setAttribute('aria-pressed', 'true'); applyAllFilters();
    });
  });


  /* ════════════════════════════════════════════════════════
     4. FILTER CONTROLS
     ════════════════════════════════════════════════════════ */

  if (globalSearch) globalSearch.addEventListener('input', debouncedApply);

  textInputs.forEach(input => {
    input.addEventListener('input', function () {
      const col    = parseInt(this.closest('.filter-popup').dataset.col);
      const value  = this.value.toLowerCase().trim();
      const toggle = table.querySelector(`.filter-toggle[data-col="${col}"]`);
      toggle.classList.toggle('active', value.length > 0);
      debouncedApply();
    });
  });

  numberInputs.forEach(input => input.addEventListener('input', debouncedApply));
  table.querySelectorAll('.filter-operator').forEach(el => el.addEventListener('change', applyAllFilters));

  colorFilterBtns.forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      const isActive    = this.classList.contains('active');
      const isExclusive = this.classList.contains('exclusive');
      if (!isActive) {
        colorFilterBtns.forEach(b => { b.classList.remove('active', 'exclusive'); b.setAttribute('aria-pressed', 'false'); });
        this.classList.add('active'); this.setAttribute('aria-pressed', 'true');
      } else if (!isExclusive) {
        this.classList.add('exclusive');
      } else {
        this.classList.remove('active', 'exclusive'); this.setAttribute('aria-pressed', 'false');
      }
      applyAllFilters();
    });
  });

  [shinyFilterBtn, wipFilterBtn].forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      this.classList.toggle('active');
      this.setAttribute('aria-pressed', this.classList.contains('active'));
      applyAllFilters();
    });
  });

  typeFilterBtns.forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      const isActive = this.classList.contains('active');
      typeFilterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      if (!isActive) { this.classList.add('active'); this.setAttribute('aria-pressed', 'true'); }
      applyAllFilters();
    });
  });


  /* ════════════════════════════════════════════════════════
     4a. QUICK-FILTER RAIL
     ════════════════════════════════════════════════════════ */

  railTypeBtns.forEach(b => b.addEventListener('click', () => {
    const real = table.querySelector(`.type-filter-btn[data-type-value="${b.dataset.type}"]`);
    if (real) real.click();
  }));

  railTierBtns.forEach(b => b.addEventListener('click', () => {
    const op  = tierPopup.querySelector('.filter-operator');
    const num = tierPopup.querySelector('.filter-number');
    if (op.value === 'eq' && num.value === b.dataset.tier) num.value = '';
    else { op.value = 'eq'; num.value = b.dataset.tier; }
    applyAllFilters();
  }));

  railShiny.addEventListener('click', () => shinyFilterBtn.click());
  railWip.addEventListener('click',   () => wipFilterBtn.click());

  railColorBtns.forEach(b => b.addEventListener('click', () => {
    const real = table.querySelector(`.color-filter-btn[data-color="${b.dataset.color}"]`);
    if (real) real.click();
  }));

  (function () {
    const counts = {};
    rows.forEach(r => {
      (r.querySelector('.color-cell').dataset.colors || '').split('|').filter(Boolean)
        .forEach(h => { counts[h] = (counts[h] || 0) + 1; });
    });
    railColorBtns.forEach(b => {
      const n = counts[b.dataset.color] || 0;
      b.title = b.dataset.name + ' · ' + n;
      if (!n) b.classList.add('empty');
    });
  })();

  function setOn(btn, on) {
    btn.classList.toggle('on', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function syncRails() {
    const activeType = table.querySelector('.type-filter-btn.active');
    railTypeBtns.forEach(b => setOn(b, !!activeType && activeType.dataset.typeValue === b.dataset.type));
    const op = tierPopup.querySelector('.filter-operator').value;
    const tv = parseFloat(tierPopup.querySelector('.filter-number').value);
    railTierBtns.forEach(b => setOn(b, op === 'eq' && tv === parseInt(b.dataset.tier)));
    setOn(railShiny, shinyFilterBtn.classList.contains('active'));
    setOn(railWip,   wipFilterBtn.classList.contains('active'));
    const ac = table.querySelector('.color-filter-btn.active');
    railColorBtns.forEach(b => {
      const on = !!ac && ac.dataset.color === b.dataset.color;
      b.classList.toggle('on', on);
      b.classList.toggle('exc', on && ac.classList.contains('exclusive'));
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }


  /* ════════════════════════════════════════════════════════
     4b. VIEW SWITCH + DENSITY
     ════════════════════════════════════════════════════════ */

  function setView(v, persist = true) {
    coll.dataset.view = v;
    viewBtns.forEach(b => {
      const on = b.dataset.view === v;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    updateCounter();
    if (v === 'grid') syncGallery();
    if (v === 'models') {
      requestAnimationFrame(() => {
        if (typeof window.initModels3D === 'function') window.initModels3D();
        else console.warn('[collection] 3D module not loaded — models view unavailable');
      });
    }
    hidePeek();
    if (persist) try { localStorage.setItem('coll-view', v); } catch (_) {}
  }
  viewBtns.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));

  if (densityToggle) {
    try {
      if (localStorage.getItem('coll-density') === 'compact') {
        table.classList.add('compact');
        densityToggle.classList.add('active');
        densityToggle.setAttribute('aria-pressed', 'true');
      }
    } catch (_) {}
    densityToggle.addEventListener('click', function () {
      const compact = table.classList.toggle('compact');
      this.classList.toggle('active', compact);
      this.setAttribute('aria-pressed', compact ? 'true' : 'false');
      try { localStorage.setItem('coll-density', compact ? 'compact' : 'normal'); } catch (_) {}
    });
  }


  /* ════════════════════════════════════════════════════════
     4c. CLEAR ALL
     ════════════════════════════════════════════════════════ */

  function clearAllFilters() {
    textInputs.forEach(i => { i.value = ''; });
    numberInputs.forEach(i => { i.value = ''; });
    table.querySelectorAll('.filter-operator').forEach(s => { s.value = 'gt'; });
    colorFilterBtns.forEach(b => { b.classList.remove('active', 'exclusive'); b.setAttribute('aria-pressed', 'false'); });
    if (shinyFilterBtn) { shinyFilterBtn.classList.remove('active'); shinyFilterBtn.setAttribute('aria-pressed', 'false'); }
    if (wipFilterBtn)   { wipFilterBtn.classList.remove('active');   wipFilterBtn.setAttribute('aria-pressed', 'false'); }
    typeFilterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
    sortBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
    if (globalSearch) globalSearch.value = '';
    urlHabitFilter = null;
    applyAllFilters();
  }
  if (clearAllBtn)   clearAllBtn.addEventListener('click', clearAllFilters);
  if (emptyClearBtn) emptyClearBtn.addEventListener('click', clearAllFilters);


  /* ════════════════════════════════════════════════════════
     5. BACK TO TOP + KEYBOARD
     ════════════════════════════════════════════════════════ */

  backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  document.addEventListener('keydown', e => {
    const tag = (e.target.tagName || '').toLowerCase();
    const typing = tag === 'input' || tag === 'textarea' || tag === 'select';
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) { e.preventDefault(); globalSearch.focus(); globalSearch.select(); }
    else if (e.key === 'Escape' && e.target === globalSearch) {
      if (globalSearch.value) { globalSearch.value = ''; applyAllFilters(); }
      globalSearch.blur();
    }
  });


  /* ════════════════════════════════════════════════════════
     5.b. COUNTER
     ════════════════════════════════════════════════════════ */
  function updateCounter() {
    let shown, total;
    if (coll.dataset.view === 'models') {
      const q = globalSearch.value.trim().toLowerCase();
      shown = 0;
      modelCards.forEach(c => {
        const hit = (!q || c.dataset.search.includes(q)) && (c._macro || !modelHabit || c.dataset.habitTag === modelHabit);
        c.hidden = !hit;
        if (hit) shown++;
      });
      modelGroups.forEach(g => {
        const n = g.querySelectorAll('.model-card:not([hidden])').length;
        g.hidden = n === 0;
        g.querySelector('.model-group-count').textContent = n;
      });
      total = modelCards.length;
    } else {
      shown = rows.filter(r => r.style.display !== 'none').length;
      total = specimenTotal;
    }
    resultCountEl.textContent = shown;
    totalCountEl.textContent = total;
    emptyState.hidden = shown > 0;
  }

  window.addEventListener('model-missing', e => {
    modelCards = modelCards.filter(c => c !== e.detail);
    e.detail.remove();
    updateCounter();
  });

  modelCards.forEach(c => { c._macro = c.closest('.model-group').dataset.kind === 'macro'; });
  (function () {
    const host = document.getElementById('modelTools');
    if (!host) return;
    const crystals = modelCards.filter(c => !c._macro);
    const counts = {};
    crystals.forEach(c => { const h = c.dataset.habitTag; counts[h] = (counts[h] || 0) + 1; });
    const habits = Object.keys(counts).sort();
    const hue = h => Math.round(habits.indexOf(h) * 137.5) % 360;
    crystals.forEach(c => c.style.setProperty('--hh', hue(c.dataset.habitTag)));
    host.innerHTML =
      '<div class="mt-chips">' +
        '<button type="button" class="mt-chip on" data-h="">All<em>' + crystals.length + '</em></button>' +
        habits.map(h => '<button type="button" class="mt-chip" data-h="' + h + '" style="--hh:' + hue(h) + '"><i></i>' + h + '<em>' + counts[h] + '</em></button>').join('') +
      '</div>' +
      '<div class="mt-sort"><button type="button" class="on" data-s="az">A–Z</button><button type="button" data-s="habit">By habit</button></div>';
    host.addEventListener('click', e => {
      const chip = e.target.closest('.mt-chip');
      const sort = e.target.closest('.mt-sort button');
      if (chip) {
        modelHabit = chip.dataset.h;
        host.querySelectorAll('.mt-chip').forEach(b => b.classList.toggle('on', b === chip));
        updateCounter();
      }
      if (sort) {
        host.querySelectorAll('.mt-sort button').forEach(b => b.classList.toggle('on', b === sort));
        crystals.forEach(c => { c.style.order = ''; });
        if (sort.dataset.s === 'habit') {
          crystals.slice()
            .sort((a, b) => a.dataset.habitTag.localeCompare(b.dataset.habitTag) || a.dataset.name.localeCompare(b.dataset.name))
            .forEach((c, i) => { c.style.order = i; });
        }
      }
    });
  })();


  /* ════════════════════════════════════════════════════════
     6. FILTER + SORT ENGINE
     ════════════════════════════════════════════════════════ */

  function applyAllFilters() {
    const filters = [];
    const globalQuery = globalSearch ? globalSearch.value.trim().toLowerCase() : '';

    textInputs.forEach(input => {
      const col   = parseInt(input.closest('.filter-popup').dataset.col);
      const value = input.value.toLowerCase().trim();
      if (value.length > 0) filters.push({ col, type: 'text', value });
    });

    numberInputs.forEach(input => {
      const popup    = input.closest('.filter-popup');
      const col      = parseInt(popup.dataset.col);
      const numValue = parseFloat(input.value);
      const operator = popup.querySelector('.filter-operator').value;
      if (!isNaN(numValue)) filters.push({ col, type: 'numeric', operator, value: numValue });
    });

    const activeColorBtn = table.querySelector('.color-filter-btn.active');
    if (activeColorBtn) {
      filters.push({ col: 1, type: 'color', value: activeColorBtn.dataset.color, exclusive: activeColorBtn.classList.contains('exclusive') });
    }
    if (shinyFilterBtn.classList.contains('active')) filters.push({ col: 1, type: 'shiny' });
    if (wipFilterBtn.classList.contains('active'))   filters.push({ col: 0, type: 'wip' });

    const activeTypeBtn = table.querySelector('.type-filter-btn.active');
    if (activeTypeBtn) filters.push({ col: 7, type: 'typeCategory', value: activeTypeBtn.dataset.typeValue });

    if (urlHabitFilter) filters.push({ type: 'habit', value: urlHabitFilter });

    rows.forEach(row => {
      const cells = row._cells;
      let show = true;

      if (globalQuery.length > 0 && !row._searchText.includes(globalQuery)) show = false;

      if (show) {
        for (const filter of filters) {
          const cellText = cells[filter.col] ? cells[filter.col]._text : '';
          if (filter.type === 'text') {
            if (filter.col === 0 && /^[sb]\d+$/i.test(filter.value)) {
              const tokens = cells[0]._textLower.split(/\s+/);
              if (!tokens.includes(filter.value)) { show = false; break; }
            } else if (!cells[filter.col]._textLower.includes(filter.value)) {
              show = false; break;
            }
          } else if (filter.type === 'numeric') {
            const rawValue = cells[filter.col].dataset.value;
            const numCell  = rawValue !== undefined ? parseFloat(rawValue) : parseFloat(cellText);
            if (isNaN(numCell)) { show = false; break; }
            if (filter.operator === 'gt' && numCell <= filter.value) { show = false; break; }
            if (filter.operator === 'lt' && numCell >= filter.value) { show = false; break; }
            if (filter.operator === 'eq' && numCell !== filter.value) { show = false; break; }
          } else if (filter.type === 'color') {
            const cellColors = (cells[filter.col]._colors || []);
            if (filter.exclusive) {
              if (!(cellColors.length === 1 && cellColors[0] === filter.value)) { show = false; break; }
            } else if (!cellColors.includes(filter.value)) { show = false; break; }
          } else if (filter.type === 'shiny') {
            if (cells[filter.col].dataset.shiny !== 'true') { show = false; break; }
          } else if (filter.type === 'wip') {
            if (cells[filter.col].dataset.wip !== 'true') { show = false; break; }
          } else if (filter.type === 'typeCategory') {
            if (cells[filter.col].dataset.type !== filter.value) { show = false; break; }
          } else if (filter.type === 'habit') {
            const rowHabits = row._habitValues;
            if (!rowHabits.includes(filter.value.toLowerCase())) { show = false; break; }
          }
        }
      }
      row.style.display = show ? '' : 'none';
      row.classList.remove('settled');
    });

    let sortCol = null, sortDir = null;
    sortBtns.forEach(btn => {
      if (btn.classList.contains('active')) {
        sortCol = parseInt(btn.closest('.filter-popup').dataset.col);
        sortDir = btn.dataset.sort;
      }
    });

    if (sortCol !== null && sortDir !== '') {
      const visibleRows = rows.filter(row => row.style.display !== 'none');
      visibleRows.sort((a, b) => {
        const aCell = a._cells[sortCol];
        const bCell = b._cells[sortCol];
        if (aCell.dataset.value !== undefined && bCell.dataset.value !== undefined) {
          const aVal = parseFloat(aCell.dataset.value);
          const bVal = parseFloat(bCell.dataset.value);
          if (!isNaN(aVal) && !isNaN(bVal)) return sortDir === 'asc' ? aVal - bVal : bVal - aVal;
        }
        const aSortAttr = aCell.dataset.sortValue;
        const bSortAttr = bCell.dataset.sortValue;
        if (aSortAttr !== undefined && bSortAttr !== undefined) {
          const aVal = parseFloat(aSortAttr);
          const bVal = parseFloat(bSortAttr);
          return sortDir === 'asc' ? aVal - bVal : bVal - aVal;
        }
        const aText = aCell.textContent.trim();
        const bText = bCell.textContent.trim();
        const aNum  = parseFloat(aText);
        const bNum  = parseFloat(bText);
        if (!isNaN(aNum) && !isNaN(bNum)) return sortDir === 'asc' ? aNum - bNum : bNum - aNum;
        const aStr = aText.toLowerCase();
        const bStr = bText.toLowerCase();
        if (sortDir === 'asc') return aStr < bStr ? -1 : aStr > bStr ? 1 : 0;
        return aStr < bStr ? 1 : aStr > bStr ? -1 : 0;
      });
      visibleRows.forEach(row => tbody.appendChild(row));
    } else {
      originalRows.forEach(row => tbody.appendChild(row));
    }

    updateCounter();
    if (coll.dataset.view === 'grid') syncGallery();
    updateFooterStats();
    rebuildChips();
    updateToggleHighlights();
    syncRails();
    hidePeek();
  }

  function syncGallery() {
    Array.from(tbody.children).forEach(row => {
      const card = row._card;
      if (!card) return;
      card.hidden = row.style.display === 'none';
      gallery.appendChild(card);
    });
  }


  /* ════════════════════════════════════════════════════════
     6b. FOOTER STATS + LIVE MIX
     ════════════════════════════════════════════════════════ */

  const TYPES      = ['Crystal', 'Gem', 'Rock', 'Mineral', 'Geode', 'Fossil'];
  const TYPE_COLOR = { Crystal: '#7cafe3', Gem: '#ff7c80', Rock: '#9da2ca', Mineral: '#2FA8A0', Geode: '#E8C547', Fossil: '#E08B2F' };
  const TIER_COLOR = { 1: '#ff7c80', 2: '#df8898', 3: '#be95b1', 4: '#9da2ca', 5: '#7cafe3' };

  const mixType = document.getElementById('mixType');
  const mixTier = document.getElementById('mixTier');
  const typeSegs = {}, tierSegs = {};

  TYPES.forEach(k => { const i = document.createElement('i'); i.style.background = TYPE_COLOR[k]; mixType.appendChild(i); typeSegs[k] = i; });
  [1, 2, 3, 4, 5].forEach(k => { const i = document.createElement('i'); i.style.background = TIER_COLOR[k]; mixTier.appendChild(i); tierSegs[k] = i; });

  function tween(el, to, dec, prefix) {
    prefix = prefix || '';
    const from = el._v || 0;
    el._v = to;
    if (reduced || from === to) { el.textContent = prefix + to.toFixed(dec); return; }
    if (el._raf) cancelAnimationFrame(el._raf);
    const t0 = performance.now(), dur = 550;
    (function frame(now) {
      const p = Math.min((now - t0) / dur, 1);
      const k = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
      el.textContent = prefix + (from + (to - from) * k).toFixed(dec);
      if (p < 1) el._raf = requestAnimationFrame(frame);
    })(t0);
  }

  function updateFooterStats() {
    let pieces = 0, weight = 0, spent = 0, count = 0;
    const typeCount = {}, tierCount = {};
    rows.forEach(row => {
      if (row.style.display === 'none') return;
      const cells = row._cells;
      count++;
      pieces += parseFloat(cells[9].dataset.value)  || 0;
      weight += parseFloat(cells[8].dataset.value)  || 0;
      spent  += parseFloat(cells[10].dataset.value) || 0;
      const ty = cells[7].dataset.type, ti = cells[11].dataset.value;
      typeCount[ty] = (typeCount[ty] || 0) + 1;
      tierCount[ti] = (tierCount[ti] || 0) + 1;
    });
    tween(footerCount,  count,  0);
    tween(footerPieces, pieces, 0);
    tween(footerWeight, weight / 1000, 2);
    tween(footerSpent,  spent, spent % 1 === 0 ? 0 : 2, '€');
    TYPES.forEach(k => {
      const n = typeCount[k] || 0;
      typeSegs[k].style.flexGrow = n;
      typeSegs[k].style.display = n > 0 ? '' : 'none';
      typeSegs[k].title = k + ': ' + n;
    });
    [1, 2, 3, 4, 5].forEach(k => {
      const n = tierCount[k] || 0;
      tierSegs[k].style.flexGrow = n;
      tierSegs[k].style.display = n > 0 ? '' : 'none';
      tierSegs[k].title = 'Tier ' + k + ': ' + n;
    });
  }


  /* ════════════════════════════════════════════════════════
     6c. ACTIVE FILTER CHIPS
     ════════════════════════════════════════════════════════ */

  function fieldLabel(col) {
    const th = table.querySelector(`thead th:nth-child(${parseInt(col) + 1}) .th-label`);
    return th ? th.textContent.trim() : 'Field';
  }

  function makeChip(opts) {
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'chip';
    if (opts.swatch) { const sw = document.createElement('span'); sw.className = 'chip-swatch'; sw.style.background = opts.swatch; btn.appendChild(sw); }
    const label = document.createElement('span'); label.className = 'chip-label'; label.textContent = opts.label; btn.appendChild(label);
    const x = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    x.setAttribute('viewBox', '0 0 24 24'); x.setAttribute('fill', 'none'); x.setAttribute('stroke', 'currentColor');
    x.setAttribute('stroke-width', '2.4'); x.setAttribute('stroke-linecap', 'round');
    const xp = document.createElementNS('http://www.w3.org/2000/svg', 'path'); xp.setAttribute('d', 'M18 6 6 18M6 6l12 12');
    x.appendChild(xp); btn.appendChild(x);
    btn.addEventListener('click', () => { opts.clear(); applyAllFilters(); });
    return btn;
  }

  function rebuildChips() {
    if (!activeChipsEl) return;
    activeChipsEl.innerHTML = '';
    const chips = [];
    if (globalSearch && globalSearch.value.trim().length > 0) chips.push({ label: 'Search: ' + globalSearch.value.trim(), clear: () => { globalSearch.value = ''; } });
    textInputs.forEach(input => {
      if (input.value.trim().length > 0) {
        const col = parseInt(input.closest('.filter-popup').dataset.col);
        chips.push({ label: fieldLabel(col) + ': ' + input.value.trim(), clear: () => { input.value = ''; } });
      }
    });
    numberInputs.forEach(input => {
      const val = parseFloat(input.value);
      if (!isNaN(val)) {
        const popup = input.closest('.filter-popup');
        const col   = parseInt(popup.dataset.col);
        const op    = popup.querySelector('.filter-operator').value;
        const sym   = { gt: '>', lt: '<', eq: '=' }[op];
        chips.push({ label: fieldLabel(col) + ' ' + sym + ' ' + val, clear: () => { input.value = ''; } });
      }
    });
    const activeColor = table.querySelector('.color-filter-btn.active');
    if (activeColor) {
      const hex = activeColor.dataset.color;
      const exc = activeColor.classList.contains('exclusive');
      const nm  = (document.querySelector(`.rail .cd[data-color="${hex}"]`) || {}).dataset;
      chips.push({ swatch: hex, label: (exc ? 'Only ' : 'Color ') + (nm && nm.name ? nm.name : hex), clear: () => activeColor.classList.remove('active', 'exclusive') });
    }
    if (shinyFilterBtn.classList.contains('active')) chips.push({ label: 'Shiny', clear: () => shinyFilterBtn.classList.remove('active') });
    if (wipFilterBtn.classList.contains('active'))   chips.push({ label: 'Work in progress', clear: () => wipFilterBtn.classList.remove('active') });
    const activeType = table.querySelector('.type-filter-btn.active');
    if (activeType) chips.push({ label: 'Type: ' + activeType.dataset.typeValue, clear: () => activeType.classList.remove('active') });
    if (urlHabitFilter) chips.push({ label: 'Habit: ' + urlHabitFilter, clear: () => { urlHabitFilter = null; } });
    const activeSort = table.querySelector('.sort-btn.active');
    if (activeSort) {
      const col = activeSort.closest('.filter-popup').dataset.col;
      const dir = activeSort.dataset.sort;
      chips.push({ label: fieldLabel(col) + ' ' + (dir === 'asc' ? '↑' : '↓'), clear: () => activeSort.classList.remove('active') });
    }
    if (chips.length === 0) { activeChipsEl.hidden = true; return; }
    activeChipsEl.hidden = false;
    chips.forEach(c => activeChipsEl.appendChild(makeChip(c)));
  }


  /* ════════════════════════════════════════════════════════
     7. TOGGLE HIGHLIGHT SYNC
     ════════════════════════════════════════════════════════ */

  function updateToggleHighlights() {
    toggles.forEach(t => t.classList.remove('active'));
    textInputs.forEach(input => {
      const col    = parseInt(input.closest('.filter-popup').dataset.col);
      const toggle = table.querySelector(`.filter-toggle[data-col="${col}"]`);
      if (input.value.trim().length > 0) toggle.classList.add('active');
    });
    numberInputs.forEach(input => {
      const col    = parseInt(input.closest('.filter-popup').dataset.col);
      const toggle = table.querySelector(`.filter-toggle[data-col="${col}"]`);
      if (!isNaN(parseFloat(input.value))) toggle.classList.add('active');
    });
    const activeColorBtn = table.querySelector('.color-filter-btn.active');
    const colorToggle    = table.querySelector('.filter-toggle[data-col="1"]');
    if (activeColorBtn || shinyFilterBtn.classList.contains('active')) colorToggle.classList.add('active');
    if (table.querySelector('.type-filter-btn.active')) table.querySelector('.filter-toggle[data-col="7"]').classList.add('active');
    if (wipFilterBtn.classList.contains('active'))      table.querySelector('.filter-toggle[data-col="0"]').classList.add('active');
    sortBtns.forEach(btn => {
      if (btn.classList.contains('active')) {
        const col = parseInt(btn.closest('.filter-popup').dataset.col);
        table.querySelector(`.filter-toggle[data-col="${col}"]`).classList.add('active');
      }
    });
  }


  /* ════════════════════════════════════════════════════════
     8. SCROLL GUARD
     ════════════════════════════════════════════════════════ */

  window.addEventListener('scroll', () => {
    _scrolling = true;
    document.body.classList.add('is-scrolling');
    clearTimeout(_scrollGuardTimer);
    _scrollGuardTimer = setTimeout(() => {
      _scrolling = false;
      document.body.classList.remove('is-scrolling');
    }, 140);
  }, { passive: true });


  /* ════════════════════════════════════════════════════════
     8a. SHIMMER SETTLE
     Adds .settled to a row only after the pointer has been
     on it for 250ms without moving to another row. This is
     what fires the expensive background-clip:text shimmer.
     ════════════════════════════════════════════════════════ */

  tbody.addEventListener('pointerover', e => {
    if (e.pointerType !== 'mouse') return;
    const row = e.target.closest('tr');
    if (!row || row === _shimmerRow) return;
    if (_shimmerRow) _shimmerRow.classList.remove('settled');
    _shimmerRow = row;
    clearTimeout(_shimmerTimer);
    _shimmerTimer = setTimeout(() => row.classList.add('settled'), 250);
  });
  tbody.addEventListener('pointerleave', () => {
    clearTimeout(_shimmerTimer);
    if (_shimmerRow) _shimmerRow.classList.remove('settled');
    _shimmerRow = null;
  });


  /* ════════════════════════════════════════════════════════
     8b. HOVER PEEK
     Trigger: pointerover (fires once per row transition).
     Position: pointermove on document, guarded by peekRow
     so that when the peek is off OR no row is hovered the
     handler returns in a couple of ns.
     ════════════════════════════════════════════════════════ */

  const peek = document.getElementById('peek');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  let peekRow = null, peekRaf = 0;
  let peekEnabled = true;
  try { peekEnabled = localStorage.getItem('coll-peek') !== 'off'; } catch (_) {}

  function hidePeek() {
    peekRow = null;
    if (peekRaf) { cancelAnimationFrame(peekRaf); peekRaf = 0; }
    if (peek) peek.classList.remove('on');
  }

  const peekToggle = document.getElementById('peekToggle');
  function syncPeekToggle() {
    if (!peekToggle) return;
    peekToggle.setAttribute('aria-pressed', peekEnabled ? 'true' : 'false');
    peekToggle.title = peekEnabled ? 'Hover preview: on' : 'Hover preview: off';
  }
  syncPeekToggle();

  function setPeekEnabled(on) {
    peekEnabled = !!on;
    syncPeekToggle();
    if (!peekEnabled) hidePeek();
    try { localStorage.setItem('coll-peek', peekEnabled ? 'on' : 'off'); } catch (_) {}
  }
  if (peekToggle) peekToggle.addEventListener('click', () => setPeekEnabled(!peekEnabled));

  if (peek && canHover) {
    const pImg  = peek.querySelector('img');
    const pName = peek.querySelector('.peek-meta b');

    pImg.addEventListener('error', () => peek.classList.add('noimg'));
    pImg.addEventListener('load',  () => peek.classList.remove('noimg'));

    let peekW = 0, peekH = 0;
    let px = 0, py = 0;

    function place() {
      peekRaf = 0;
      if (!peekW) { peekW = peek.offsetWidth; peekH = peek.offsetHeight; }
      let x = px + 24;
      if (x + peekW > window.innerWidth - 12) x = px - 24 - peekW;
      const y = Math.max(12, Math.min(window.innerHeight - peekH - 12, py - peekH / 2));
      peek.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    }

    function showPeek(row) {
      peekRow = row;
      peek.style.setProperty('--c', TYPE_COLOR[row.dataset.type] || '');
      peek.classList.remove('noimg');
      if (pImg.getAttribute('src') !== row.dataset.img) pImg.src = row.dataset.img;
      pName.textContent = row.querySelector('.title-cell a').textContent;
      peek.classList.add('on');
      if (!peekRaf) peekRaf = requestAnimationFrame(place);
    }

    /* Trigger: fires only when the pointer crosses into a new
       row. Cheap even on rapid scrubbing — one call per row. */
    tbody.addEventListener('pointerover', e => {
      if (e.pointerType !== 'mouse') return;
      if (!peekEnabled || _scrolling) return;
      const row = e.target.closest('tr');
      if (!row || row === peekRow) return;
      showPeek(row);
    });

    /* Position: fires constantly, but guards out immediately
       when the peek isn't showing or the tab isn't active. */
    document.addEventListener('pointermove', e => {
      if (e.pointerType !== 'mouse' || !peekRow || !peekEnabled || _scrolling) return;
      px = e.clientX; py = e.clientY;
      if (!peekRaf) peekRaf = requestAnimationFrame(place);
    });

    tbody.addEventListener('pointerleave', hidePeek);
    window.addEventListener('scroll', hidePeek, { passive: true });

    /* Preload all peek thumbnails during idle time to eliminate
       the 10–50 ms first-hover image decode hitch that was
       contributing to the stutter on rapid scrubbing. */
    (function preloadThumbs() {
      const urls = new Set();
      rows.forEach(r => { const s = r.dataset.img; if (s) urls.add(s); });
      const list = Array.from(urls);
      let i = 0;
      const load = () => {
        const end = Math.min(i + 4, list.length);
        for (; i < end; i++) { const img = new Image(); img.decoding = 'async'; img.src = list[i]; }
        if (i < list.length) {
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
          else setTimeout(load, 200);
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 });
      else setTimeout(load, 500);
    })();
  }


  /* ════════════════════════════════════════════════════════
     9. URL PARAMS
     ════════════════════════════════════════════════════════ */

  try {
    (function applyUrlParams() {
      const q = new URLSearchParams(location.search);
      if (![...q.keys()].length) return;
      const press = btn => { btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true'); };
      const color = q.get('color');
      if (color) { const btn = table.querySelector(`.color-filter-btn[data-color="${color}"]`); if (btn) press(btn); }
      if (q.get('shiny') === '1') press(shinyFilterBtn);
      if (q.get('wip')   === '1') press(wipFilterBtn);
      const type = q.get('type');
      if (type) typeFilterBtns.forEach(b => { if (b.dataset.typeValue === type) press(b); });
      const tier = q.get('tier');
      if (tier) { tierPopup.querySelector('.filter-operator').value = 'eq'; tierPopup.querySelector('.filter-number').value = tier; }
      const year = q.get('year');
      if (year) {
        const datePopup = table.querySelector('.filter-popup[data-col="6"]');
        datePopup.querySelector('.filter-operator').value = 'eq';
        datePopup.querySelector('.filter-number').value = year;
      }
      const sort = q.get('sort');
      if (sort) {
        const [col, dir] = sort.split(':');
        const btn = table.querySelector(`.filter-popup[data-col="${col}"] .sort-btn[data-sort="${dir}"]`);
        if (btn) press(btn);
      }
      const habit = q.get('habit');
      if (habit) urlHabitFilter = habit;
      const locate = q.get('locate');
      if (locate) {
        const locateInput = table.querySelector('.filter-popup[data-col="0"] .filter-text');
        if (locateInput) locateInput.value = locate;
      }
      applyAllFilters();
    })();
  } catch (e) { console.error('[collection] URL params failed:', e); }


  /* ════════════════════════════════════════════════════════
     INIT
     ════════════════════════════════════════════════════════ */

  try {
    const params  = new URLSearchParams(location.search);
    const urlView = params.get('view');
    if (urlView === 'table' || urlView === 'grid' || urlView === 'models') {
      setView(urlView, false);
    } else {
      const hasFilter = ['habit','type','tier','color','shiny','wip','year','sort','locate'].some(k => params.has(k));
      if (hasFilter) setView('table', false);
      else {
        const saved = localStorage.getItem('coll-view');
        if (saved === 'grid' || saved === 'models') setView(saved, false);
      }
    }
  } catch (_) {}

  updateToggleHighlights();
  updateFooterStats();
  syncRails();
  if (resultCountEl && (!resultCountEl.textContent.trim() || resultCountEl.textContent === '0')) {
    resultCountEl.textContent = rows.filter(r => r.style.display !== 'none').length;
  }

  } catch (err) {
    console.error('[collection] fatal:', err);
  } finally {
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.documentElement.classList.remove('coll-boot');
    }));
  }
});
</script>
<script type="module">
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { STLLoader } from 'three/addons/loaders/STLLoader.js';

  const coll    = document.getElementById('coll');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let SIZE = 440;

  let renderer = null;
  function getRenderer() {
    if (!renderer) {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(1);
      renderer.setSize(SIZE, SIZE, false);
      renderer.setClearColor(0x000000, 0);
    }
    return renderer;
  }

  const PEARL = 0xfff8ec;
  const fillMat = new THREE.MeshStandardMaterial({
    color: PEARL, transparent: true, opacity: 0.55, roughness: 0.22, metalness: 0.05,
    emissive: PEARL, emissiveIntensity: 0.2,
    side: THREE.DoubleSide, depthWrite: true, flatShading: true,
    polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1
  });
  const solidMat = new THREE.MeshStandardMaterial({
    color: PEARL, roughness: 0.18, metalness: 0.05,
    emissive: PEARL, emissiveIntensity: 0.2,
    side: THREE.DoubleSide, flatShading: true,
    polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1
  });
  const LIGHT_HABITS = new Set(['aciculare','botroidale','geodico','lamellare','fibroso','dendritico','massiccio']);
  const habitName = u => (u || '').split('/').pop().split('?')[0].replace(/\.stl$/i, '').toLowerCase();
  const isHabit   = u => LIGHT_HABITS.has(habitName(u));
  const INK_TARGET = 26;
  const LIGHTNESS  = 0.75;
  function makeEdges(geometry, url) {
    const name = (url || '').split('/').pop().split('?')[0].replace(/\.stl$/i, '').toLowerCase();
    const light = LIGHT_HABITS.has(name);
    const lines = new THREE.EdgesGeometry(geometry, light ? 20 : 1);
    let opacity = 1;
    if (light) {
      const p = lines.attributes.position;
      let len = 0;
      for (let i = 0; i < p.count; i += 2) {
        len += Math.hypot(p.getX(i) - p.getX(i + 1), p.getY(i) - p.getY(i + 1), p.getZ(i) - p.getZ(i + 1));
      }
      geometry.computeBoundingSphere();
      const ink = len / (geometry.boundingSphere.radius || 1);
      opacity = Math.min(1, Math.max(0.08, Math.pow(INK_TARGET / Math.max(ink, 1e-6), LIGHTNESS)));
    }
    const mat = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity, depthWrite: false, depthTest: true });
    return new THREE.LineSegments(lines, mat);
  }

  const loader = new STLLoader();
  const tiles  = [];

  let _scrollUntil = 0;
  window.addEventListener('scroll', () => { _scrollUntil = performance.now() + 120; }, { passive: true });

  function buildScene(tile, geometry) {
    geometry.computeVertexNormals();
    geometry.center();
    geometry.computeBoundingSphere();
    const k = 1.8 / (geometry.boundingSphere.radius || 1);
    geometry.scale(k, k, k);

    const scene = new THREE.Scene();
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dir = new THREE.DirectionalLight(0xffffff, 1.5);
    dir.position.set(5, 5, 5);
    scene.add(dir);

    const isMacro = isHabit(tile.el.dataset.model);
    const baseMat = isMacro ? solidMat : fillMat;
    const mat = baseMat.clone();
    mat.userData = { baseEmissive: mat.emissiveIntensity, baseOpacity: mat.opacity, isTransparent: mat.transparent };

    const mesh = new THREE.Mesh(geometry, mat);
    mesh.renderOrder = 0;
    scene.add(mesh);

    const edges = makeEdges(geometry, tile.el.dataset.model);
    edges.renderOrder = 1;
    scene.add(edges);

    tile.fillMat = mat;

    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    camera.position.set(0, 1.6, 6.8);
    camera.position.applyAxisAngle(new THREE.Vector3(0, 1, 0), 0.6);

    const controls = new OrbitControls(camera, tile.canvas);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.autoRotate = !reduced;
    controls.autoRotateSpeed = 1.2;
    controls.addEventListener('change', () => { tile.needs = true; });
    tile.canvas.style.touchAction = 'pan-y';

    tile.el.addEventListener('pointerenter', () => {
      controls.autoRotateSpeed = 4;
      if (tile.fillMat) {
        tile.fillMat.emissiveIntensity = Math.min(0.7, tile.fillMat.userData.baseEmissive + 0.4);
        tile.fillMat.opacity = Math.min(0.95, tile.fillMat.userData.baseOpacity + 0.1);
        tile.needs = true;
      }
    });
    tile.el.addEventListener('pointerleave', () => {
      controls.autoRotateSpeed = 1.2;
      if (tile.fillMat) {
        tile.fillMat.emissiveIntensity = tile.fillMat.userData.baseEmissive;
        tile.fillMat.opacity = tile.fillMat.userData.baseOpacity;
        tile.needs = true;
      }
    });

    Object.assign(tile, { scene, camera, controls, needs: true });
    tile.el.parentElement.classList.add('is-ready');
  }

  function loadTile(tile) {
    if (tile.loading) return;
    tile.loading = true;
    loader.load(tile.el.dataset.model,
      g => buildScene(tile, g),
      undefined,
      () => {
        io.unobserve(tile.el);
        window.dispatchEvent(new CustomEvent('model-missing', { detail: tile.el.closest('.model-card') }));
      });
  }

  const io = new IntersectionObserver(entries => {
    entries.forEach(en => {
      const tile = en.target._tile;
      tile.visible = en.isIntersecting;
      if (tile.visible) loadTile(tile);
    });
  }, { rootMargin: '200px' });

  let _rendererFailed = false;

  function frame(now) {
    requestAnimationFrame(frame);
    if (coll.dataset.view !== 'models' || document.hidden) return;
    if (now < _scrollUntil) return;
    if (_rendererFailed) return;
    let r;
    try { r = getRenderer(); }
    catch (e) { _rendererFailed = true; console.error('[collection] WebGL unavailable, models view disabled:', e); return; }
    for (const t of tiles) {
      if (!t.visible || !t.scene) continue;
      if (reduced && !t.needs) continue;
      t.needs = false;
      t.controls.update();
      r.render(t.scene, t.camera);
      t.ctx.clearRect(0, 0, SIZE, SIZE);
      t.ctx.drawImage(r.domElement, 0, 0);
    }
  }

  window.initModels3D = function () {
    if (coll.dataset.modelsInit === 'true') return;
    coll.dataset.modelsInit = 'true';
    const first = document.querySelector('.models-grid .model-thumb');
    const w = Math.max(first ? first.clientWidth : 0, 260);
    SIZE = Math.min(512, Math.round(w * (window.devicePixelRatio || 1)));
    document.querySelectorAll('.models-grid .comp-3d').forEach(el => {
      const canvas = document.createElement('canvas');
      canvas.width = canvas.height = SIZE;
      el.appendChild(canvas);
      const tile = { el, canvas, ctx: canvas.getContext('2d'), visible: false, loading: false, scene: null };
      el._tile = tile;
      tiles.push(tile);
      io.observe(el);
    });
    requestAnimationFrame(frame);
  };
</script>