---
layout: layouts/base.liquid
title: Collection
permalink: /collection/
---

<script>document.documentElement.classList.add('coll-boot');</script>
<style>
  html.coll-boot .coll-toolbar,
  html.coll-boot .rail,
  html.coll-boot .table-responsive,
  html.coll-boot .coll-footer { opacity: 0; }
  html.coll-boot .table-responsive { overflow: hidden; }
  html.coll-boot::-webkit-scrollbar-thumb,
  html.coll-boot::-webkit-scrollbar-track { background: transparent; }
</style>

{% comment %} Palette (hue-wheel order) — hexes + readable names, same order {% endcomment %}
{% assign palette_hexes = "#F5F0E6|#8A8A8A|#525252|#1A1A1A|#D9C7A3|#7B5233|#4A3728|#531A13|#C0392B|#E08B2F|#C9A227|#E8C547|#4C9A5B|#1F5C33|#2FA8A0|#3468C0|#1B3A8C|#402B52|#7B4FA0|#E8A0BF" | split: "|" %}
{% assign palette_names = "Cream|Gray|Charcoal|Black|Sand|Brown|Umber|Maroon|Red|Orange|Gold|Yellow|Green|Forest|Teal|Blue|Navy|Plum|Purple|Pink" | split: "|" %}
{% assign types = "Crystal|Gem|Rock|Mineral|Geode|Fossil" | split: "|" %}


<!-- ═════════ ICON SPRITE ═════════════════════════════════ -->
<svg class="ti-sprite" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="ti-Crystal" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M5 7 L12 11 L19 7 M12 11 V22"/>
  </symbol>
  <symbol id="ti-Gem" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M7 4 L17 4 L21 10 L12 22 L3 10 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M3 10 H21 M7 4 L10 10 L12 22 M17 4 L14 10 L12 22"/>
  </symbol>
  <symbol id="ti-Rock" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M3 16 L4 8 L10 4 L17 5 L21 11 L19 18 L11 20 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M4 8 L11 12 L21 11 M11 12 V20 M11 12 L17 5"/>
  </symbol>
  <symbol id="ti-Mineral" viewBox="0 0 24 24">
    <path fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M6 4 L12 8 V21 L3 17 V7 Z"/>
    <path fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M13 6 L20 9 L21 18 L14 20 Z"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M6 4 L12 8 M3 17 L12 21 M13 6 L20 9 M14 20 L21 18"/>
  </symbol>
  <symbol id="ti-Geode" viewBox="0 0 24 24">
    <circle fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.6" cx="12" cy="12" r="10"/>
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" opacity=".8" d="M6 12 L8 10 L9.5 12 L11 9.5 L12.5 11.5 L14 9 L15.5 11 L17 10 L18 12 L17 14 L15 13.5 L14 16 L12.5 14 L11 16 L9.5 14 L8 15 L6.5 13.5 Z"/>
  </symbol>
  <symbol id="ti-Fossil" viewBox="0 0 24 24">
    <path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" d="M12 12 C12 10 13.5 9 15 9 C17.5 9 19 11 19 13 C19 16 16 19 13 19 C9 19 5 16 5 12 C5 6 11 4 17 6"/>
  </symbol>
  <symbol id="tier-blob" viewBox="0 0 100 100">
    <path d="M49.9981 0H50C69 0 100 0.00416183 100 50.0002C100 99.9963 69 100.002 50 100.002C31 100.002 0 100.002 0 50.0002C0 0 30.9979 0 49.9981 0Z"/>
  </symbol>
</svg>


<!-- ═════════ PAGE WRAPPER ══════════════════════════════════ -->
<div class="coll enter" id="coll" data-view="table">

  <!-- ═══════ COMMAND BAR ═══════════════════════════════════ -->
  <div class="coll-toolbar">

    <label class="ct-search">
      <svg class="ct-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="globalSearch" placeholder="Search the collection…" autocomplete="off" spellcheck="false">
      <kbd class="ct-kbd" aria-hidden="true">/</kbd>
    </label>

    <div class="ct-chips" id="activeChips" aria-live="polite" hidden></div>

    <div class="ct-meta">
      <span class="ct-count" title="Visible / total specimens">
        <b id="resultCount">0</b><span class="ct-sep">/</span><span class="ct-total" id="totalCount">{{ specimens.size }}</span>
      </span>

      <div class="ct-seg" role="group" aria-label="View">
        <button class="ct-seg-btn on" type="button" data-view="table" aria-pressed="true" title="Table view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16"/></svg>
        </button>
        <button class="ct-seg-btn" type="button" data-view="grid" aria-pressed="false" title="Gallery view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><rect x="14" y="14" width="7" height="7" rx="1.4"/></svg>
        </button>
        <button class="ct-seg-btn" type="button" data-view="models" aria-pressed="false" title="3D Models view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/></svg>
        </button>
      </div>

      <button class="ct-icon-btn" id="densityToggle" type="button" title="Toggle row density" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button class="ct-peek-toggle" id="peekToggle" type="button"
              title="Hover preview: on" aria-pressed="true">
        <svg class="pt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span class="pt-track" aria-hidden="true"><i></i></span>
      </button>
      <button class="ct-icon-btn ct-clear" id="clearAll" type="button" title="Clear all filters">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- ═══════ QUICK FILTER RAIL ═════════════════════════════ -->
  <div class="rail">

    <div class="rail-group">
      <span class="rail-label">Type</span>
      <div class="rail-items">
        {% for ty in types %}
          {% assign n = specimens | where: "type", ty | size %}
          <button class="tp" type="button" data-type="{{ ty }}" aria-pressed="false">
            <svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ ty }}"/></svg>
            <span>{{ ty }}</span><em>{{ n }}</em>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="rail-group">
      <span class="rail-label">Tier</span>
      <div class="rail-items rail-tiers">
        {% for t in (1..5) %}
          <button class="tt" type="button" data-tier="{{ t }}" aria-pressed="false" aria-label="Tier {{ t }}" title="Tier {{ t }}">
            <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#tier-blob"/></svg>
            <span>{{ t }}</span>
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="rail-group">
      <span class="rail-label">Flags</span>
      <div class="rail-items">
        <button class="fl fl-shiny" type="button" id="railShiny" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L13.6 8.4 L20 10 L13.6 11.6 L12 18 L10.4 11.6 L4 10 L10.4 8.4 Z" fill="currentColor"/></svg>
          Shiny
        </button>
        <button class="fl fl-wip" type="button" id="railWip" aria-pressed="false">
          <i></i>In progress
        </button>
      </div>
    </div>

    <div class="rail-group rail-colors">
      <span class="rail-label">Color</span>
      <div class="rail-items">
        {% for hex in palette_hexes %}
          <button class="cd" type="button" data-color="{{ hex }}" data-name="{{ palette_names[forloop.index0] }}" style="background: {{ hex }};" aria-pressed="false" aria-label="{{ palette_names[forloop.index0] }}"></button>
        {% endfor %}
      </div>
    </div>
  </div>


  <!-- ═══════ TABLE VIEW ════════════════════════════════════ -->
  <div class="table-responsive">
    <table class="specimen-table" id="specimenTable">
      <thead>
        <tr>
          <th>
            <div class="th-content">
              <span class="th-label">Locate</span>
              <button class="filter-toggle" data-col="0" data-type="text" aria-expanded="false" aria-label="Filter Locate column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="0">
              <input type="text" class="filter-text" placeholder="e.g. S1, B7, #13...">
              <button class="wip-filter-btn" type="button" aria-pressed="false">WIP</button>
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Color</span>
              <button class="filter-toggle" data-col="1" data-type="color" aria-expanded="false" aria-label="Filter Color column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup color-filter-popup" data-col="1">
              <div class="color-swatch-grid">
                {% for hex in palette_hexes %}
                  <button class="color-filter-btn" data-color="{{ hex }}" style="background: {{ hex }};" aria-label="Filter by this color" aria-pressed="false"></button>
                {% endfor %}
              </div>
              <button class="shiny-filter-btn" type="button" aria-pressed="false">Shiny</button>
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Top → Bottom</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Bottom → Top</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Title</span>
              <button class="filter-toggle" data-col="2" data-type="text" aria-expanded="false" aria-label="Filter Title column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="2">
              <input type="text" class="filter-text" placeholder="Filter title...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">From</span>
              <button class="filter-toggle" data-col="3" data-type="text" aria-expanded="false" aria-label="Filter From column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="3">
              <input type="text" class="filter-text" placeholder="Filter from...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Origin</span>
              <button class="filter-toggle" data-col="4" data-type="text" aria-expanded="false" aria-label="Filter Origin column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="4">
              <input type="text" class="filter-text" placeholder="Filter origin...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Description</span>
              <button class="filter-toggle" data-col="5" data-type="text" aria-expanded="false" aria-label="Filter Description column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="5">
              <input type="text" class="filter-text" placeholder="Filter description...">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">A → Z</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">Z → A</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Date</span>
              <button class="filter-toggle" data-col="6" data-type="value" aria-expanded="false" aria-label="Filter Date column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="6">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Year" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Old → New</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">New → Old</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">T</span>
              <button class="filter-toggle" data-col="7" data-type="type" aria-expanded="false" aria-label="Filter Type column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup type-filter-popup" data-col="7">
              <div class="type-filter-list">
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Crystal" aria-pressed="false" aria-label="Crystal"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Crystal"/></svg></button><span class="type-filter-label">Crystal</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Gem"     aria-pressed="false" aria-label="Gem"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Gem"/></svg></button><span class="type-filter-label">Gem</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Rock"    aria-pressed="false" aria-label="Rock"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Rock"/></svg></button><span class="type-filter-label">Rock</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Mineral" aria-pressed="false" aria-label="Mineral"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Mineral"/></svg></button><span class="type-filter-label">Mineral</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Geode"   aria-pressed="false" aria-label="Geode"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Geode"/></svg></button><span class="type-filter-label">Geode</span></div>
                <div class="type-filter-row"><button class="type-filter-btn" data-type-value="Fossil"  aria-pressed="false" aria-label="Fossil"><svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-Fossil"/></svg></button><span class="type-filter-label">Fossil</span></div>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Weight</span>
              <button class="filter-toggle" data-col="8" data-type="value" aria-expanded="false" aria-label="Filter Weight column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="8">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="0.1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Qty</span>
              <button class="filter-toggle" data-col="9" data-type="value" aria-expanded="false" aria-label="Filter Qty column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="9">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Price</span>
              <button class="filter-toggle" data-col="10" data-type="value" aria-expanded="false" aria-label="Filter Price column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="10">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="0.01">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>

          <th>
            <div class="th-content">
              <span class="th-label">Tier</span>
              <button class="filter-toggle" data-col="11" data-type="value" aria-expanded="false" aria-label="Filter Tier column"><svg viewBox="0 0 117 115" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 10.5135V104.041C8.5 105.528 10.0646 106.495 11.3944 105.83L108.5 57.2775L11.3944 8.72469C10.0646 8.05979 8.5 9.02678 8.5 10.5135Z" stroke="currentColor" stroke-width="17" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="filter-popup" data-col="11">
              <select class="filter-operator">
                <option value="gt">Greater than</option>
                <option value="lt">Less than</option>
                <option value="eq">Equal to</option>
              </select>
              <input type="number" class="filter-number" placeholder="Value" step="1">
              <div class="sort-buttons">
                <button class="sort-btn" data-sort="asc" aria-pressed="false">Low → High</button>
                <button class="sort-btn" data-sort="desc" aria-pressed="false">High → Low</button>
              </div>
            </div>
          </th>
        </tr>
      </thead>

      <tbody>
        {% for specimen in specimens %}

          {% capture image_path %}/images/the_collection/thumb/{{ specimen.box }}.{{ specimen.number }}.jpg{% endcapture %}

          {% assign shelf_part = specimen.shelf | times: 10000000 %}
          {% assign box_part = specimen.box | times: 1000 %}
          {% assign location_sort = shelf_part | plus: box_part | plus: specimen.number %}

          {% if specimen.colors %}
            {% assign colors = specimen.colors %}
          {% else %}
            {% assign colors = "" | split: "" %}
          {% endif %}
          {% assign color_count = colors | size %}
          {% assign primary_color = colors[0] %}
          {% assign color_sort = 0 %}
          {% for hex in palette_hexes %}
            {% if hex == primary_color %}{% assign color_sort = forloop.index %}{% endif %}
          {% endfor %}

          {% if color_count == 3 %}
            {% assign swatch_bg = "linear-gradient(90deg, " | append: colors[0] | append: " 0%, " | append: colors[0] | append: " 7%, " | append: colors[1] | append: " 43%, " | append: colors[1] | append: " 57%, " | append: colors[2] | append: " 93%, " | append: colors[2] | append: " 100%)" %}
            {% assign t0 = colors[0] | append: "26" %}
            {% assign t1 = colors[1] | append: "26" %}
            {% assign t2 = colors[2] | append: "26" %}
            {% assign row_tint = "linear-gradient(90deg, " | append: t0 | append: " 0%, " | append: t0 | append: " 7%, " | append: t1 | append: " 43%, " | append: t1 | append: " 57%, " | append: t2 | append: " 93%, " | append: t2 | append: " 100%)" %}
          {% elsif color_count == 2 %}
            {% assign swatch_bg = "linear-gradient(90deg, " | append: colors[0] | append: " 0%, " | append: colors[0] | append: " 10%, " | append: colors[1] | append: " 90%, " | append: colors[1] | append: " 100%)" %}
            {% assign t0 = colors[0] | append: "26" %}
            {% assign t1 = colors[1] | append: "26" %}
            {% assign row_tint = "linear-gradient(90deg, " | append: t0 | append: " 0%, " | append: t0 | append: " 10%, " | append: t1 | append: " 90%, " | append: t1 | append: " 100%)" %}
          {% elsif color_count == 1 %}
            {% assign swatch_bg = colors[0] %}
            {% assign row_tint = colors[0] | append: "26" %}
          {% else %}
            {% assign swatch_bg = "var(--surface-2)" %}
            {% assign row_tint = "" %}
          {% endif %}

          <tr data-type="{{ specimen.type }}" data-tier="{{ specimen.tier }}" data-img="{{ image_path }}" data-habit="{{ specimen.habit }}" style="--i: {{ forloop.index0 }};{% if row_tint != "" %} --row-tint: {{ row_tint }};{% endif %}">

            <td class="locate-cell{% if specimen.wip %} wip{% endif %}" data-wip="{{ specimen.wip }}" data-sort-value="{{ location_sort }}">
              <span class="locate-dot"></span>
              <span class="locate-txt">S{{ specimen.shelf }} · B{{ specimen.box }} <span class="locate-hash">#</span>{{ specimen.number }}</span>
            </td>

            <td class="color-cell{% if specimen.shiny %} shiny{% endif %}"
                style="background: {{ swatch_bg }};"
                data-sort-value="{% if color_count == 0 %}999{% else %}{{ color_sort }}{% endif %}"
                title="{{ colors | join: ', ' | upcase }}"
                data-shiny="{{ specimen.shiny }}"
                data-colors="{{ colors | join: '|' | upcase }}">
              {% if specimen.shiny %}<span class="shiny-fx"></span>{% endif %}
            </td>

            <td class="title-cell"><a href="/collection/{{ specimen.slug }}/">{{ specimen.name }}</a></td>
            <td class="from-cell">{{ specimen.from_who }}</td>
            <td class="origin-cell">{{ specimen.from_where }}</td>
            <td class="desc-cell" title="{{ specimen.description | escape }}">{{ specimen.description }}</td>
            <td class="date-cell" data-value="{{ specimen.date_acquired }}">{{ specimen.date_acquired }}</td>

            <td class="type-col" data-type="{{ specimen.type }}" title="{{ specimen.type }}">
              <svg class="ti type-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ specimen.type }}"/></svg>
            </td>

            <td class="num-cell weight-cell" data-value="{{ specimen.weight_g }}">{{ specimen.weight_g }}<small>g</small></td>
            <td class="num-cell qty-cell" data-value="{{ specimen.quantity }}">{{ specimen.quantity }}</td>
            <td class="num-cell price-cell" data-value="{{ specimen.price }}">{% if specimen.price > 0 %}€{{ specimen.price }}{% else %}<span class="dash">—</span>{% endif %}</td>

            <td class="tier-cell" data-value="{{ specimen.tier }}">
              <div class="tier-badge">
                <svg class="tier-shape" viewBox="0 0 101 101" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path class="tier-path" d="M80.5 0.5 C80.5 0.5 20.5 0.5 20.5 0.5 C20.5 0.5 20.5 50.5 20.5 50.5 C20.5 50.5 20.5 100.5 20.5 100.5 H80.5 C80.5 100.5 80.5 50.5 80.5 50.5 C80.5 50.5 80.5 0.5 80.5 0.5 Z"/>
                </svg>
                <span class="tier-value">{{ specimen.tier }}</span>
              </div>
            </td>
          </tr>

        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- ═══════ GALLERY VIEW ═══════════════════════════════════ -->
  <div class="gallery" id="gallery" aria-label="Specimen gallery">
    {% for specimen in specimens %}
      {% capture g_image %}/images/the_collection/thumb/{{ specimen.box }}.{{ specimen.number }}.jpg{% endcapture %}
      {% if specimen.colors %}{% assign g_colors = specimen.colors | uniq %}{% else %}{% assign g_colors = "" | split: "" %}{% endif %}
      <a class="g-card" href="/collection/{{ specimen.slug }}/" data-type="{{ specimen.type }}" data-tier="{{ specimen.tier }}" data-habit="{{ specimen.habit }}" style="--i: {{ forloop.index0 }};">
        <div class="g-thumb">
          <span class="g-fallback" aria-hidden="true"><svg class="ti" viewBox="0 0 24 24"><use href="#ti-{{ specimen.type }}"/></svg></span>
          <img src="{{ g_image }}" alt="{{ specimen.name | escape }}" loading="lazy" decoding="async" onerror="this.style.display='none';"/>
          <span class="g-loc">S{{ specimen.shelf }} · B{{ specimen.box }} #{{ specimen.number }}</span>
          {% if specimen.shiny %}<span class="g-flag g-shiny" title="Shiny"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L13.6 8.4 L20 10 L13.6 11.6 L12 18 L10.4 11.6 L4 10 L10.4 8.4 Z" fill="currentColor"/></svg></span>{% endif %}
          {% if specimen.wip %}<span class="g-flag g-wip" title="Work in progress"></span>{% endif %}
        </div>
        <div class="g-colors" aria-hidden="true">{% for hex in g_colors %}<i style="background: {{ hex }};"></i>{% endfor %}</div>
        <div class="g-body">
          <span class="g-name">{{ specimen.name }}</span>
          <span class="g-meta">
            <svg class="ti" viewBox="0 0 24 24" aria-hidden="true"><use href="#ti-{{ specimen.type }}"/></svg>
            <span class="g-meta-txt">{{ specimen.weight_g }}g{% if specimen.from_where != "" %} · {{ specimen.from_where }}{% endif %}</span>
            <span class="g-tier" title="Tier {{ specimen.tier }}"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#tier-blob"/></svg><em>{{ specimen.tier }}</em></span>
          </span>
        </div>
      </a>
    {% endfor %}
  </div>

  <!-- ═══════ 3D MODELS VIEW ═══════════════════════════════ -->
  <div class="models-grid" id="modelsGrid" aria-label="3D Models gallery">
    {% assign macro_list = "aciculare,botroidale,dendritico,fibroso,geodico,lamellare,massiccio" | split: "," %}
    {% assign sorted_models = modelgallery | sort: "file" %}
    {% for pass in (1..2) %}
      <section class="model-group" data-kind="{% if pass == 1 %}macro{% else %}crystal{% endif %}">
        <header class="model-group-head">
          <h2>{% if pass == 1 %}Non-crystalline habits{% else %}Crystals{% endif %}</h2>
          <span class="model-group-count"></span>
        </header>
        {% if pass == 2 %}<div class="model-tools" id="modelTools"></div>{% endif %}
        <div class="model-cells">
          {% for g in sorted_models %}
            {% assign is_macro = macro_list contains g.file %}
            {% assign show = false %}
            {% if pass == 1 and is_macro %}{% assign show = true %}{% endif %}
            {% if pass == 2 and is_macro != true %}{% assign show = true %}{% endif %}
            {% if show %}
              {% assign fparts = g.file | split: "-" %}
              {% assign hab = fparts[1] | default: fparts[0] %}
              {% assign sp_count = g.species | size %}
              {% assign spec_count = g.specimen_count | default: sp_count %}
              {% capture search_text %}{{ g.file }} {{ g.habit }} {{ g.species | join: " " }}{% endcapture %}
              <div class="model-card" data-habit="{{ g.habit }}" data-habit-tag="{{ hab }}" data-name="{{ fparts[0] }}" data-search="{{ search_text | downcase | escape }}" title="{{ g.species | join: ', ' | escape }}">
                <div class="model-thumb">
                  <div class="comp-3d" data-model="/habits/{{ g.file }}.stl"></div>
                </div>
                <div class="model-body">
                  <a class="model-name" href="/collection/?habit={{ g.habit | url_encode }}&view=table">{{ hab }}</a>
                  <span class="model-sub">
                    <span class="model-count">{{ spec_count }} specimen{% if spec_count != 1 %}s{% endif %}</span>
                  </span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>

  <!-- ═══════ EMPTY STATE ═══════════════════════════════════ -->
  <div id="emptyState" class="empty-state" hidden>
    <div class="empty-ico">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
        <path d="m8.5 8.5 5 5m0-5-5 5"/>
      </svg>
    </div>
    <h3>Nothing matches these filters</h3>
    <p>Try a different search, or clear the filters to see the whole collection again.</p>
    <button id="emptyClear" class="empty-clear-btn" type="button">Clear all filters</button>
  </div>

  <!-- ═══════ FOOTER STATS + LIVE MIX ═══════════════════════ -->
  <div class="coll-footer">
    <div class="cf-cell"><span class="cf-num" id="footerCount">0</span><span class="cf-lbl">specimens</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerPieces">0</span><span class="cf-lbl">pieces</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerWeight">0</span><span class="cf-lbl">kg</span></div>
    <div class="cf-cell"><span class="cf-num" id="footerSpent">€0</span><span class="cf-lbl">invested</span></div>
    <div class="cf-cell cf-mix">
      <div class="mix-row"><span class="mix-lbl">By type</span><div class="mix" id="mixType"></div></div>
      <div class="mix-row"><span class="mix-lbl">By tier</span><div class="mix" id="mixTier"></div></div>
    </div>
    <button class="cf-cell cf-back" id="backToTop" type="button" aria-label="Back to top">
      <span class="cf-back-num" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5M5 12l7-7 7 7"/>
        </svg>
      </span>
      <span class="cf-lbl">TOP</span>
    </button>
  </div>
</div>

<!-- ═════════ HOVER PEEK ════════════════════════════════════ -->
<div class="peek" id="peek" aria-hidden="true">
  <div class="peek-card">
    <div class="peek-img">
      <span class="peek-fallback"><svg class="ti" viewBox="0 0 24 24"><use href="#ti-Crystal"/></svg></span>
      <img alt="" decoding="async">
    </div>
    <div class="peek-meta"><b></b></div>
  </div>
</div>
<script type="module" src="/assets/js/collection-3d.js"></script>