---
layout: layouts/base.liquid
pagination:
  data: specimens
  size: 1
  alias: specimen
permalink: "/collection/{{ specimen.slug }}/"
eleventyComputed:
  title: "{{ specimen.name }}"
---

{% comment %} ═══ Hex → readable color name ═══ {% endcomment %}
{% assign color_pairs = "F5F0E6:Cream|8A8A8A:Gray|525252:Charcoal|1A1A1A:Black|D9C7A3:Sand|7B5233:Brown|4A3728:Umber|531A13:Maroon|C0392B:Red|E08B2F:Orange|E8C547:Yellow|4C9A5B:Green|1F5C33:Forest|2FA8A0:Teal|3468C0:Blue|1B3A8C:Navy|402B52:Plum|7B4FA0:Purple|E8A0BF:Pink|C9A227:Gold" | split: "|" %}

{% comment %} ═══ Origin region detection (mirrors index.liquid) ═══ {% endcomment %}
{%- assign wm_regions = "IT:Italy,Italia|SOUTH_AMERICA:Brazil,Brasile,Argentina,Chile,Cile,Peru,Perù,Perú,Colombia,Venezuela,Ecuador,Bolivia,Uruguay,Paraguay,Guyana,Suriname|NORTH_AMERICA:United States,USA,U.S.,Stati Uniti,Canada,Mexico,Messico,Guatemala,Cuba,Jamaica,Giamaica,Dominican Republic,Repubblica Dominicana,Repubblica Domenicana,Haiti,Honduras,Panama,Costa Rica,Nicaragua,El Salvador,Belize|EUROPE:France,Francia,Germany,Germania,Spain,Spagna,Portugal,Portogallo,United Kingdom,Regno Unito,England,Inghilterra,Scotland,Scozia,Wales,Galles,Ireland,Irlanda,Netherlands,Paesi Bassi,Olanda,Belgium,Belgio,Switzerland,Svizzera,Austria,Poland,Polonia,Czech,Ceca,Slovakia,Slovacchia,Slovenia,Croatia,Croazia,Serbia,Albania,Hungary,Ungheria,Romania,Bulgaria,Greece,Grecia,Norway,Norvegia,Sweden,Svezia,Finland,Finlandia,Denmark,Danimarca,Iceland,Islanda,Russia,Ukraine,Ucraina|AFRICA:Africa,Morocco,Marocco,Algeria,Tunisia,Libya,Libia,Egypt,Egitto,Sudan,Ethiopia,Etiopia,Kenya,Tanzania,South Africa,Sudafrica,Namibia,Botswana,Zimbabwe,Zambia,Mozambique,Mozambico,Madagascar,Nigeria,Ghana,Senegal,Mali,Niger,Chad,Ciad,Cameroon,Camerun,Congo,Angola,Malawi,Uganda,Rwanda,Burundi|ASIA:China,Cina,Japan,Giappone,Korea,Corea,India,Pakistan,Afghanistan,Iran,Iraq,Turkey,Turchia,Mongolia,Thailand,Tailandia,Vietnam,Laos,Cambodia,Myanmar,Birmania,Malaysia,Malesia,Indonesia,Philippines,Filippine,Saudi Arabia,Arabia Saudita,UAE,Emirati,Qatar,Kuwait,Israel,Israele,Jordan,Giordania,Lebanon,Libano,Syria,Siria,Kazakhstan,Kazakistan,Uzbekistan,Nepal,Bhutan,Bangladesh,Sri Lanka|OCEANIA:Australia,New Zealand,Nuova Zelanda,Papua New Guinea,Papua Nuova Guinea,Fiji,Samoa,Tonga,Vanuatu,Solomon|ANTARTICA:Antarctica,Antartica,Antarctic,Antartide" | split: "|" -%}
{%- assign region_labels = "IT:Italy|SOUTH_AMERICA:South America|NORTH_AMERICA:North America|EUROPE:Europe|AFRICA:Africa|ASIA:Asia|OCEANIA:Oceania|ANTARTICA:Antarctica" | split: "|" -%}

{%- assign origin_region_id    = "" -%}
{%- assign origin_region_label = "" -%}
{%- if specimen.from_where and specimen.from_where != "" -%}
  {%- assign fw_lc = specimen.from_where | downcase -%}
  {%- for entry in wm_regions -%}
    {%- assign parts = entry | split: ":" -%}
    {%- assign rid = parts[0] -%}
    {%- assign keywords = parts[1] | split: "," -%}
    {%- for kw in keywords -%}
      {%- assign kwl = kw | downcase | strip -%}
      {%- if kwl != "" and fw_lc contains kwl -%}
        {%- assign origin_region_id = rid -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if origin_region_id != "" -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- for pair in region_labels -%}
    {%- assign p = pair | split: ":" -%}
    {%- if p[0] == origin_region_id -%}
      {%- assign origin_region_label = p[1] -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% comment %} ═══ Tier + type accent colors ═══ {% endcomment %}
{% case specimen.tier %}
  {% when 1 %}{% assign tier_color = "#ff7c80" %}
  {% when 2 %}{% assign tier_color = "#df8898" %}
  {% when 3 %}{% assign tier_color = "#be95b1" %}
  {% when 4 %}{% assign tier_color = "#9da2ca" %}
  {% when 5 %}{% assign tier_color = "#7cafe3" %}
  {% else %}{% assign tier_color = "#FF42E9" %}
{% endcase %}

{% case specimen.type %}
  {% when "Mineral" %}{% assign type_color = "#2FA8A0" %}
  {% when "Crystal" %}{% assign type_color = "#7cafe3" %}
  {% when "Fossil"  %}{% assign type_color = "#E08B2F" %}
  {% when "Geode"   %}{% assign type_color = "#E8C547" %}
  {% when "Gem"     %}{% assign type_color = "#ff7c80" %}
  {% when "Rock"    %}{% assign type_color = "#9da2ca" %}
  {% else %}{% assign type_color = "#525252" %}
{% endcase %}

{% comment %} ═══ Image path + unique dominant colors ═══ {% endcomment %}
{% capture image_path %}/images/the_collection/display/{{ specimen.box }}.{{ specimen.number }}.jpg{% endcapture %}

{% if specimen.colors %}{% assign colors = specimen.colors | uniq %}{% else %}{% assign colors = "" | split: "" %}{% endif %}
{% assign color_count = colors | size %}

{% comment %} ═══ Prev / next specimen (index-walk over the full collection) ═══ {% endcomment %}
{% assign current_index = 0 %}
{% for m in specimens %}
  {% if m.slug == specimen.slug %}
    {% assign current_index = forloop.index0 %}
    {% break %}
  {% endif %}
{% endfor %}
{% assign prev_index = current_index | minus: 1 %}
{% assign next_index = current_index | plus: 1 %}
{% assign prev_specimen = nil %}
{% assign next_specimen = nil %}
{% if prev_index >= 0 %}{% assign prev_specimen = specimens[prev_index] %}{% endif %}
{% if next_index < specimens.size %}{% assign next_specimen = specimens[next_index] %}{% endif %}

{% comment %} ═══ Related — shuffle on the server, ship only 4 (same type) ═══ {% endcomment %}
{% assign related = specimens | where: "type", specimen.type | where_exp: "m", "m.slug != specimen.slug" | pickRandom: 5 %}
{% assign related_count = related | size %}

{% comment %} ═══ Years since acquisition (drives the 4th stat bar) ═══ {% endcomment %}
{% assign current_year = "now" | date: "%Y" | plus: 0 %}
{% assign years_ago = 0 %}
{% if specimen.date_acquired > 0 %}{% assign years_ago = current_year | minus: specimen.date_acquired %}{% endif %}


<!-- ═════════ PAGE WRAPPER — HERO · BOTTOM ═══════════════ -->
<div class="detail" id="detail" style="--accent: {{ type_color }}; --tier: {{ tier_color }};">

  <!-- ═══════ HERO ═══════════════════════════════════════ -->
  <section class="hero">

    <!-- ── COL 1 — IMAGE FRAME + COLOR CHIPS ── -->
    <div class="hero-image">

      <!-- Frame (click / Enter → lightbox) -->
      <div class="frame" id="heroFrame" role="button" tabindex="0" aria-label="Expand photo of {{ specimen.name }}" data-large="/images/the_collection/large/{{ specimen.box }}.{{ specimen.number }}.jpg">
        <div class="frame-placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/>
          </svg>
          <span>{{ specimen.name }}</span>
          <em>no photo yet</em>
        </div>
        <img src="{{ image_path }}" alt="{{ specimen.name }}" loading="eager" decoding="async"
             onerror="this.style.opacity='0'; this.parentElement.classList.add('no-img');"/>
        <div class="frame-brackets" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>

      <!-- Dominant color chips (deduped) -->
      {% if color_count > 0 %}
      <div class="hero-colors" aria-label="Dominant colors">
        <span class="hc-label">
          {% if color_count == 1 %}Color{% else %}Colors · {{ color_count }}{% endif %}
        </span>
        <div class="hc-chips">
          {% for hex in colors %}
            {% assign hex_key = hex | remove: '#' | upcase %}
            {% assign color_name = hex %}
            {% for pair in color_pairs %}
              {% assign parts = pair | split: ':' %}
              {% if parts[0] == hex_key %}{% assign color_name = parts[1] %}{% break %}{% endif %}
            {% endfor %}
            <a class="color-chip" href="/collection/?color={{ hex | url_encode }}" title="View {{ color_name }} specimens">
              <span class="cc-dot" style="background: {{ hex }};"></span>
              <span class="cc-name">{{ color_name }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </div>

    <!-- ── COL 2 — INFO: location · name · badges · description · stats ── -->
    <div class="hero-info">

      <!-- Location eyebrow + tags (all clickable → filtered collection) -->
      <div class="eyebrow">
        <span class="eb-locate">S{{ specimen.shelf }} · B{{ specimen.box }} <em>#</em>{{ specimen.number }}</span>

        {% if specimen.wip %}
          <a class="eb-wip" href="/collection/?wip=1" title="View all work in progress specimens">Work in progress</a>
        {% endif %}

        <a class="badge badge-type" href="/collection/?type={{ specimen.type | url_encode }}" title="View all {{ specimen.type | downcase }} specimens">
          <svg viewBox="0 0 24 24" class="badge-ico" aria-hidden="true">
            {% case specimen.type %}
              {% when "Crystal" %}<path class="t-shape" d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path class="t-detail" d="M5 7 L12 11 L19 7 M12 11 V22"/>
              {% when "Gem" %}<path class="t-shape" d="M7 4 L17 4 L21 10 L12 22 L3 10 Z"/><path class="t-detail" d="M3 10 H21 M7 4 L10 10 L12 22 M17 4 L14 10 L12 22"/>
              {% when "Rock" %}<path class="t-shape" d="M3 16 L4 8 L10 4 L17 5 L21 11 L19 18 L11 20 Z"/><path class="t-detail" d="M4 8 L11 12 L21 11 M11 12 V20 M11 12 L17 5"/>
              {% when "Mineral" %}<path class="t-shape" d="M6 4 L12 8 V21 L3 17 V7 Z"/><path class="t-shape" style="opacity:.5" d="M13 6 L20 9 L21 18 L14 20 Z"/><path class="t-detail" d="M6 4 L12 8 M3 17 L12 21 M13 6 L20 9 M14 20 L21 18"/>
              {% when "Geode" %}<circle class="t-shape" cx="12" cy="12" r="10"/><path class="t-detail" d="M6 12 L8 10 L9.5 12 L11 9.5 L12.5 11.5 L14 9 L15.5 11 L17 10 L18 12 L17 14 L15 13.5 L14 16 L12.5 14 L11 16 L9.5 14 L8 15 L6.5 13.5 Z"/>
              {% when "Fossil" %}<path class="t-detail" style="stroke-width:2" d="M12 12 C12 10 13.5 9 15 9 C17.5 9 19 11 19 13 C19 16 16 19 13 19 C9 19 5 16 5 12 C5 6 11 4 17 6"/>
              {% else %}<circle class="t-shape" cx="12" cy="12" r="9"/>
            {% endcase %}
          </svg>
          {{ specimen.type }}
        </a>

        <a class="badge badge-tier" href="/collection/?tier={{ specimen.tier }}" title="View all tier {{ specimen.tier }} specimens">
          <span class="badge-dot" style="background: {{ tier_color }};"></span>
          Tier {{ specimen.tier }}
        </a>

        {% if specimen.shiny %}
        <a class="badge badge-shiny" href="/collection/?shiny=1" title="View all shiny specimens">
          <svg viewBox="0 0 24 24" class="badge-ico" aria-hidden="true">
            <path d="M12 2 L13.6 8.4 L20 10 L13.6 11.6 L12 18 L10.4 11.6 L4 10 L10.4 8.4 Z" fill="currentColor"/>
          </svg>
          Shiny
        </a>
        {% endif %}
      </div>

      <!-- Name -->
      <h1>{{ specimen.name }}</h1>

      <!-- Description -->
      {% if specimen.description %}
        <p class="lede">{{ specimen.description }}</p>
      {% endif %}

      {% if specimen.main and specimen.main != "" %}
        {% assign main_parts = specimen.main | split: ", " %}
        {% assign habit_parts = specimen.habit | split: ", " %}
        <div class="composition" data-count="{{ main_parts.size }}">
          <div class="comp-slides">
            {% for part in main_parts %}
              {% assign m = minerali[part] | default: materiali[part] %}
              {% assign habit_key = habit_parts[forloop.index0] | strip %}
              <div class="comp-slide" data-idx="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
                <span class="comp-name">{{ part }}</span>
              
                {% if m.formula %}
                  <span class="comp-formula">{{ m.formula }}</span>
                {% endif %}

                {% if m.sistema or m.classe %}
                  <span class="comp-sistema">
                    {%- if m.sistema -%}<em>System</em> {{ m.sistema }}{%- endif -%}
                    {%- if m.classe -%}{% if m.sistema %} · {% endif %}<em>Class</em> {{ m.classe }}{%- endif -%}
                  </span>
                {% endif %}
              
                {% if m.abiti and habit_key != "" and m.abiti[habit_key] %}
                  {% assign h = m.abiti[habit_key] %}
                  <span class="comp-habit">{{ h.nome }}{% if h.nota %} — <em>{{ h.nota }}</em>{% endif %}</span>
                  
                  <div class="comp-visual">
                    <!-- 3D model container -->
                    <div class="comp-3d-container" style="display: none;">
                      <div class="comp-3d"
                           data-model-specific="/habits/{{ part | slugify }}-{{ habit_key }}.stl"
                           data-model-generic="/habits/{{ habit_key }}.stl"
                           data-color="{{ type_color }}"
                           data-colors="{{ colors | join: '|' }}">
                      </div>
                    </div>
                    <!-- SVG container (affiancato solo se il 3D è generico) -->
                    <div class="comp-svg-container" style="display: none;">
                      <img class="comp-img" src="/habits/{{ habit_key }}.svg"
                           alt="{{ part }} {{ habit_key }}"
                           onerror="var c=this.closest('.comp-svg-container');c.style.display='none';c.closest('.comp-visual').classList.add('solo-3d');" />
                    </div>
                  </div>
                {% endif %}
              
                {% if m.categoria == "serie" %}
                  <span class="comp-note">Serie: {{ m.famiglia }}. {{ m.nota }}</span>
                {% elsif m.composizione %}
                  <span class="comp-note">{{ m.composizione }}</span>
                {% elsif m.nota %}
                  <span class="comp-note">{{ m.nota }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          
          {% if main_parts.size > 1 %}
            <div class="comp-nav">
              <button class="comp-nav-btn" type="button" data-comp-dir="next" aria-label="Next component">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
              <span class="comp-dots">
                {% for part in main_parts %}<i{% if forloop.first %} class="on"{% endif %}></i>{% endfor %}
              </span>
              <button class="comp-nav-btn" type="button" data-comp-dir="prev" aria-label="Previous component">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      {% endif %}

      <!-- Stat strip — weight · quantity · price · acquired -->
      <div class="stat-strip">
        <div class="stat-cell">
          <span class="sc-value">{{ specimen.weight_g }}<small>g</small></span>
          <span class="sc-label">Weight</span>
          <span class="sc-bar" aria-hidden="true"><i style="--w: {{ specimen.weight_g | times: 1.0 | divided_by: 500.0 | at_most: 1.0 }};"></i></span>
        </div>
        <div class="stat-cell">
          <span class="sc-value">{{ specimen.quantity }}</span>
          <span class="sc-label">{% if specimen.quantity == 1 %}Piece{% else %}Pieces{% endif %}</span>
          <span class="sc-bar" aria-hidden="true"><i style="--w: {{ specimen.quantity | times: 1.0 | divided_by: 5.0 | at_most: 1.0 }};"></i></span>
        </div>
        <div class="stat-cell">
          <span class="sc-value">{% if specimen.price > 0 %}€{{ specimen.price }}{% else %}<span class="dash">—</span>{% endif %}</span>
          <span class="sc-label">Paid</span>
          <span class="sc-bar" aria-hidden="true"><i style="--w: {{ specimen.price | times: 1.0 | divided_by: 100.0 | at_most: 1.0 }};"></i></span>
        </div>
        <div class="stat-cell">
          <span class="sc-value">{{ specimen.date_acquired }}</span>
          <span class="sc-label">Acquired</span>
          <span class="sc-bar" aria-hidden="true"><i style="--w: {{ years_ago | times: 1.0 | divided_by: 10.0 | at_most: 1.0 }};"></i></span>
        </div>
      </div>

    </div>

    <!-- ── COL 3 — WORLD MAP with overlaid provenance ── -->
    <div class="hero-map">
      <div class="oc-map" data-region="{{ origin_region_id }}">
        {% include "worldmap.svg" %}

        <div class="oc-overlay" data-side="auto">
          <div class="oc-line">
            <span class="oc-label">From</span>
            <span class="oc-value {% if specimen.from_who == blank %}empty{% endif %}">
              {{ specimen.from_who | default: '— unknown —' }}
            </span>
          </div>
          <div class="oc-line">
            <span class="oc-label">Origin</span>
            <span class="oc-value {% if specimen.from_where == blank %}empty{% endif %}">
              {{ specimen.from_where | default: '— unspecified —' }}
            </span>
          </div>
          {% if origin_region_label != "" %}
          <div class="oc-region">
            <span class="oc-region-dot"></span>
            {{ origin_region_label }}
          </div>
          {% endif %}
        </div>

        {% unless origin_region_id != "" %}
          <span class="oc-nomap">Origin not mapped</span>
        {% endunless %}
      </div>
    </div>

  </section>

  <!-- ═══════ BOTTOM ═════════════════════════════════════ -->
  <section class="bottom{% if related_count == 0 %} no-related{% endif %}">

    <!-- Related header (spans both columns) -->
    {% if related_count > 0 %}
    <h2 class="rel-h">
      More {{ specimen.type | downcase }} specimens
      <span class="rel-count">{{ related_count }}</span>
    </h2>

    <!-- Related grid -->
    <div class="related">
      <div class="rel-grid">
        {% for m in related %}
          {% case m.tier %}
            {% when 1 %}{% assign m_tier_color = "#ff7c80" %}
            {% when 2 %}{% assign m_tier_color = "#df8898" %}
            {% when 3 %}{% assign m_tier_color = "#be95b1" %}
            {% when 4 %}{% assign m_tier_color = "#9da2ca" %}
            {% when 5 %}{% assign m_tier_color = "#7cafe3" %}
            {% else %}{% assign m_tier_color = "#FF42E9" %}
          {% endcase %}
          {% capture m_image %}/images/the_collection/card/{{ m.box }}.{{ m.number }}.jpg{% endcapture %}

          <a class="rel-card" href="/collection/{{ m.slug }}/" style="--rt: {{ m_tier_color }};">
            <div class="rel-thumb">
              <span class="rel-fallback" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/>
                </svg>
              </span>
              <img src="{{ m_image }}" alt="{{ m.name }}" loading="lazy" decoding="async"
                   onerror="this.style.display='none';"/>
            </div>
            <div class="rel-body">
              <span class="rel-name">{{ m.name }}</span>
              <span class="rel-locate">S{{ m.shelf }} · B{{ m.box }} #{{ m.number }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <!-- Specimen nav — prev · all · next -->
    <nav class="spec-nav" aria-label="Specimen navigation">

      {% if prev_specimen %}
        {% capture prev_image %}/images/the_collection/thumb/{{ prev_specimen.box }}.{{ prev_specimen.number }}.jpg{% endcapture %}
        <a class="nav-item nav-prev" href="/collection/{{ prev_specimen.slug }}/">
          <span class="nav-thumb">
            <span class="nav-fallback" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/>
              </svg>
            </span>
            <img src="{{ prev_image }}" alt="" loading="lazy" decoding="async"
                 onerror="this.style.display='none';"/>
          </span>
          <span class="nav-meta">
            <span class="nav-dir">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              Previous
            </span>
            <b>{{ prev_specimen.name }}</b>
            <em>S{{ prev_specimen.shelf }} · B{{ prev_specimen.box }} · #{{ prev_specimen.number }}</em>
          </span>
        </a>
      {% else %}
        <span class="nav-item nav-empty" aria-hidden="true"></span>
      {% endif %}

      <a class="nav-item nav-all" href="/collection/" title="All specimens">
        <span class="nav-meta">
          <span class="nav-all-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.4"/>
              <rect x="14" y="3" width="7" height="7" rx="1.4"/>
              <rect x="3" y="14" width="7" height="7" rx="1.4"/>
              <rect x="14" y="14" width="7" height="7" rx="1.4"/>
            </svg>
          </span>
          <span class="nav-all-text">
            <b>All specimens</b>
            <em>#{{ current_index | plus: 1 }} / {{ specimens.size }}</em>
          </span>
        </span>
      </a>

      {% if next_specimen %}
        {% capture next_image %}/images/the_collection/thumb/{{ next_specimen.box }}.{{ next_specimen.number }}.jpg{% endcapture %}
        <a class="nav-item nav-next" href="/collection/{{ next_specimen.slug }}/">
          <span class="nav-thumb">
            <span class="nav-fallback" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 L19 7 V17 L12 22 L5 17 V7 Z"/><path d="M5 7 L12 11 L19 7 M12 11 V22"/>
              </svg>
            </span>
            <img src="{{ next_image }}" alt="" loading="lazy" decoding="async"
                 onerror="this.style.display='none';"/>
          </span>
          <span class="nav-meta">
            <span class="nav-dir">
              Next
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <b>{{ next_specimen.name }}</b>
            <em>S{{ next_specimen.shelf }} · B{{ next_specimen.box }} · #{{ next_specimen.number }}</em>
          </span>
        </a>
      {% else %}
        <span class="nav-item nav-empty" aria-hidden="true"></span>
      {% endif %}

    </nav>

  </section>
</div>

<!-- ═════════ LIGHTBOX ═══════════════════════════════════ -->
<div class="lightbox" id="lightbox" hidden aria-hidden="true">
  <button class="lb-close" type="button" aria-label="Close image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <img id="lbImage" src="" alt="{{ specimen.name }}" draggable="false"/>
  <span class="lb-caption">{{ specimen.name }} · S{{ specimen.shelf }} · B{{ specimen.box }} #{{ specimen.number }} · scroll to zoom · drag to pan · dbl-click to reset</span>
</div>


<style>
/* ═════════ BASE LAYOUT ══════════════════════════════════ */
  main {
    max-width: 1861px !important;
    margin: 0 auto !important;
    padding-left: 2rem;
    padding-right: 2rem;
  }
  .detail {
    position: relative;
    isolation: isolate;
    padding: 0.5rem 0 2.25rem;
    --div: var(--line);
  }
  /* Faint blueprint grid, shifted 1.5rem to the left so its left edge
     peeks out symmetrically with the 1.5rem visible above the image. */
  .detail::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: -1.5rem;
    z-index: -1;
    pointer-events: none;
    opacity: .35;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 25% 12%, #000 0%, transparent 85%);
            mask-image: radial-gradient(ellipse 70% 55% at 25% 12%, #000 0%, transparent 85%);
  }

/* ═════════ HERO ═════════════════════════════════════════ */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5.775fr) minmax(0, 5fr) minmax(0, 3.6fr);
    gap: 2.5rem;
    align-items: stretch;
    padding-top: 1rem;
  }
  @media (max-width: 1050px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; align-items: start; }
  }

  /* ── COL 1 — IMAGE FRAME ── */
  .hero-image { display: flex; flex-direction: column; gap: 14px; min-width: 0; }

  .frame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    cursor: zoom-in;
    background:
      radial-gradient(120% 120% at 30% 20%,
        color-mix(in srgb, var(--accent) 14%, var(--surface-2)) 0%,
        var(--surface) 62%), var(--surface);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
    box-shadow:
      0 24px 70px -34px color-mix(in srgb, var(--accent) 65%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
    transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease, border-color .45s ease;
  }
  .frame:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 70%, var(--border));
    box-shadow:
      0 34px 90px -30px color-mix(in srgb, var(--accent) 85%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .frame:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .frame.no-img { cursor: default; }
  .frame.no-img:hover { transform: none; }

  .frame img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .35s ease;
  }
  .frame:hover img { transform: scale(1.04); }
  .frame.no-img:hover img { transform: none; }

  /* Placeholder shown until the image loads (or forever if missing) */
  .frame-placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px; color: var(--muted); opacity: 0; transition: opacity .3s ease;
  }
  .frame.no-img .frame-placeholder { opacity: 1; }
  .frame-placeholder svg { width: 58px; height: 58px; opacity: .35; color: var(--accent); }
  .frame-placeholder span { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); opacity: .7; }
  .frame-placeholder em { font-style: normal; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }

  /* Corner brackets — highlight the zoom-in affordance on hover */
  .frame-brackets { position: absolute; inset: 10px; z-index: 4; pointer-events: none; }
  .frame-brackets i {
    position: absolute; width: 18px; height: 18px;
    border: 2px solid color-mix(in srgb, var(--accent) 90%, transparent);
    opacity: .55;
    transition: opacity .25s ease, transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .frame-brackets i:nth-child(1) { top: 0;    left: 0;  border-right: 0; border-bottom: 0; border-radius: 7px 0 0 0; }
  .frame-brackets i:nth-child(2) { top: 0;    right: 0; border-left: 0;  border-bottom: 0; border-radius: 0 7px 0 0; }
  .frame-brackets i:nth-child(3) { bottom: 0; left: 0;  border-right: 0; border-top: 0;    border-radius: 0 0 0 7px; }
  .frame-brackets i:nth-child(4) { bottom: 0; right: 0; border-left: 0;  border-top: 0;    border-radius: 0 0 7px 0; }
  .frame:hover .frame-brackets i { opacity: 1; }
  .frame.no-img:hover .frame-brackets i { opacity: .55; }

  /* ── COL 1 — DOMINANT COLOR CHIPS ── */
  .hero-colors {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    padding: 10px 14px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
  }
  .hc-label {
    font-family: Consolas, monospace; font-size: 10px; letter-spacing: .2em;
    text-transform: uppercase; color: var(--muted); flex-shrink: 0;
  }
  .hc-chips { display: flex; flex-wrap: wrap; gap: 6px; flex: 1 1 auto; min-width: 0; }
  .color-chip {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 4px 10px 4px 4px;
    background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 999px; text-decoration: none; color: inherit;
    transition: border-color .2s, background .2s, transform .2s;
  }
  .color-chip:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--surface-2));
    transform: translateY(-1px);
  }
  .color-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cc-dot {
    width: 18px; height: 18px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12); flex-shrink: 0;
  }
  .cc-name { font-size: 12px; color: var(--ink); letter-spacing: .01em; }

  /* ── COL 2 — INFO PANEL ── */
  .hero-info {
    display: flex; flex-direction: column;
    gap: 1.35rem;
    padding-top: 8px;
    min-width: 0;
  }
  .hero-info .lede { flex: 1 1 auto; }

  .eyebrow {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-family: Consolas, monospace; font-size: 11px; letter-spacing: .22em;
    text-transform: uppercase;
  }
  .eb-locate { color: var(--accent); margin-right: 4px; }
  .eb-locate em { font-style: normal; opacity: .55; margin: 0 1px; }

  /* WIP tag — now a link, same pill height as the other tags */
  .eb-wip {
    display: inline-flex; align-items: center;
    padding: 5px 11px;
    background: color-mix(in srgb, #ff9500 15%, var(--surface-2));
    border: 1px solid color-mix(in srgb, #ff9500 60%, transparent);
    border-radius: 999px; color: #ff9500;
    font-size: 11px; letter-spacing: .14em;
    text-decoration: none;
    transition: background .2s, border-color .2s, transform .2s;
  }
  .eb-wip:hover {
    background: color-mix(in srgb, #ff9500 26%, var(--surface-2));
    border-color: #ff9500;
    transform: translateY(-1px);
  }

  /* Type / tier / shiny tags — clickable */
  .eyebrow .badge {
    text-decoration: none;
    transition: border-color .2s, background .2s, transform .2s;
  }
  .eyebrow .badge:hover { transform: translateY(-1px); }
  .eyebrow .badge-type:hover  { background: color-mix(in srgb, var(--accent) 20%, var(--surface)); border-color: var(--accent); }
  .eyebrow .badge-tier:hover  { background: color-mix(in srgb, var(--tier) 20%, var(--surface));   border-color: var(--tier); }
  .eyebrow .badge-shiny:hover { background: rgba(255,224,138,.16); border-color: #ffe08a; }
  .eyebrow a:focus-visible    { outline: 2px solid var(--accent); outline-offset: 2px; }

  .hero-info h1 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 700; line-height: 1.02; letter-spacing: -.025em;
    color: var(--ink);
  }

  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badge {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 11px; border: 1px solid var(--border); border-radius: 999px;
    font-family: Consolas, monospace; font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--muted); background: var(--surface);
  }
  .badge-ico { width: 13px; height: 13px; overflow: visible; }
  .badge-type {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  }
  .badge-type .t-shape  { fill: currentColor; fill-opacity: .28; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .badge-type .t-detail { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; opacity: .85; }
  .badge-tier {
    color: var(--tier);
    border-color: color-mix(in srgb, var(--tier) 55%, var(--border));
    background: color-mix(in srgb, var(--tier) 10%, var(--surface));
  }
  .badge-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 8px currentColor; }
  .badge-shiny { color: #ffe08a; border-color: rgba(255,224,138,.5); background: rgba(255,224,138,.08); }

  .lede {
    font-size: 15.5px; line-height: 1.65;
    color: var(--ink); margin: 0; max-width: 66ch; opacity: .9;
  }

  .composition {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
    padding: 4px 0 0;
  }
  .comp-slides { display: contents; }
  .comp-slide {
    display: flex; flex-direction: column; gap: 6px;
    min-width: 0;
  }
  .comp-slide[hidden] { display: none; }

  .comp-name {
    font-family: Consolas, monospace;
    font-size: 10px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--muted);
  }
  .comp-formula {
    font-family: "Caveat", "Dancing Script", "Segoe Script", "Brush Script MT", cursive;
    font-size: 34px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: .005em;
    color: var(--accent);
  }
  .comp-sistema {
    font-family: Consolas, monospace;
    font-size: 11.5px; letter-spacing: .04em;
    color: var(--muted);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
    margin-top: 2px;
  }
  .comp-sistema em {
    font-style: normal;
    font-size: 9px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--muted); opacity: .7;
  }
  .comp-habit {
    font-size: 13px; color: var(--ink); line-height: 1.4;
  }
  .comp-habit em {
    font-style: normal; color: var(--muted); font-size: 12px;
  }
  .comp-note {
    font-size: 12.5px; color: var(--muted); line-height: 1.55;
    max-width: 62ch; margin-top: 4px;
  }
  /* ── Habit visual: 3D + 2D affiancati ── */
  .comp-visual {
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: 100%;
  }

  .comp-3d-container, .comp-svg-container {
    flex: 0 0 auto;
    width: 220px;
    height: 220px;
    position: relative;
  }

  .comp-visual.solo-3d .comp-3d-container {
    width: 260px;
    height: 260px;
  }

  .comp-img {
    width: 100%; height: 100%;
    object-fit: contain;
    color: var(--accent);
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--accent) 30%, transparent));
    transition: transform 0.3s ease;
  }

  .comp-3d {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .comp-3d:active { cursor: grabbing; }
  .comp-3d canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    outline: none;
    background: transparent;
  }

  /* Chevron — bordo destro */
  .comp-nav {
    align-self: center;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    padding: 8px 6px;
  }
  .comp-nav-btn {
    background: none; border: 0; cursor: pointer; padding: 4px;
    color: var(--muted);
    display: grid; place-items: center;
    transition: color .2s ease, transform .2s ease, opacity .2s ease;
  }
  .comp-nav-btn:hover { color: var(--accent); }
  .comp-nav-btn[data-comp-dir="next"]:hover { transform: translateX( 2px); }
  .comp-nav-btn[data-comp-dir="prev"]:hover { transform: translateX(-2px); }
  .comp-nav-btn svg { width: 18px; height: 18px; }
  .comp-nav-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

  .comp-dots { display: flex; flex-direction: column; gap: 5px; }
  .comp-dots i {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,255,.18);
    transition: background .2s ease, transform .2s ease;
  }
  .comp-dots i.on {
    background: #fff;
    transform: scale(1.4);
  }

  /* ── COL 2 — STAT STRIP ── */
  .stat-strip {
    margin-top: auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    background:
      radial-gradient(120% 130% at 0% 0%,
        color-mix(in srgb, var(--accent) 7%, transparent), transparent 62%),
      var(--surface);
  }
  @media (max-width: 640px) {
    .stat-strip { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: 0; }
    .stat-cell:nth-child(1), .stat-cell:nth-child(2) { border-bottom: 1px solid var(--border); }
  }

  .stat-cell {
    position: relative;
    display: flex; flex-direction: column; gap: 5px;
    padding: 16px 18px 20px;
    border-right: 1px solid var(--border);
    transition: background .25s ease;
  }
  .stat-cell:last-child { border-right: 0; }
  .stat-cell:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }

  .sc-value {
    font-size: 25px; font-weight: 700; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: -.025em; line-height: 1;
  }
  .sc-value small { font-size: 12px; color: var(--muted); margin-left: 3px; font-weight: 400; }
  .sc-value .dash { color: var(--muted); opacity: .5; }
  .sc-label { font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .sc-bar {
    position: absolute; left: 18px; right: 18px; bottom: 11px;
    height: 2px; background: var(--border); border-radius: 1px; overflow: hidden;
  }
  .sc-bar i {
    display: block; height: 100%; width: calc(var(--w) * 100%);
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--accent) 50%, transparent), var(--accent));
    border-radius: inherit; transform-origin: left; transform: scaleX(0);
    transition: transform 1.1s cubic-bezier(.2,.8,.2,1);
  }
  .detail.js.in .sc-bar i { transform: scaleX(1); }

  /* ── COL 3 — MAP WITH OVERLAID PROVENANCE ── */
  .hero-map {
    display: flex; flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
  }

  .oc-map {
    position: relative;
    flex: 1 1 auto;
    min-height: 260px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(rgba(255,255,255,.07) 1px, transparent 1.4px) 0 0 / 16px 16px,
      radial-gradient(120% 100% at 50% 35%,
        color-mix(in srgb, var(--accent) 8%, var(--surface)) 0%,
        color-mix(in srgb, var(--surface) 92%, #000) 100%);
    transition: border-color .25s ease, box-shadow .4s ease;
  }
  .oc-map:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: 0 20px 60px -28px color-mix(in srgb, var(--accent) 65%, transparent);
  }
  /* Vignette layer — darkens the corners so the highlighted region pops */
  .oc-map::after {
    content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      radial-gradient(90% 70% at 20% 0%, rgba(255,255,255,.06), transparent 60%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(0,0,0,.4) 100%);
  }

  .oc-map svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block;
    transition: transform 1.1s cubic-bezier(.2,.8,.2,1);
  }
  .oc-map svg .area {
    fill: color-mix(in srgb, var(--surface-3) 85%, #000);
    stroke: rgba(255,255,255,.10);
    stroke-width: 90;
    stroke-linejoin: round;
    transition: fill .8s ease, stroke .4s ease, opacity .8s ease;
  }
  .oc-map svg .area.active { fill: color-mix(in srgb, var(--accent) 75%, #111); }
  .oc-map svg .oc-border {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 55%, #fff);
    stroke-width: 140;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 24px color-mix(in srgb, var(--accent) 70%, transparent));
    pointer-events: none;
  }
  .oc-map svg .grid { display: none; }

  .oc-nomap {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 4;
    font-family: Consolas, monospace;
    font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
    color: var(--muted); opacity: .7;
    pointer-events: none;
  }

  /* Glassy provenance card overlaid on the map — auto-snaps to the
     opposite quadrant of the highlighted region. */
  .oc-overlay {
    position: absolute;
    z-index: 5;
    display: flex; flex-direction: column;
    gap: 8px;
    padding: 12px 14px;
    max-width: min(75%, 260px);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
            backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid var(--border);
    border-radius: 12px;
    pointer-events: none;
    box-shadow: 0 10px 30px -12px rgba(0,0,0,.5);
    transition: opacity .4s ease, transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .oc-overlay[data-side="left"]   { left: 14px;  right: auto; }
  .oc-overlay[data-side="right"]  { right: 14px; left: auto; }
  .oc-overlay[data-side="auto"]   { left: 14px;  right: auto; }
  .oc-overlay                       { bottom: 14px; top: auto; }
  .oc-overlay[data-v="top"]         { top: 14px; bottom: auto; }

  .oc-line {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 10px;
    align-items: baseline;
    min-width: 0;
  }
  .oc-label {
    font-family: Consolas, monospace;
    font-size: 9px; letter-spacing: .2em; text-transform: uppercase;
    color: var(--muted);
  }
  .oc-value {
    font-size: 13px; font-weight: 500;
    color: var(--ink); line-height: 1.35;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .oc-value.empty { font-style: italic; font-weight: 400; color: var(--muted); opacity: .65; }

  .oc-region {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 3px 10px 3px 7px;
    align-self: flex-start;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-family: Consolas, monospace;
    font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent);
  }
  .oc-region-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

/* ═════════ BOTTOM ═══════════════════════════════════════ */
  .bottom {
    display: grid;
    grid-template-columns: minmax(0, 5.775fr) minmax(0, 5fr) minmax(0, 3.6fr);
    column-gap: 2.5rem;
    row-gap: 0.65rem;
    align-items: stretch;
    /* Tuned so the visual gap between the hero's bottom edge and the
       first related row matches the horizontal column gap (2.5rem). */
    margin-top: 0.625rem;
    opacity: .20;
    transition: opacity .45s ease;
  }
  .bottom:hover,
  .bottom:focus-within { opacity: 1; }
  @media (hover: none) { .bottom { opacity: 1; } }

  .bottom .rel-h {
    grid-column: 1 / -1;
    grid-row: 1;
    margin: 0;
  }

  /* Row 2 — related on the left, nav on the right */
  .bottom .related {
    grid-column: 1 / 3;
    grid-row: 2;
    margin: 0;
    min-width: 0;
  }
  .bottom .spec-nav {
    grid-column: 3 / 4;
    grid-row: 2;
  }

  /* No related cards → nav takes the whole width in row 1 */
  .bottom.no-related .spec-nav {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  /* ── Related section — heading + compact horizontal cards ── */
  .rel-h {
    display: flex; align-items: center; gap: 12px;
    margin: 0 0 .65rem;
    font-size: 10.5px; font-weight: 700; line-height: 1.4;
    letter-spacing: .2em; text-transform: uppercase; color: var(--muted);
  }
  /* Hairline that extends from the label to the right edge */
  .rel-h::after {
    content: ""; flex: 1; height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }
  .rel-count {
    font-family: Consolas, monospace; font-size: 9.5px;
    padding: 2px 7px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    letter-spacing: .1em; font-weight: 400;
  }

  .rel-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }

  .rel-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none; color: inherit;
    min-width: 0;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .rel-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 14px 34px -22px color-mix(in srgb, var(--accent) 75%, transparent);
  }

  .rel-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 7px;
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(120% 120% at 30% 20%,
        color-mix(in srgb, var(--rt) 20%, var(--surface-2)),
        var(--surface-3));
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .rel-card:hover .rel-thumb {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .rel-thumb img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .rel-card:hover .rel-thumb img { transform: scale(1.06); }

  /* Fallback shown if the image fails to load */
  .rel-fallback {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    color: color-mix(in srgb, var(--rt) 70%, var(--muted));
    opacity: .55; pointer-events: none;
    transition: opacity .3s ease;
  }
  .rel-fallback svg { width: 28px; height: 28px; }
  .rel-thumb:has(img[style*="display: none"]) .rel-fallback { opacity: .85; }

  .rel-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; padding: 0 2px 2px; }
  .rel-name {
    font-size: 13px; font-weight: 600;
    color: var(--ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .rel-locate {
    font-family: Consolas, monospace;
    font-size: 10px; letter-spacing: .04em; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

/* ═════════ SPEC NAV ═════════════════════════════════════ */
  .spec-nav {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    box-shadow:
      0 20px 60px -40px rgba(0,0,0,.6),
      inset 0 1px 0 color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    min-width: 0;
    min-height: 0;
    position: relative;
    text-decoration: none;
    color: inherit;
    flex: 1 1 0;
    transition:
      flex-grow .5s cubic-bezier(.2,.8,.2,1),
      background .25s ease;
    border-bottom: 1px solid var(--border);
  }
  .nav-item:last-child { border-bottom: 0; }

  /* Accent side-bar that appears on hover */
  .nav-item::after {
    content: "";
    position: absolute;
    top: 14px; bottom: 14px;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity .25s ease;
    border-radius: 1px;
  }
  .nav-prev::after { left: 0; }
  .nav-next::after { right: 0; }

  .nav-item:hover { background: color-mix(in srgb, var(--accent) 6%, var(--surface)); }
  .nav-item:hover::after { opacity: 1; }

  /* Hovered row grows, siblings shrink — total stays at 3× so the
     column height never changes and there's no reflow jump. */
  .spec-nav:has(.nav-item:hover) .nav-item        { flex-grow: .75; }
  .spec-nav:has(.nav-item:hover) .nav-item:hover  { flex-grow: 1.5; }

  /* Prev: thumb → meta, left aligned */
  .nav-prev { flex-direction: row; }
  .nav-prev .nav-meta { align-items: flex-start; text-align: left; }

  /* Next: meta → thumb, right aligned */
  .nav-next { flex-direction: row-reverse; }
  .nav-next .nav-meta { align-items: flex-end; text-align: right; }

  /* Thumbnail — width/height driven by --thumb-size (set by JS) */
  .nav-thumb {
    position: relative;
    width:  var(--thumb-size, 68px);
    height: var(--thumb-size, 68px);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(120% 120% at 30% 20%,
        color-mix(in srgb, var(--accent) 14%, var(--surface-2)),
        var(--surface-3));
    flex-shrink: 0;
    transition:
      border-color .25s ease,
      box-shadow   .25s ease,
      transform    .35s cubic-bezier(.2,.8,.2,1);
  }
  .nav-item:hover .nav-thumb {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 0 22px -4px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .nav-prev:hover .nav-thumb { transform: translateX(-3px); }
  .nav-next:hover .nav-thumb { transform: translateX( 3px); }

  .nav-thumb img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .nav-fallback {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    color: var(--muted); opacity: .55;
    pointer-events: none;
  }
  .nav-fallback svg { width: 24px; height: 24px; }
  .nav-thumb:has(img[style*="display: none"]) .nav-fallback { opacity: .9; }

  .nav-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .nav-dir {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: Consolas, monospace; font-size: 9.5px;
    letter-spacing: .22em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1px;
  }
  .nav-dir svg {
    width: 11px; height: 11px; flex-shrink: 0;
    transition: transform .3s cubic-bezier(.2,.8,.2,1);
  }
  .nav-prev:hover .nav-dir svg { transform: translateX(-3px); }
  .nav-next:hover .nav-dir svg { transform: translateX( 3px); }

  .nav-meta b {
    font-size: 15px; font-weight: 600; color: var(--ink);
    letter-spacing: -.005em; line-height: 1.15;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .nav-meta em {
    font-style: normal; font-family: Consolas, monospace;
    font-size: 10.5px; letter-spacing: .05em; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Middle "All" hub */
  .nav-all {
    justify-content: center;
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    text-align: center;
  }
  .nav-all:hover { background: color-mix(in srgb, var(--accent) 18%, var(--surface)); }
  .nav-all::after { display: none; }

  /* Center the icon + text as a tight row inside the hub */
  .nav-all .nav-meta {
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .nav-all-ico {
    display: grid; place-items: center;
    width: 20px; height: 20px;
    color: var(--accent);
    flex-shrink: 0;
    align-self: center;
  }
  .nav-all-ico svg {
    width: 15px; height: 15px;
    display: block;                 /* kills inline-baseline 1px shift */
    transform-box: fill-box;
    transform-origin: center;
    backface-visibility: hidden;
    will-change: transform;
    transition: transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .nav-all:hover .nav-all-ico svg { transform: rotate(90deg); }

  /* Counter text — collapsed until hover.
     Uses grid-template-rows 0fr → 1fr to animate height without
     a hard-coded max-height. */
  .nav-all-text {
    display: grid;
    grid-template-rows: auto 0fr;
    align-items: center;
    transition: grid-template-rows .4s cubic-bezier(.2,.8,.2,1);
  }
  .nav-all:hover .nav-all-text { grid-template-rows: auto 1fr; }

  .nav-all-text b {
    font-family: Consolas, monospace;
    font-size: 10.5px; font-weight: 700;
    letter-spacing: .24em; text-transform: uppercase;
    color: var(--accent); white-space: nowrap;
    grid-row: 1;
  }
  .nav-all-text em {
    font-style: normal; font-family: Consolas, monospace;
    font-size: 9.5px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--muted);
    white-space: nowrap;
    grid-row: 2;
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transition: opacity .3s ease .08s;
  }
  .nav-all:hover .nav-all-text em { opacity: 1; }

  /* Placeholder slot when a neighbour doesn't exist — keeps grid
     balance without rendering anything. */
  .nav-empty {
    visibility: hidden;
    pointer-events: none;
    min-height: 96px;
  }

  /* Mobile: stack nav rows, disable grow/shrink */
  @media (max-width: 1050px) {
    .spec-nav {
      align-self: auto;
      height: auto;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
      box-shadow: none;
    }
    .nav-item { flex: 0 0 auto; }
    .nav-next { flex-direction: row-reverse; }
  }

/* ═════════ LIGHTBOX ═════════════════════════════════════ */
  .lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: grid; place-items: center;
    background: rgba(0,0,0,.9);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    opacity: 0; pointer-events: none; transition: opacity .3s ease;
    touch-action: none;
    overflow: hidden;
  }
  .lightbox.open { opacity: 1; pointer-events: auto; }

  .lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 100px rgba(0,0,0,.75);
    opacity: 0;
    transition: opacity .3s ease;
    transform-origin: center center;
    cursor: zoom-in;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    will-change: transform;
  }
  .lightbox.open img { opacity: 1; }
  .lightbox img.is-zoomed   { cursor: grab; }
  .lightbox img.is-dragging { cursor: grabbing; }

  .lb-close {
    position: absolute; top: 22px; right: 22px;
    width: 42px; height: 42px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 10px; color: #fff; cursor: pointer;
    display: grid; place-items: center;
    transition: background .15s, border-color .15s;
    z-index: 2;
  }
  .lb-close:hover { background: rgba(255,92,92,.22); border-color: #ff5c5c; color: #ff5c5c; }
  .lb-close svg { width: 16px; height: 16px; }

  .lb-caption {
    position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
    padding: 7px 14px;
    background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    font-family: Consolas, monospace; font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: rgba(255,255,255,.8); white-space: nowrap;
    z-index: 2;
  }
  @media (max-width: 700px) { .lb-caption { display: none; } }

/* ═════════ ENTRANCE ═════════════════════════════════════ */
  .detail.js .hero-image,
  .detail.js .hero-info > *,
  .detail.js .hero-map,
  .detail.js .related,
  .detail.js .spec-nav {
    opacity: 0; transform: translateY(16px);
  }
  .detail.js.in .hero-image,
  .detail.js.in .hero-info > *,
  .detail.js.in .hero-map,
  .detail.js.in .related,
  .detail.js.in .spec-nav {
    opacity: 1; transform: none;
    transition: opacity .7s ease, transform .7s cubic-bezier(.2,.8,.2,1);
  }
  /* Stagger the info column children, then the map, related, nav */
  .detail.js.in .hero-image                  { transition-delay: .05s; }
  .detail.js.in .hero-info > *:nth-child(1)  { transition-delay: .14s; }
  .detail.js.in .hero-info > *:nth-child(2)  { transition-delay: .22s; }
  .detail.js.in .hero-info > *:nth-child(3)  { transition-delay: .30s; }
  .detail.js.in .hero-info > *:nth-child(4)  { transition-delay: .38s; }
  .detail.js.in .hero-info > *:nth-child(5)  { transition-delay: .46s; }
  .detail.js.in .hero-map                    { transition-delay: .54s; }
  .detail.js.in .related                     { transition-delay: .66s; }
  .detail.js.in .spec-nav                    { transition-delay: .72s; }

  @media (prefers-reduced-motion: reduce) {
    .detail.js .hero-image, .detail.js .hero-info > *,
    .detail.js .hero-map, .detail.js .related, .detail.js .spec-nav,
    .detail.js .sc-bar i, .oc-map svg, .oc-overlay {
      opacity: 1 !important; transform: none !important; transition: none !important;
    }
    .bottom { opacity: 1; }
  }
</style>


<script>
(function () {
  const root = document.getElementById('detail');
  if (!root) return;

  /* ════════════════════════════════════════════════════════
     1. ENTRANCE
     Marks the block as .js, forces a synchronous layout read,
     then flips to .in. The read guarantees the browser has
     painted the "before" state, so the CSS transition fires
     even on cold loads where two class changes would otherwise
     be batched into a single style pass.
     ════════════════════════════════════════════════════════ */
  root.classList.add('js');
  void root.offsetHeight;

  requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('in')));


  /* ════════════════════════════════════════════════════════
     2. LIGHTBOX — PAN & ZOOM
     Opens the hero image full-screen. Wheel zooms anchored at
     the cursor, pointer drag pans once zoomed, click zooms
     ×2 at the click point, double-click resets, Escape closes.
     The transform is expressed entirely through three CSS
     vars (--lbs, --lbx, --lby) so JS never touches the
     transform string directly.
     ════════════════════════════════════════════════════════ */
  const frame   = document.getElementById('heroFrame');
  const lb      = document.getElementById('lightbox');
  const lbImg   = document.getElementById('lbImage');
  const lbClose = lb.querySelector('.lb-close');
  const heroImg = frame ? frame.querySelector('img') : null;
  const largeSrc = frame ? frame.dataset.large : '';
  let lbToken = 0;

  const MIN_S = 1, MAX_S = 3;

  let s = 1;
  let x = 0, y = 0;
  let dragging = false;
  let startX = 0, startY = 0;
  let startTX = 0, startTY = 0;
  let moved = false;

  function apply() {
    lbImg.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${s})`;
    lbImg.classList.toggle('is-zoomed', s > 1.001);
  }
  function reset() {
    s = 1; x = 0; y = 0; dragging = false; moved = false;
    lbImg.classList.remove('is-dragging', 'is-zoomed');
    apply();
  }
  /* Keep the panned image overlapping the viewport — never let the
     user drag past the edge and see empty space. */
  function clamp() {
    if (s <= 1) { x = 0; y = 0; return; }
    const w = lbImg.offsetWidth;
    const h = lbImg.offsetHeight;
    const maxX = Math.max(0, (w * s - window.innerWidth)  / 2);
    const maxY = Math.max(0, (h * s - window.innerHeight) / 2);
    if (x >  maxX) x =  maxX;
    if (x < -maxX) x = -maxX;
    if (y >  maxY) y =  maxY;
    if (y < -maxY) y = -maxY;
  }
  /* Zoom centred on (cx, cy) — the point under the cursor stays
     under the cursor. */
  function zoomAt(cx, cy, newS) {
    newS = Math.max(MIN_S, Math.min(MAX_S, newS));
    if (newS === s) return;
    const k = newS / s;
    const dx = cx - window.innerWidth  / 2;
    const dy = cy - window.innerHeight / 2;
    x = x * k + (1 - k) * dx;
    y = y * k + (1 - k) * dy;
    s = newS;
    clamp();
    apply();
  }

  function openLightbox() {
    if (!frame || frame.classList.contains('no-img') || !heroImg || !heroImg.src) return;
    lbImg.src = heroImg.src;                       // opens instantly with the 1800px file
    lbImg.alt = heroImg.alt || '';
    lb.hidden = false;
    lb.setAttribute('aria-hidden', 'false');
    reset();
    requestAnimationFrame(() => lb.classList.add('open'));
    document.documentElement.style.overflow = 'hidden';
    lbToken++;
  }
  function closeLightbox() {
    lbToken++;                                     // cancels any pending upgrade
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    setTimeout(() => {
      lb.hidden = true;
      lbImg.src = '';
      reset();
    }, 300);
  }

  if (frame) {
    frame.addEventListener('click', openLightbox);
    frame.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(); }
    });
  }
  lbClose.addEventListener('click', closeLightbox);
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !lb.hidden) closeLightbox(); });

  lb.addEventListener('wheel', e => {
    if (!lb.classList.contains('open')) return;
    e.preventDefault();
    const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
    zoomAt(e.clientX, e.clientY, s * factor);
  }, { passive: false });

  lbImg.addEventListener('pointerdown', e => {
    if (e.button !== 0) return;
    if (s <= 1.001) return;
    e.preventDefault();
    dragging = true;
    moved = false;
    startX = e.clientX;
    startY = e.clientY;
    startTX = x;
    startTY = y;
    lbImg.classList.add('is-dragging');
    try { lbImg.setPointerCapture(e.pointerId); } catch (_) {}
  });
  lbImg.addEventListener('pointermove', e => {
    if (!dragging) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
    x = startTX + dx;
    y = startTY + dy;
    clamp();
    apply();
  });
  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    lbImg.classList.remove('is-dragging');
    try { lbImg.releasePointerCapture(e.pointerId); } catch (_) {}
  }
  lbImg.addEventListener('pointerup', endDrag);
  lbImg.addEventListener('pointercancel', endDrag);

  lbImg.addEventListener('click', e => {
    if (moved) { moved = false; return; }
    if (s > 1.001) return;
    zoomAt(e.clientX, e.clientY, 2);
  });

  lbImg.addEventListener('dblclick', e => {
    e.preventDefault();
    reset();
  });


  /* ════════════════════════════════════════════════════════
     3. NAV THUMBNAIL SCALING
     The nav rows change height on hover (flex-grow .75 → 1.5).
     A ResizeObserver tracks each row's border-box height and
     writes --thumb-size = h * 0.55 (clamped 48–96px), so the
     thumbnail grows / shrinks in lockstep with the row. The
     entry's borderBoxSize avoids forcing a reflow to read it.
     ════════════════════════════════════════════════════════ */
  (function () {
    const items = document.querySelectorAll('.spec-nav .nav-item:not(.nav-empty)');
    if (!items.length || !window.ResizeObserver) return;

    const MIN = 48, MAX = 96, RATIO = 0.55;

    const apply = (el, h) => {
      const size = Math.round(Math.max(MIN, Math.min(MAX, h * RATIO)));
      el.style.setProperty('--thumb-size', size + 'px');
    };

    const ro = new ResizeObserver(entries => {
      for (const e of entries) {
        const h = e.borderBoxSize?.[0]?.blockSize
              ?? e.contentRect.height;
        apply(e.target, h);
      }
    });

    items.forEach(el => {
      apply(el, el.clientHeight);
      ro.observe(el);
    });
  })();


  /* ════════════════════════════════════════════════════════
     4. WORLD MAP — ZOOM TO REGION + OVERLAY SIDE
     If the specimen has a mapped origin, highlights the region
     and animates the SVG viewBox from a wide frame to a tight
     one. Retries up to 3 animation frames because on cold
     loads the SVG can still be 0×0 when getBBox() first runs,
     which would produce a degenerate viewBox and no zoom.
     Also picks which corner of the map the provenance overlay
     sits in (opposite of the region's centroid).
     ════════════════════════════════════════════════════════ */
  const ocMap = root.querySelector('.oc-map');
  if (!ocMap) return;

  const svg = ocMap.querySelector('svg');
  if (!svg) return;

  const overlay  = ocMap.querySelector('.oc-overlay');
  const regionId = ocMap.dataset.region || '';

  svg.removeAttribute('width');
  svg.removeAttribute('height');
  svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');

  svg.querySelectorAll('.area').forEach(p => {
    p.style.removeProperty('--wm-fill');
    p.style.removeProperty('--wm-rim');
  });

  if (!regionId) return;

  const target = svg.querySelector('#' + CSS.escape(regionId));
  if (!target) return;

  target.classList.add('active');

  (function () {
    const NS = 'http://www.w3.org/2000/svg';
    const d = target.getAttribute('d');
    if (!d) return;

    const border = document.createElementNS(NS, 'path');
    border.setAttribute('class', 'oc-border');
    border.setAttribute('d', d);
    svg.appendChild(border);
  })();

  const zoomToTarget = () => {
    try {
      const bb = target.getBBox();
      /* Bail + retry if the SVG hasn't been laid out yet. */
      if (!bb || bb.width === 0 || bb.height === 0) return false;

      const padX = bb.width  * 0.35;
      const padY = bb.height * 0.35;
      const vx = bb.x - padX;
      const vy = bb.y - padY;
      const vw = bb.width  + padX * 2;
      const vh = bb.height + padY * 2;

      /* Start wide, then settle to the padded frame 60ms later —
         the SVG's own transition:transform handles the easing. */
      const startPad = 1.9;
      const sx = bb.x - bb.width  * startPad;
      const sy = bb.y - bb.height * startPad;
      const sw = bb.width  * (startPad * 2 + 1);
      const sh = bb.height * (startPad * 2 + 1);

      svg.setAttribute('viewBox', `${sx} ${sy} ${sw} ${sh}`);
      setTimeout(() => {
        svg.setAttribute('viewBox', `${vx} ${vy} ${vw} ${vh}`);
      }, 60);

      /* Pin the overlay to the opposite corner of the region. */
      if (overlay) {
        const cx = bb.x + bb.width / 2;
        const cy = bb.y + bb.height / 2;
        const svgW = 66989, svgH = 31063;
        overlay.dataset.side = cx < svgW / 2 ? 'right' : 'left';
        overlay.dataset.v    = cy < svgH / 2 ? 'bottom' : 'top';
      }
      return true;
    } catch (_) {
      /* getBBox() can throw on hidden SVGs — treat as "not ready". */
      return false;
    }
  };

  let tries = 0;
  const tryZoom = () => {
    if (zoomToTarget() || ++tries >= 3) return;
    requestAnimationFrame(tryZoom);
  };
  requestAnimationFrame(tryZoom);

  /* ── Composition carousel ─────────────────────────────── */
  (function () {
    const root = document.querySelector('#detail .composition');
    if (!root) return;
    const slides = root.querySelectorAll('.comp-slide');
    if (slides.length < 2) return;

    const dots = root.querySelectorAll('.comp-dots i');
    let i = 0;

    const nextBtn = root.querySelector('[data-comp-dir="next"]');
    const prevBtn = root.querySelector('[data-comp-dir="prev"]');

    const goTo = (n) => {
      slides[i].hidden = true;
      dots[i]?.classList.remove('on');
      i = ((n % slides.length) + slides.length) % slides.length;
      slides[i].hidden = false;
      dots[i]?.classList.add('on');
    };

    nextBtn.addEventListener('click', () => goTo(i + 1));
    prevBtn.addEventListener('click', () => goTo(i - 1));
  })();
})();
</script>
<script type="module">
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { STLLoader } from 'three/addons/loaders/STLLoader.js';

  const LIGHT_HABITS = new Set(['aciculare', 'botroidale', 'geodico', 'lamellare', 'fibroso', 'dendritico', 'massiccio']);
  const habitName = url => (url || '').split('/').pop().split('?')[0].replace(/\.stl$/i, '').toLowerCase();
  const isHabit = url => LIGHT_HABITS.has(habitName(url));
  const INK_TARGET = 26;
  const LIGHTNESS = 0.75;

  function makeEdges(geometry, url) {
    const light = isHabit(url);
    const lines = new THREE.EdgesGeometry(geometry, light ? 20 : 1);
    let opacity = 1;

    if (light) {
      const positions = lines.attributes.position;
      let length = 0;
      for (let i = 0; i < positions.count; i += 2) {
        length += Math.hypot(
          positions.getX(i) - positions.getX(i + 1),
          positions.getY(i) - positions.getY(i + 1),
          positions.getZ(i) - positions.getZ(i + 1)
        );
      }
      geometry.computeBoundingSphere();
      const ink = length / (geometry.boundingSphere.radius || 1);
      opacity = Math.min(1, Math.max(0.08, Math.pow(INK_TARGET / Math.max(ink, 1e-6), LIGHTNESS)));
    }

    return new THREE.LineSegments(lines, new THREE.LineBasicMaterial({
      color: 0x000000,
      transparent: true,
      opacity,
      depthWrite: false,
      depthTest: true
    }));
  }

  function init3D(container, geometry, url) {
    const hexColor = container.dataset.color || '#ffffff';
    const width = Math.max(1, container.clientWidth);
    const height = Math.max(1, container.clientHeight);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(0, 0, 5);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(width, height);
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.position.set(5, 5, 5);
    scene.add(dirLight);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 2;
    controls.enableZoom = false;

    geometry.computeVertexNormals();
    geometry.center();
    const box = new THREE.Box3().setFromObject(new THREE.Mesh(geometry));
    const size = box.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z) || 1;
    geometry.scale(3 / maxDim, 3 / maxDim, 3 / maxDim);

    const minLightness = 0.55;
    const colors = (container.dataset.colors || hexColor).split('|').filter(Boolean).map(value => {
      const color = new THREE.Color(value);
      const hsl = {};
      color.getHSL(hsl);
      if (hsl.l < minLightness) color.setHSL(hsl.h, hsl.s, minLightness);
      return color;
    });
    if (!colors.length) colors.push(new THREE.Color(hexColor));

    geometry.computeBoundingBox();
    const { min, max } = geometry.boundingBox;
    const positions = geometry.attributes.position;
    const colorBuffer = new Float32Array(positions.count * 3);
    const tempColor = new THREE.Color();

    function bandColor(t) {
      const count = colors.length;
      if (count === 1) return tempColor.copy(colors[0]);
      const segment = t * count;
      const index = Math.min(count - 1, Math.floor(segment));
      const fraction = segment - index;
      if (index < count - 1 && fraction > 0.75) {
        return tempColor.copy(colors[index]).lerp(colors[index + 1], (fraction - 0.75) / 0.25);
      }
      return tempColor.copy(colors[index]);
    }

    for (let i = 0; i < positions.count; i++) {
      bandColor((positions.getY(i) - min.y) / ((max.y - min.y) || 1));
      colorBuffer.set([tempColor.r, tempColor.g, tempColor.b], i * 3);
    }
    geometry.setAttribute('color', new THREE.BufferAttribute(colorBuffer, 3));

    const averageColor = colors.reduce((sum, color) => sum.add(color), new THREE.Color(0, 0, 0))
      .multiplyScalar(1 / colors.length);
    const solid = isHabit(url);
    const material = new THREE.MeshStandardMaterial({
      vertexColors: true,
      transparent: !solid,
      opacity: solid ? 1 : 0.65,
      roughness: 0.22,
      metalness: 0.05,
      emissive: averageColor,
      emissiveIntensity: solid ? 0.12 : 0.2,
      side: THREE.DoubleSide,
      depthWrite: true,
      flatShading: true,
      polygonOffset: true,
      polygonOffsetFactor: 1,
      polygonOffsetUnits: 1
    });

    scene.add(new THREE.Mesh(geometry, material));
    const edges = makeEdges(geometry, url);
    edges.renderOrder = 1;
    scene.add(edges);

    let visible = !('IntersectionObserver' in window);
    let animationFrame = 0;

    function render() {
      if (!visible) return;
      controls.update();
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    function setVisible(nextVisible) {
      if (visible === nextVisible) return;
      visible = nextVisible;
      if (visible) {
        if (!animationFrame) render();
      } else if (animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    }

    let visibilityObserver;
    if ('IntersectionObserver' in window) {
      visibilityObserver = new IntersectionObserver(entries => {
        for (const entry of entries) {
          setVisible(entry.isIntersecting && entry.intersectionRatio > 0);
        }
      }, { threshold: 0.01 });
      visibilityObserver.observe(container);
    } else {
      render();
    }

    const resizeObserver = new ResizeObserver(() => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      if (visible && !animationFrame) render();
    });
    resizeObserver.observe(container);
  }

  function loadSlide(slide) {
    if (slide.dataset.modelLoadStarted === 'true') return;
    slide.dataset.modelLoadStarted = 'true';

    const container = slide.querySelector('.comp-3d');
    if (!container) return;

    const urlSpecific = container.dataset.modelSpecific;
    const urlGeneric = container.dataset.modelGeneric;
    const visualBlock = container.closest('.comp-visual');
    const container3d = visualBlock?.querySelector('.comp-3d-container');
    const containerSvg = visualBlock?.querySelector('.comp-svg-container');
    if (!visualBlock || !container3d || !containerSvg) return;

    const loader = new STLLoader();

    loader.load(urlSpecific, geometry => {
      visualBlock.classList.add('solo-3d');
      containerSvg.style.display = 'none';
      container3d.style.display = 'block';
      init3D(container, geometry, urlSpecific);
    }, undefined, () => {
      loader.load(urlGeneric, geometry => {
        containerSvg.style.display = 'block';
        container3d.style.display = 'block';
        init3D(container, geometry, urlGeneric);
      }, undefined, () => {
        container3d.style.display = 'none';
        containerSvg.style.display = 'block';
      });
    });
  }

  function bootModels() {
    const slides = document.querySelectorAll('#detail .comp-slide');
    if (!slides.length) return;

    // Load only the currently visible component; later slides load on demand.
    if ('IntersectionObserver' in window) {
      const slideObserver = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (entry.isIntersecting && !entry.target.hidden) {
            loadSlide(entry.target);
            slideObserver.unobserve(entry.target);
          }
        }
      }, { threshold: 0.01 });

      slides.forEach(slide => {
        if (!slide.hidden) slideObserver.observe(slide);
      });

      // The carousel reveals slides later, so observe newly visible slides as needed.
      const carousel = document.querySelector('#detail .composition');
      if (carousel) {
        const visibilityObserver = new MutationObserver(() => {
          slides.forEach(slide => {
            if (!slide.hidden && slide.dataset.modelLoadStarted !== 'true') {
              slideObserver.observe(slide);
            }
          });
        });
        visibilityObserver.observe(carousel, { subtree: true, attributes: true, attributeFilter: ['hidden'] });
      }
    } else {
      slides.forEach(loadSlide);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootModels, { once: true });
  } else {
    bootModels();
  }
</script>